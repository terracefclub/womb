# VM proof of Keycloak production administration (docs/identity-admin.md): the SAME app
# role with `instance = "rehearsal"`, a real Keycloak, secrets generated by terrace-secrets
# inside the operator guest at test time, and the root-only terrace-identity-admin tool.
# The master realm starts with NO administrator: the rehearsal harness's bootstrap file is
# never staged, so everything below goes through the production procedure.
{
  pkgs,
  release,
  contract,
  sopsModule,
}: let
  lib = pkgs.lib;
  names = ["web.terrace.invalid" "cms.terrace.invalid" "identity.terrace.invalid"];
  tool = pkgs.callPackage ./package.nix {};
  # Synthetic CA only, with a random key: a rebuild makes a different CA under the same path, so every
  # consumer references this path (curl --cacert, SSL_CERT_FILE, NODE_EXTRA_CA_CERTS, /etc symlinks) and
  # nothing copies it into another derivation (no security.pki bundle). A partial garbage collection then
  # cannot leave a cached copy of an old CA that no longer matches the signing key.
  ca = pkgs.runCommand "terrace-identity-admin-proof-ca" {nativeBuildInputs = [pkgs.openssl];} ''
    mkdir $out
    openssl req -x509 -nodes -newkey rsa:2048 -sha256 -days 3650 \
      -keyout $out/ca-key.pem -out $out/ca.pem -subj /CN=TerraceIdentityAdminRehearsalCA \
      -addext basicConstraints=critical,CA:TRUE -addext keyUsage=critical,keyCertSign,cRLSign >/dev/null 2>&1
  '';
  keys = pkgs.runCommand "terrace-identity-admin-rehearsal-keys" {nativeBuildInputs = [pkgs.openssh];} ''
    mkdir $out
    ssh-keygen -q -t ed25519 -N "" -C rehearsal-operator -f $out/operator
    ssh-keygen -q -t ed25519 -N "" -C rehearsal-repository -f $out/repository-host
  '';
  publicKey = file: lib.removeSuffix "\n" (builtins.readFile "${keys}/${file}.pub");
  escrow = pkgs.runCommand "terrace-identity-admin-rehearsal-escrow" {nativeBuildInputs = [pkgs.age];} ''
    mkdir $out
    age-keygen -o $out/escrow.age 2>/dev/null
    age-keygen -y $out/escrow.age >$out/escrow.pub
  '';
  escrowRecipient = lib.removeSuffix "\n" (builtins.readFile "${escrow}/escrow.pub");
  users = pkgs.runCommand "terrace-identity-admin-rehearsal-users" {} ''
    mkdir $out
    cp -r ${contract}/. $out/
    cp ${./rehearsal-users.ts} $out/rehearsal-users.ts
  '';
  extension = pkgs.writeText "terrace-identity-admin-leaf.ext" ''
    basicConstraints=critical,CA:FALSE
    keyUsage=critical,digitalSignature,keyEncipherment
    extendedKeyUsage=serverAuth
    subjectAltName=${lib.concatMapStringsSep "," (name: "DNS:${name}") names}
  '';
in {
  name = "terrace-identity-admin";
  nodes = {
    operator = {...}: {
      virtualisation = {
        memorySize = 2048;
        cores = 1;
      };
      environment.systemPackages = [tool pkgs.sops pkgs.age pkgs.ssh-to-age pkgs.openssl pkgs.bun pkgs.jq pkgs.curl pkgs.netcat-openbsd];
      services.openssh = {
        enable = true;
        hostKeys = [
          {
            type = "ed25519";
            path = "/etc/ssh/ssh_host_ed25519_key";
          }
        ];
        extraConfig = ''
          Match User restic
            ForceCommand internal-sftp
            AllowTcpForwarding no
            PermitTTY no
        '';
      };
      users.users.restic.isNormalUser = true;
      # Test-only exec trace, as on the app node (no record may be lost while the proof runs).
      security.auditd.enable = true;
      security.audit = {
        enable = true;
        backlogLimit = 8192;
        rules = ["-a exit,always -F arch=b64 -S execve"];
      };
      system.activationScripts.rehearsalRepositoryHostKey = ''
        install -d -m 0755 /etc/ssh
        install -m 0600 ${keys}/repository-host /etc/ssh/ssh_host_ed25519_key
        install -m 0644 ${keys}/repository-host.pub /etc/ssh/ssh_host_ed25519_key.pub
      '';
    };
    app = {...}: {
      imports = [sopsModule ./app.nix (import ./rehearsal.nix {inherit ca;})];
      virtualisation = {
        memorySize = 9216;
        cores = 2;
        diskSize = 4096;
      };
      terrace.production = {
        instance = "rehearsal";
        memoryMiB = 9216;
        inherit escrowRecipient;
        operatorKeys = [(publicKey "operator")];
        app = {
          webHostname = "web.terrace.invalid";
          cmsHostname = "cms.terrace.invalid";
          identityHostname = "identity.terrace.invalid";
          identityContract = contract;
          backup.primary = {
            repository = "sftp:restic@operator:repository";
            knownHosts = "operator ${publicKey "repository-host"}";
          };
        };
      };
      terrace.website = {
        webPackage = release.web;
        cmsPackage = release.cms;
        inherit (release) revision;
      };
      # Test-only: the bootstrap command's output goes to the journal so a failure can be
      # diagnosed; the journal scan below then also proves it carries no password.
      systemd.services.terrace-identity-bootstrap-admin.serviceConfig = {
        StandardOutput = "journal";
        StandardError = "journal";
      };
      environment.etc."identity-admin-probe.py".source = ./identity-admin-probe.py;
      # Test-only: report every temporary administrator at once, so the check can be shown failing.
      terrace.production.identityAdmin.temporaryMaxAgeMinutes = 0;
      # Test-only: the kernel records every exec with its arguments; auditd writes them to
      # /var/log/audit (on the root disk, which is scanned) and journald receives them too, so the
      # scans cover the arguments of short-lived processes, not just a final /proc read. The test
      # asserts the kernel lost no record while the proof ran.
      security.auditd.enable = true;
      security.audit = {
        enable = true;
        backlogLimit = 8192;
        rules = ["-a exit,always -F arch=b64 -S execve"];
      };
    };
  };
  testScript = {nodes, ...}: ''
    import json, os, re, shlex, time

    checks = []
    def ok(condition, label):
        assert condition, label
        checks.append(label)

    STORE = "/root/store"
    ESCROW = "/root/escrow/escrow.age"
    ENV = f"export TERRACE_SECRETS_STORE={STORE} SOPS_AGE_KEY_FILE={ESCROW} TERRACE_SECRETS_SCRATCH=/dev/shm TERRACE_ESCROW_RECIPIENT=${escrowRecipient}; "
    STAGE = "/dev/shm/terrace-stage-app"
    PUSH = " --address app --identity /root/.ssh/operator --rehearsal"
    T = "/run/ia-test"
    H = "/run/terrace-identity-admin/handoff"
    TOOL = "/run/wrappers/bin/terrace-identity-admin"
    # The test CA, by store-path reference only (an /etc symlink on the app, the store path on the operator).
    CA = "/etc/terrace-rehearsal-ca.pem"
    PROBE = "SSL_CERT_FILE=" + CA + " python3 /etc/identity-admin-probe.py "
    TOOL_SOURCE = "${nodes.app.security.wrappers.terrace-identity-admin.source}"
    SSH = "ssh -i /root/.ssh/operator -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null operator@app "
    PERSON = "--email {0}@terrace.invalid --first-name Test --last-name Person"
    started_at = time.time()

    def op(command, **kwargs):
        return operator.succeed(ENV + command, **kwargs)

    def op_refused(command, needle):
        status, out = operator.execute(ENV + command + " 2>&1")
        ok(status != 0 and needle in out, f"operator refused ({needle})")

    def unit_state(unit, prop):
        return app.succeed(f"systemctl show {unit} -p {prop} --value").strip()

    def sql(query, database="keycloak"):
        return app.succeed("runuser -u postgres -- psql -XAt -d " + database + " -c " + shlex.quote(query) + " 2>/dev/null").strip()

    def master_names():
        return sql("select coalesce(string_agg(username, ',' order by username), \'\') from user_entity u join realm r on r.id = u.realm_id where r.name = 'master'")

    def tia(arguments, stdin=None, expect=0):
        # Output is kept in a root-only file too; the final scan proves it holds no value.
        feed = f"cat {stdin} | " if stdin else ""
        command = f"set -o pipefail; {feed}terrace-identity-admin {arguments} 2>&1 | tee -a {T}/outputs"
        status, output = app.execute(command, timeout=900)
        ok(status == expect, f"exit {expect} for: {arguments.split(' --')[0]} (got {status})")
        return output

    def person(name):
        return f"--username {name} " + PERSON.format(name)

    def secret_file(name, length=24):
        # A fresh value, generated in the guest, never in the driver or an argument; also kept under its name.
        app.succeed(f"umask 077; python3 -c 'import secrets; print(secrets.token_hex({length}))' >{T}/{name} && install -D -m 0600 {T}/{name} {T}/named/{name}")
        return f"{T}/{name}"

    def keep_pattern(path, name):
        app.succeed(f"umask 077; mkdir -p {T}/named && cat {path} >{T}/named/{name}")

    def lines(name, *files):
        app.succeed(f"umask 077; cat {' '.join(files)} >{T}/{name}")
        return f"{T}/{name}"

    def probe(*arguments):
        return app.succeed(PROBE + " ".join(arguments), timeout=120).strip()

    def trust_consistent(label):
        # Before any HTTPS client runs: the chain nginx serves verifies against the anchor the clients use,
        # and that anchor is the CA that signed the leaf (the operator holds the signing key's certificate).
        anchor = app.succeed("${pkgs.openssl}/bin/openssl x509 -noout -fingerprint -sha256 -in " + CA).strip()
        signer = operator.succeed("openssl x509 -noout -fingerprint -sha256 -in ${ca}/ca.pem").strip()
        failed = [name for name in ${builtins.toJSON names} if app.execute("echo | ${pkgs.openssl}/bin/openssl s_client -connect 127.0.0.1:443 -servername " + name + " -verify_return_error -CAfile " + CA + " >/dev/null 2>&1")[0] != 0]
        if anchor != signer or failed:
            raise AssertionError(f"test CA and trust anchor disagree ({label}): anchor {anchor}, signer {signer}, unverified {failed}")
        ok(True, label + ": served chain verifies against the clients' trust anchor")

    def refused(outcome):
        # A refusal is HTTP 400/401 with an OAuth refusal code; anything else (5xx, other errors) is not.
        parts = outcome.split()
        return len(parts) == 2 and parts[0] in ("400", "401") and parts[1] in ("invalid_grant", "unauthorized_client", "invalid_client")

    def root_only(path):
        return app.succeed(f"stat -c '%a %U %G' {path}").strip() == "400 root root"

    def pids(units):
        return {unit: unit_state(unit + ".service", "MainPID") for unit in units}

    def env_matches(unit, variable, secret):
        return app.succeed(f"pid=$(systemctl show {unit}.service -p MainPID --value); a=$(tr '\\0' '\\n' </proc/$pid/environ | grep '^{variable}=' | sha256sum); b=$(printf '{variable}=%s\\n' \"$(cat {secret})\" | sha256sum); test \"$a\" = \"$b\" && echo same || echo different").strip()

    def keycloak_ready():
        app.wait_until_succeeds("systemctl is-active --quiet keycloak.service && curl -sf http://127.0.0.1:9000/health/ready | grep -q UP", timeout=420)
        return True

    def kill_in_window(unit, command, signal):
        # Start the tool as its own unit, wait until it has started the bootstrap command (Keycloak stopped),
        # then signal the tool's whole cgroup. The bootstrap unit itself belongs to systemd, not to the tool.
        app.succeed(f"systemd-run --unit={unit} -p RemainAfterExit=yes {TOOL} {command}")
        app.wait_until_succeeds("test \"$(systemctl show terrace-identity-bootstrap-admin.service -p ActiveState --value)\" = activating", timeout=240)
        ok(unit_state("keycloak.service", "ActiveState") != "active", f"{unit}: Keycloak stopped inside the window")
        app.succeed(f"systemctl kill -s {signal} {unit}.service")

    def site_sessions(user=None):
        where = f" and u.username = '{user}'" if user else ""
        return int(sql("select count(*) from offline_user_session s join realm r on r.id = s.realm_id join user_entity u on u.id = s.user_id where r.name = 'terrace'" + where))

    def all_sessions():
        return int(sql("select count(*) from offline_user_session"))

    # ---- the host, as in the production proof: key, secrets, push, adopt ----
    operator.start()
    operator.wait_for_unit("multi-user.target")
    operator.wait_for_unit("sshd.service")
    operator.wait_for_unit("auditd.service")
    operator_audit_lost = int(operator.succeed("auditctl -s | awk '$1 == \"lost\" {print $2}'").strip())
    operator.succeed("install -d -m 0700 /root/escrow /root/.ssh " + STORE + " && install -m 0600 ${keys}/operator /root/.ssh/operator")
    operator.succeed("install -m 0600 ${escrow}/escrow.age " + ESCROW + " && install -m 0644 ${escrow}/escrow.pub " + STORE + "/escrow.recipient")

    with subtest("operator: host key, generated secrets, synthetic certificate, push, adopt"):
        op("terrace-secrets host create app --role app")
        op("terrace-secrets generate app")
        op("sh -ec 'umask 077; d=$(mktemp -d /dev/shm/tls.XXXXXX); "
           "openssl req -new -nodes -newkey rsa:2048 -sha256 -keyout $d/key.pem -out $d/req.pem -subj /CN=web.terrace.invalid 2>/dev/null; "
           "openssl x509 -req -in $d/req.pem -CA ${ca}/ca.pem -CAkey ${ca}/ca-key.pem -set_serial 0x$(openssl rand -hex 8) -days 30 -sha256 -extfile ${extension} -out $d/cert.pem 2>/dev/null; "
           "terrace-secrets set app tls/key <$d/key.pem; terrace-secrets set app tls/certificate <$d/cert.pem; rm -rf $d'")
        op("bun --no-env-file ${users}/rehearsal-users.ts | terrace-secrets set app rehearsal/users-json --rehearsal")
        ok("app: 13 secrets encrypted to exactly the host key and the pinned escrow key." in op("terrace-secrets check app --rehearsal"), "store complete")
        public = op("terrace-secrets public app backup/primary/sftp-key").strip()
        operator.succeed("install -d -o restic -g users -m 0700 /home/restic/.ssh /home/restic/repository && echo " + shlex.quote(public) + " >/home/restic/.ssh/authorized_keys && chown restic:users /home/restic/.ssh/authorized_keys && chmod 0600 /home/restic/.ssh/authorized_keys")
        operator.succeed(f"rm -rf /tmp/shared/stage/app && install -d -m 0700 /tmp/shared/stage/app && cp {STAGE}/ssh_host_ed25519_key {STAGE}/ssh_host_ed25519_key.pub /tmp/shared/stage/app/")
        app.start()
        app.wait_for_unit("multi-user.target")
        operator.succeed("rm -rf /tmp/shared/stage/app")
        op("terrace-secrets host unstage app")
        ok("Installed 13 encrypted secrets." in op("terrace-secrets push app" + PUSH), "push over the pinned channel")
        # The harness's bootstrap environment file is NOT staged: Keycloak starts with no administrator.
        ok(app.execute("test -e /run/terrace-rehearsal/keycloak-bootstrap.env")[0] == 1, "no harness bootstrap file")
        app.succeed("terrace-production adopt --new", timeout=600)
        app.wait_for_unit("keycloak.service", timeout=360)
        app.wait_for_unit("nginx.service")
        trust_consistent("adopted host")
        app.succeed("systemctl start terrace-cms-migrate.service && systemctl start terrace-cms.service terrace-web.service", timeout=300)
        app.succeed(f"rm -rf {T} && install -d -m 0700 {T} {T}/named && umask 077 && touch {T}/outputs")
        ok(master_names() == "", "master realm starts with no administrator")
        ok(unit_state("terrace-identity-temporary-admin-check.timer", "ActiveState") == "active", "temporary-administrator check timer armed by adoption")
        ok(app.succeed("auditctl -l").strip().endswith("-S execve"), "exec audit trace active")
        app.wait_for_unit("auditd.service")
        audit_lost = int(app.succeed("auditctl -s | awk '$1 == \"lost\" {print $2}'").strip())

    with subtest("the tool is root-only, on no general PATH, and administration stays off the proxy"):
        ok(app.succeed(f"stat -c '%a %U %G' {TOOL}").strip() == "500 root root", "wrapper 0500 root:root")
        ok(app.succeed("command -v terrace-identity-admin").strip() == TOOL, "only the wrapper is on PATH")
        ok(app.execute("test -e /run/current-system/sw/bin/terrace-identity-admin")[0] == 1, "not in the system profile")
        status, out = app.execute(f"runuser -u nobody -- {TOOL} --help 2>&1")
        ok(status != 0 and "Permission denied" in out, "wrapper not executable by others")
        status, out = app.execute(f"runuser -u nobody -- {TOOL_SOURCE} status 2>&1")
        ok(status == 1 and "run as root" in out, "the program itself refuses a non-root caller")
        ok("first-admin" in app.succeed("terrace-identity-admin --help"), "--help as root")
        ok(app.succeed("stat -c '%a %U' /etc/terrace/identity-admin.json").strip() == "400 root", "configuration root-only")
        address = operator.succeed("getent hosts app | cut -d' ' -f1").strip()
        for path in ["/", "/admin/", "/admin/master/console/", "/admin/realms/terrace", "/realms/master/protocol/openid-connect/token", "/realms/terrace/clients-registrations/default"]:
            code = operator.succeed(f"curl --cacert ${ca}/ca.pem -s -o /dev/null -w '%{{http_code}}' --resolve identity.terrace.invalid:443:{address} https://identity.terrace.invalid{path}").strip()
            ok(code == "404", f"proxy denies {path}")
        ok(operator.succeed(f"curl --cacert ${ca}/ca.pem -s -o /dev/null -w '%{{http_code}}' --resolve identity.terrace.invalid:443:{address} https://identity.terrace.invalid/realms/terrace/.well-known/openid-configuration").strip() == "200", "proxy serves the Terrace realm")
        for port in [8088, 9000]:
            status, _ = operator.execute(f"nc -z -w 2 app {port}")
            ok(status == 1, f"port {port} unreachable from another host")
        ok("Named administrators: none" in tia("status"), "status: no administrator yet")

    with subtest("first administrator: killed in the Keycloak window, half-created, resumed and proven"):
        out = tia(f"first-admin {person('ops-alice')}", expect=1)
        ok("no delivered bootstrap password" in out, "first-admin refuses without the delivered password")
        ok("Delivered identity/bootstrap-admin-password to /run/terrace-identity-admin/bootstrap-admin-password" in op("terrace-secrets apply app identity/bootstrap-admin-password" + PUSH), "escrowed password handed over once on the pinned channel")
        ok(root_only("/run/terrace-identity-admin/bootstrap-admin-password") and app.succeed("stat -c '%a' /run/terrace-identity-admin").strip() == "700", "delivered file root-only")
        ok(app.succeed("findmnt -no FSTYPE --target /run/terrace-identity-admin").strip() == "tmpfs", "delivered file on tmpfs")
        keep_pattern("/run/terrace-identity-admin/bootstrap-admin-password", "bootstrap")
        app.succeed(f"install -m 0400 /run/terrace-identity-admin/bootstrap-admin-password {T}/bootstrap")
        keycloak_pid = pids(["keycloak"])
        out = tia(f"first-admin {person('ops-alice')} --dry-run")
        ok("would stop Keycloak, create temporary administrator terrace-bootstrap" in out and "brute-force protection" in out, "first-admin dry run lists the steps")
        ok(pids(["keycloak"]) == keycloak_pid and master_names() == "", "dry run changed nothing")
        # MAJOR-3: the tool is killed (SIGKILL) while Keycloak is stopped for the bootstrap command.
        kill_in_window("ia-first-killed", "first-admin " + person("ops-alice"), "KILL")
        ok(keycloak_ready(), "Keycloak comes back by itself after the tool was killed in the window")
        app.wait_until_succeeds("test \"$(systemctl show terrace-identity-bootstrap-admin.service -p ActiveState --value)\" = inactive", timeout=120)
        # Only the run's recorded result (no secret) is left; the credential files are gone.
        ok(app.succeed("find /run/terrace-identity-admin/kc-bootstrap -type f -printf '%f\\n'").split() == ["result"], "bootstrap credential files removed after the kill")
        ok(master_names() == "terrace-bootstrap", "the killed run left only the bootstrap account")
        # N1: as if run 1 created ops-alice (admin) and died, and ops-alice then chose a password of its own:
        # repair is refused and nothing about the account changes.
        own = secret_file("own-password")
        ok(probe("half-admin", f"{T}/bootstrap", "ops-alice", own, "admin") == "201", "an administrator with its own password injected")
        out = tia(f"first-admin {person('ops-alice')}", expect=1)
        ok("already has a password of its own" in out and "bootstrap account is kept" in out, "repair refused for an account with its own password")
        ok(master_names() == "ops-alice,terrace-bootstrap" and probe("token", "ops-alice", own) == "200", "its password unchanged, bootstrap kept")
        ok("Master brute-force protection: OFF; master admin events: OFF" in tia("status"), "status: the master realm is not hardened yet")
        # The documented remedy: `break-glass end` as that administrator removes the bootstrap account, and the
        # master realm's hardening converges at that administrator login.
        out = tia("break-glass end --admin ops-alice --password-stdin", stdin=own)
        ok("Master realm hardening was incomplete; turned on: brute-force protection, admin events." in out and "terrace-bootstrap" in out, "break-glass end hardened the master realm and removed the bootstrap account")
        ok("Master brute-force protection: on; master admin events: on" in tia("status"), "status: hardened")
        ok(master_names() == "ops-alice", "only that administrator remains")
        out = tia(f"first-admin {person('ops-alice')}")
        ok("Already done" in out and "WARNING" not in out, "first-admin: already done, hardening complete")
        ok("turned on" not in tia("admin enable --admin ops-alice --password-stdin --username ops-alice", stdin=own), "hardening is idempotent (nothing turned on again)")
        # Reset for the next case: a recovery account removes that administrator (as an operator would after investigating).
        out = tia("break-glass begin")
        reset = re.search(r"Recovery administrator (terrace-recovery-[0-9]{14}-[0-9a-f]{8}) created", out)
        assert reset is not None, "reset recovery account"
        reset_file = f"{H}/master-{reset.group(1)}.password"
        keep_pattern(reset_file, "recovery-reset")
        ok(probe("delete-user", reset.group(1), reset_file, "ops-alice") == "204", "that administrator removed")
        ok("Delivered" in op("terrace-secrets apply app identity/bootstrap-admin-password" + PUSH), "bootstrap password handed over again")
        kill_in_window("ia-first-killed-2", "first-admin " + person("ops-alice"), "KILL")
        ok(keycloak_ready(), "Keycloak back after the second kill")
        app.wait_until_succeeds("test \"$(systemctl show terrace-identity-bootstrap-admin.service -p ActiveState --value)\" = inactive", timeout=120)
        ok(sorted(master_names().split(",")) == sorted([reset.group(1), "terrace-bootstrap"]), "the second killed run left the bootstrap account")
        # MAJOR-1: as if the next run died right after creating the named user (no password, no role).
        ok(probe("half-admin", f"{T}/bootstrap", "ops-alice") == "201", "half-created named administrator injected")
        out = tia(f"first-admin {person('ops-alice')}")
        ok("First administrator ops-alice ready" in out and "signs in and holds the admin role" in out and "terrace-bootstrap deleted and refused" in out, "resume repaired, proved and finished")
        ok(app.execute("test -e /run/terrace-identity-admin/bootstrap-admin-password")[0] == 1, "delivered file removed")
        ok(master_names() == f"ops-alice,{reset.group(1)}", "the named administrator and the reset recovery account remain")
        ok(sql("select count(*) from user_role_mapping m join user_entity u on u.id = m.user_id join keycloak_role k on k.id = m.role_id join realm r on r.id = u.realm_id where r.name = 'master' and u.username = 'ops-alice' and k.name = 'admin'") == "1", "named administrator holds admin")
        outcome = probe("token", "terrace-bootstrap", f"{T}/bootstrap")
        ok(refused(outcome), f"bootstrap account can no longer sign in ({outcome})")
        ok(sql("select admin_events_enabled from realm where name = 'master'") == "t", "master-realm admin events enabled")
        handoff = f"{H}/master-ops-alice.password"
        ok(root_only(handoff), "initial password handed over in a root-only file")
        keep_pattern(handoff, "alice-initial")
        ok(probe("token", "ops-alice", handoff) == "200", "the handed-over initial password signs in")
        ok("Already done" in tia(f"first-admin {person('ops-alice')}"), "first-admin is idempotent")

    with subtest("initial password must be changed before use"):
        alice = secret_file("alice")
        app.succeed(f"umask 077; cp {handoff} {T}/alice-initial")
        ok("still has an initial password" in tia("list --admin ops-alice --password-stdin", stdin=f"{T}/alice-initial", expect=1), "initial password refused for administration")
        ok("Password of ops-alice changed; the old one is refused." in tia("password --admin ops-alice --password-stdin", stdin=lines("alice-change", f"{T}/alice-initial", alice)), "administrator changed the initial password")
        ok(app.execute(f"test -e {handoff}")[0] == 1, "initial handoff file removed")
