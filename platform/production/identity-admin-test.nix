        app.succeed("systemctl restart keycloak.service", timeout=360)
        ok(refused(probe("token", "ops-alice", alice)) and refused(probe("token", "ops-bob", bob)), "no named administrator can sign in")
        ok("authentication as ops-alice failed" in tia("list --admin ops-alice --password-stdin", stdin=alice, expect=1), "administration unavailable")
        ok("would stop Keycloak (sign-in is down for about a minute), create temporary administrator terrace-recovery-" in tia("break-glass begin --dry-run"), "break-glass dry run")
        # MAJOR-2/3: begin is killed while Keycloak is stopped; its account must still be usable from the handoff written first.
        kill_in_window("ia-begin-killed", "break-glass begin", "KILL")
        ok(keycloak_ready(), "Keycloak comes back by itself after begin was killed in the window")
        app.wait_until_succeeds("test \"$(systemctl show terrace-identity-bootstrap-admin.service -p ActiveState --value)\" = inactive", timeout=120)
        # Only the run's recorded result (no secret) is left; the credential files are gone.
        ok(app.succeed("find /run/terrace-identity-admin/kc-bootstrap -type f -printf '%f\\n'").split() == ["result"], "bootstrap credential files removed after the kill")
        first = [name for name in master_names().split(",") if name.startswith("terrace-recovery-")]
        ok(len(first) == 1, f"the killed begin created one recovery account ({len(first)})")
        ok(re.fullmatch(r"terrace-recovery-[0-9]{14}-[0-9a-f]{8}", first[0]) is not None, "recovery account name has a random suffix")
        first_file = f"{H}/master-{first[0]}.password"
        ok(root_only(first_file) and probe("token", first[0], first_file) == "200", "its handoff was written first and signs in")
        keep_pattern(first_file, "recovery-killed")
        ok("a working temporary administrator exists" in tia("break-glass begin", expect=1), "begin refuses while a working recovery account exists")
        # The handoff is lost (tmpfs gone with a reboot): the leftover is unusable, so begin proceeds; a hangup does not stop it.
        app.succeed(f"install -m 0400 {first_file} {T}/recovery-killed && rm {first_file}")
        kill_in_window("ia-begin-hup", "break-glass begin", "HUP")
        app.wait_until_succeeds("test \"$(systemctl show ia-begin-hup.service -p SubState --value)\" = exited", timeout=420)
        ok(unit_state("ia-begin-hup.service", "ExecMainStatus") == "0", "begin finished despite SIGHUP in the window")
        ok(keycloak_ready(), "Keycloak ready after the second begin")
        journal = app.succeed("journalctl -u ia-begin-hup.service -o cat --no-pager")
        ok("Unusable temporary administrators also present" in journal, "begin proceeded past the unusable leftover")
        recovery = [name for name in master_names().split(",") if name.startswith("terrace-recovery-") and name != first[0]]
        ok(len(recovery) == 1, "a second recovery account")
        recovery = recovery[0]
        recovery_file = f"{H}/master-{recovery}.password"
        ok(root_only(recovery_file), "recovery handoff root-only")
        keep_pattern(recovery_file, "recovery")
        app.succeed(f"install -m 0400 {recovery_file} {T}/recovery")
        ok(unit_state("nginx.service", "ActiveState") == "inactive", "proxy still stopped")
        status_out = tia("status")
        ok(first[0] in status_out and recovery in status_out and "Temporary administrators:" in status_out, "status shows both temporary accounts")
        # MINOR-8: a forgotten temporary account fails the check unit and logs at crit (threshold 0 in this test).
        app.succeed("systemctl reset-failed terrace-identity-temporary-admin-check.service || true")
        status, _ = app.execute("systemctl start terrace-identity-temporary-admin-check.service")
        ok(status != 0 and unit_state("terrace-identity-temporary-admin-check.service", "ActiveState") == "failed", "temporary-administrator check fails while one exists")
        ok("temporary Keycloak administrator(s) older than 0 minutes" in app.succeed("journalctl -t terrace-identity-admin -p crit -o cat --no-pager"), "crit journal line")
        ok("ops-alice enabled" in tia(f"admin enable --admin {recovery} --password-stdin --username ops-alice", stdin=recovery_file), "recovery account enables the named administrator")
        ok(probe("token", "ops-alice", alice) == "200", "named administrator repaired by the recovery account")
        ok("as a named administrator" in tia(f"break-glass end --admin {recovery} --password-stdin", stdin=recovery_file, expect=1), "break-glass end needs a named administrator")
        out = tia("break-glass end --admin ops-alice --password-stdin", stdin=alice)
        ok(first[0] in out and recovery in out and "none remains" in out, "both temporary accounts deleted")
        for name, path in [(first[0], f"{T}/recovery-killed"), (recovery, f"{T}/recovery")]:
            outcome = probe("token", name, path)
            ok(refused(outcome), f"temporary account can no longer sign in ({outcome})")
        ok(app.execute(f"test -e {recovery_file}")[0] == 1, "recovery handoff removed")
        ok("Temporary administrators: none" in tia("status"), "no temporary administrator left")
        app.succeed("systemctl reset-failed terrace-identity-temporary-admin-check.service")
        app.succeed("systemctl start terrace-identity-temporary-admin-check.service")
        ok(unit_state("terrace-identity-temporary-admin-check.service", "Result") == "success", "the check passes again")
        app.succeed("systemctl start nginx.service")
        tia("admin enable --admin ops-alice --password-stdin --username ops-bob", stdin=alice)

    with subtest("a bootstrap unit that never starts: the tool starts Keycloak itself and says so"):
        before_pid = pids(["keycloak"])["keycloak"]
        app.succeed("mkdir -p /run/systemd/system/terrace-identity-bootstrap-admin.service.d && printf '[Unit]\\nConditionPathExists=/nonexistent\\n' >/run/systemd/system/terrace-identity-bootstrap-admin.service.d/never.conf && systemctl daemon-reload")
        started = time.monotonic()
        out = tia("break-glass begin", expect=1)
        elapsed = time.monotonic() - started
        ok("did not succeed; Keycloak is running and ready again" in out, "truthful report")
        ok(elapsed < 240, f"no long wait ({round(elapsed)} s)")
        ok(keycloak_ready() and pids(["keycloak"])["keycloak"] != before_pid, "Keycloak was stopped and started again by the tool")
        ok(not [n for n in master_names().split(",") if n.startswith("terrace-recovery-")], "no recovery account")
        ok(app.succeed(f"find {H} -name 'master-terrace-recovery-*' | wc -l").strip() == "0", "no handoff for an account never created")
        app.succeed("rm -rf /run/systemd/system/terrace-identity-bootstrap-admin.service.d && systemctl daemon-reload")

    with subtest("an unprivileged local process locks out every named administrator; break-glass still works"):
        app.succeed("umask 022; python3 -c 'import secrets; print(secrets.token_hex(24))' >/tmp/not-the-password")
        for name in ["ops-alice", "ops-bob"]:
            outcomes = [app.succeed(f"runuser -u nobody -- python3 /etc/identity-admin-probe.py token {name} /tmp/not-the-password").strip() for _ in range(6)]
            ok(all(refused(o) for o in outcomes), f"{name}: wrong guesses from nobody refused")
        ok(refused(probe("token", "ops-alice", alice)) and refused(probe("token", "ops-bob", bob)), "every named administrator is locked out")
        out = tia("break-glass begin")
        found = re.search(r"Recovery administrator (terrace-recovery-[0-9]{14}-[0-9a-f]{8}) created", out)
        assert found is not None, "recovery account"
        locked = found.group(1)
        locked_file = f"{H}/master-{locked}.password"
        keep_pattern(locked_file, "recovery-lockout")
        ok(root_only(locked_file) and probe("token", locked, locked_file) == "200", "the recovery account (random name) signs in")
        ok("lockout cleared" in tia(f"admin enable --admin {locked} --password-stdin --username ops-alice", stdin=locked_file), "recovery account clears the lockout")
        ok(probe("token", "ops-alice", alice) == "200", "named administrator back")
        ok(locked in tia("break-glass end --admin ops-alice --password-stdin", stdin=alice), "recovery account ended")
        tia("admin enable --admin ops-alice --password-stdin --username ops-bob", stdin=alice)
        ok(probe("token", "ops-bob", bob) == "200", "second administrator back")

    with subtest("journal: one line per action with operator, administrator and target"):
        journal = app.succeed("journalctl -t terrace-identity-admin -o cat --no-pager")
        for needle in ["action=first-admin target=master/user/ops-alice result=dry-run",
                       # The run that created the bootstrap account was killed in the window: its "started" line remains.
                       "admin=- action=bootstrap-admin-create target=master/user/terrace-bootstrap result=started",
                       "admin=terrace-bootstrap action=admin-create target=master/user/ops-alice result=done",
                       "admin=ops-alice action=master-secure target=master/brute-force+events result=done",
                       "action=admin-repair target=master/user/ops-alice result=refused-own-password",
                       "action=bootstrap-admin-delete target=master/user/terrace-bootstrap result=done",
                       "admin=ops-alice action=admin-password target=master/user/ops-alice result=done",
                       "admin=ops-alice action=admin-create target=master/user/ops-bob result=done",
                       "admin=ops-alice action=admin-unlock target=master/user/ops-bob result=done",
                       "admin=ops-alice action=user-create target=terrace/user/ed-carol result=done",
                       "operator=operator admin=ops-alice action=user-grant target=terrace/user/ed-carol/role/editorial-admin result=done",
                       "operator=operator admin=ops-alice action=list target=terrace result=done",
                       "action=user-revoke target=terrace/user/ad-dave/role/editorial-admin result=refused-last-admin",
                       "action=user-disable target=terrace/user/ed-carol result=done",
                       "action=client-secret-sync target=terrace/client/terrace-cms/secret result=done",
                       "action=realm-apply target=terrace/realm result=refused-plan-mismatch",
                       "action=realm-apply-client-create target=terrace/client/terrace-probe result=done",
                       "action=realm-apply-role-create target=terrace/role/terrace-reconcile-probe result=done",
                       "action=realm-apply target=terrace/realm result=converged",
                       "action=admin-disable target=master/user/ops-alice result=refused-last-admin",
                       f"action=break-glass-begin target=master/user/{first[0]} result=started",
                       f"action=break-glass-begin target=master/user/{recovery} result=started",
                       f"action=break-glass-begin target=master/user/{recovery} result=done",
                       f"action=break-glass-begin target=master/user/{recovery} result=done",
                       f"admin=ops-alice action=break-glass-end target=master/user/{recovery} result=done"]:
            ok(needle in journal, "journal: " + needle.split("action=")[1].split(" ")[0])

    with subtest("no password, client secret or token anywhere it must not be, on the host and the operator"):
        # A real access token for the scan: captured from a grant into a root-only file.
        ok(probe("token", "ops-alice", alice, f"{T}/token") == "200", "an access token captured")
        keep_pattern(f"{T}/token", "token")
        names = app.succeed(f"ls {T}/named").split()
        # bootstrap; alice initial and chosen; bob initial and chosen; a wrong password; carol and dave temporary; carol chosen;
        # terrace-cms old and new; the new client's secret; four recovery passwords; an access token; the injected own password.
        ok(len(names) == 18, f"{len(names)} named values")
        # One value per line, no empty line (an empty grep pattern would match everything), plus the hex form the
        # kernel's exec audit records use for arguments with spaces.
        app.succeed(f"cd {T}/named && cat * | sed '/^$/d' >{T}/patterns && python3 -c 'import sys; [print(l.strip().encode().hex().upper()) for l in open(sys.argv[1]) if l.strip()]' {T}/patterns >>{T}/patterns")
        ok(app.succeed(f"grep -c '^$' {T}/patterns || true").strip() == "0", "no empty pattern")
        canary = "terrace-scan-canary-" + os.urandom(24).hex()
        spaced = "terrace-scan-spaced-" + os.urandom(24).hex()
        app.succeed(f"umask 077; echo {canary} >{T}/canary && echo {canary} >/var/tmp/terrace-scan-canary && chmod 0644 /var/tmp/terrace-scan-canary && logger -t terrace-scan {canary} && sync")
        app.succeed(f"systemd-run --unit=terrace-scan-canary sh -c '${pkgs.coreutils}/bin/sleep 900; true' {canary}")
        # An argument with spaces is recorded hex-encoded by the audit trace: proves the hex patterns are needed and work.
        app.succeed(f"systemd-run --unit=terrace-scan-spaced sh -c 'echo {spaced} >/dev/null; ${pkgs.coreutils}/bin/sleep 900'")
        app.succeed(f"echo {canary} >>{T}/outputs")
        app.succeed(f"python3 -c 'import sys; print(sys.argv[1].encode().hex().upper())' {spaced} >{T}/spaced-hex")
        app.wait_until_succeeds(f"journalctl --namespace='*' -o export --no-pager | grep -acF -f {T}/spaced-hex", timeout=30)
        ok(int(app.succeed(f"journalctl --namespace='*' -o export --no-pager | grep -acF -f {T}/spaced-hex || true").strip()) > 0, "exec audit trace records arguments (hex form found)")
        lost_now = int(app.succeed("auditctl -s | awk '$1 == \"lost\" {print $2}'").strip())
        ok(lost_now == audit_lost, f"the exec audit trace lost no record during the proof ({audit_lost} -> {lost_now})")
        app.succeed("sync")
        ok(int(app.succeed(f"grep -acF -f {T}/spaced-hex /var/log/audit/audit.log || true").strip()) > 0, "auditd's log on the root disk holds the trace")
        GREP = "sh -c 'grep -lF -D skip -f \"$0\" -- \"$@\"; test $? -le 1 || exit 255'"
        def scans(machine, patterns, base=T):
            found = {}
            found["journal (incl. exec audit)"] = machine.succeed(f"journalctl --namespace='*' -o export --no-pager 2>/dev/null | grep -acF -f {patterns} || true").strip()
            found["process arguments now"] = machine.succeed(f"cat /proc/[0-9]*/cmdline 2>/dev/null | tr '\\0' '\\n' | grep -cF -f {patterns} || true").strip()
            found["world-readable files"] = machine.succeed(f"{{ for fs in / /run /tmp /dev/shm /var/tmp; do find $fs -xdev \\( -path /nix -o -path /proc -o -path /sys -o -path {base} \\) -prune -o -type f -perm -o=r -print0; done; }} 2>/dev/null | xargs -0r {GREP} {patterns} | wc -l").strip()
            found["root-disk files"] = machine.succeed(f"find / -xdev \\( -path /nix -o -path /var/lib/postgresql \\) -prune -o -type f -print0 | xargs -0r {GREP} {patterns} | wc -l", timeout=600).strip()
            return found
        control = scans(app, f"{T}/canary")
        control["tool output"] = app.succeed(f"grep -cF -f {T}/canary {T}/outputs || true").strip()
        ok(all(int(hits) > 0 for hits in control.values()), f"canary found by every scan {control}")
        app.succeed("systemctl stop terrace-scan-canary.service terrace-scan-spaced.service; rm -f /var/tmp/terrace-scan-canary")
        found = scans(app, f"{T}/patterns")
        found["tool output"] = app.succeed(f"grep -cF -f {T}/patterns {T}/outputs || true").strip()
        for where, hits in found.items():
            which = []
            if hits != "0":
                # Name the values the journal holds (diagnosis only), never the values.
                which = [name for name in names if app.succeed(f"python3 -c 'import sys; [print(l.strip()) for l in open(sys.argv[1]) if l.strip()]; [print(l.strip().encode().hex().upper()) for l in open(sys.argv[1]) if l.strip()]' {T}/named/{name} >{T}/one && journalctl --namespace='*' -o export --no-pager | grep -acF -f {T}/one || true").strip() != "0"]
            ok(hits == "0", f"no value in {where}" + (f" (journal matches for {which})" if which else ""))
        left = sorted(app.succeed("cd /run/terrace-identity-admin && find . -type f -printf '%P\\n'").split())
        ok(left == ["handoff/terrace-ad-dave.password", "lock"], f"only the undelivered ad-dave handoff and the empty lock file are left {left}")
        ok(app.succeed("stat -c %s /run/terrace-identity-admin/lock").strip() == "0", "the lock file holds nothing")
        # The operator machine: the same values, fetched over SSH into its tmpfs, must not be on its disk, journal or arguments.
        operator.succeed("rm -rf /dev/shm/scan && install -d -m 0700 /dev/shm/scan && " + SSH + shlex.quote(f"sudo cat {T}/patterns") + " >/dev/shm/scan/patterns")
        operator.succeed("umask 077; echo " + canary + " >/dev/shm/scan/canary && echo " + canary + " >/var/tmp/terrace-scan-canary && chmod 0644 /var/tmp/terrace-scan-canary && logger -t terrace-scan " + canary + " && sync")
        operator.succeed(f"systemd-run --unit=terrace-scan-canary sh -c '${pkgs.coreutils}/bin/sleep 900; true' {canary}")
        control = scans(operator, "/dev/shm/scan/canary", base="/dev/shm/scan")
        ok(all(int(hits) > 0 for hits in control.values()), f"operator: canary found by every scan {control}")
        operator.succeed("systemctl stop terrace-scan-canary.service; rm -f /var/tmp/terrace-scan-canary")
        for where, hits in scans(operator, "/dev/shm/scan/patterns", base="/dev/shm/scan").items():
            ok(hits == "0", f"operator: no value in {where}")
        lost_now = int(operator.succeed("auditctl -s | awk '$1 == \"lost\" {print $2}'").strip())
        ok(lost_now == operator_audit_lost, f"operator: the exec audit trace lost no record ({operator_audit_lost} -> {lost_now})")
        operator.succeed("rm -rf /dev/shm/scan")

    with subtest("stop owned guests"):
        app.shutdown()
        operator.shutdown()
    print("IDENTITY-ADMIN-CHECKS " + json.dumps(checks))
    print("IDENTITY-ADMIN-PROOF " + json.dumps({"assertions": len(checks), "seconds": round(time.time() - started_at, 2)}))
  '';
}
