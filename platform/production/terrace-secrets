#!/usr/bin/env python3
"""terrace-secrets: create, rotate, re-key, deliver and verify Terrace production secrets.

Operator commands work on a private store directory (TERRACE_SECRETS_STORE), never this
public repository. Host commands (install, verify) run as root on a production host.
No secret value is ever printed, logged or passed as a command argument: values exist in
this process's memory, in sops/age pipes, or briefly in a private tmpfs scratch directory.
See docs/secrets.md.
"""
import argparse
import json
import os
import pwd
import grp
import re
import secrets as token
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

HOST_RE = re.compile(r"^[a-z][a-z0-9-]{0,30}$")
NAME_RE = re.compile(r"^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*){1,3}$")
ENCRYPTED_RE = re.compile(r"^ENC\[AES256_GCM,data:[A-Za-z0-9+/=]*,iv:[A-Za-z0-9+/=]+,tag:[A-Za-z0-9+/=]+,type:[a-z]+\]$")
AGE_RECIPIENT_RE = re.compile(r"^age1[02-9ac-hj-np-z]{58}$")
SSH_ED25519_RE = re.compile(r"^ssh-ed25519 [A-Za-z0-9+/]{68}(?: [^\n]*)?$")
MAX_VALUE = 64 * 1024
MAX_FILE = 1024 * 1024
HOST_FILE = Path("/var/lib/terrace-secrets/secrets.sops.json")
HOST_KEY = Path("/etc/ssh/ssh_host_ed25519_key")
MANIFEST = Path("/etc/terrace/secrets-manifest.json")
SECRETS_ROOT = Path("/run/secrets")
MOUNT_ROOT = Path("/run/secrets.d")
REHEARSAL_PREFIX = "rehearsal/"


class Refused(Exception):
    """A fixed, value-free message for the operator."""


def inventory():
    path = os.environ.get("TERRACE_SECRETS_INVENTORY") or str(Path(__file__).resolve().with_name("inventory.json"))
    data = json.loads(Path(path).read_text())
    entries = {entry["name"]: entry for entry in data["secrets"]}
    for name, entry in entries.items():
        if not NAME_RE.match(name) or entry["generator"] not in ("hex32", "ssh-ed25519", "external") \
                or entry["rotation"] not in ("rotate", "manual", "set") or not entry["roles"]:
            raise Refused("inventory.json is malformed")
    return entries


def expected(entries, role, features, delivered_only=False):
    return sorted(name for name, entry in entries.items()
                  if role in entry["roles"]
                  and (entry["feature"] == "core" or entry["feature"] in features)
                  and (entry["delivered"] or not delivered_only))


def nested_set(tree, name, value):
    parts = name.split("/")
    for part in parts[:-1]:
        tree = tree.setdefault(part, {})
        if not isinstance(tree, dict):
            raise Refused(f"{name}: path collides with a value")
    tree[parts[-1]] = value


def leaves(tree, prefix=""):
    """Yield (name, value) for every leaf, skipping the sops metadata."""
    for key, value in tree.items():
        if not prefix and key == "sops":
            continue
        name = prefix + key
        if isinstance(value, dict):
            yield from leaves(value, name + "/")
        else:
            yield name, value


def guard_argv(argv, values):
    """Refuse any command line that would carry a secret value."""
    for value in values:
        if value and any(value in part for part in argv):
            raise Refused("refused to pass a secret value as a command argument")


# ---- private scratch and subprocesses -------------------------------------

def memory_filesystem(path):
    """True when PATH is on tmpfs or ramfs (Linux mountinfo)."""
    try:
        mounts = Path("/proc/self/mountinfo").read_text().splitlines()
    except OSError:
        return False
    target = os.path.realpath(path)
    best, kind = "", None
    for line in mounts:
        left, right = line.split(" - ", 1)
        point = left.split()[4].replace("\\040", " ")
        if (target == point or target.startswith(point.rstrip("/") + "/")) and len(point) >= len(best):
            best, kind = point, right.split()[0]
    return kind in ("tmpfs", "ramfs")


class Scratch:
    """A private directory on tmpfs/ramfs, removed on exit."""

    def __enter__(self):
        root = os.environ.get("TERRACE_SECRETS_SCRATCH") or os.environ.get("XDG_RUNTIME_DIR") or "/dev/shm"
        # Linux proves the filesystem type; elsewhere (a macOS RAM disk) the operator must state it.
        declared = sys.platform != "linux" and os.environ.get("TERRACE_SECRETS_SCRATCH_IS_RAMDISK") == "1" \
            and bool(os.environ.get("TERRACE_SECRETS_SCRATCH"))
        if not os.path.isdir(root) or not (memory_filesystem(root) or declared):
            raise Refused("scratch directory is not on tmpfs or ramfs; set TERRACE_SECRETS_SCRATCH to a memory filesystem")
        self.path = Path(tempfile.mkdtemp(prefix="terrace-secrets-", dir=root))
        os.chmod(self.path, 0o700)
        return self.path

    def __exit__(self, *_exc):
        shutil.rmtree(self.path, ignore_errors=True)


def run(argv, stdin=b"", values=(), env_extra=None, check=True):
    guard_argv(argv, values)
    with tempfile.TemporaryDirectory(prefix="terrace-secrets-home-") as home:
        env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": home, "XDG_CONFIG_HOME": home,
               "LC_ALL": "C.UTF-8"}
        if os.environ.get("SOPS_AGE_KEY_FILE"):
            env["SOPS_AGE_KEY_FILE"] = os.environ["SOPS_AGE_KEY_FILE"]
        env.update(env_extra or {})
        result = subprocess.run(argv, input=stdin, capture_output=True, env=env, cwd=home)
    if check and result.returncode != 0:
        # sops/age/ssh errors never contain values, but keep the output fixed anyway.
        raise Refused(f"{Path(argv[0]).name} {argv[1] if len(argv) > 1 else ''} failed (exit {result.returncode})")
    return result


def recipient_of_ssh_public(public_line):
    return run(["ssh-to-age"], stdin=public_line.encode()).stdout.decode().strip()


# ---- store -----------------------------------------------------------------

def store():
    root = os.environ.get("TERRACE_SECRETS_STORE")
    if not root:
        raise Refused("set TERRACE_SECRETS_STORE to the private secrets store directory")
    path = Path(root)
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    if path.stat().st_mode & 0o077:
        raise Refused("the secrets store directory must not be accessible by group or others")
    return path


def host_dir(name, create=False):
    if not HOST_RE.match(name):
        raise Refused("host names are lowercase letters, digits and dashes")
    path = store() / "hosts" / name
    if create:
        path.mkdir(mode=0o700, parents=True, exist_ok=True)
    elif not path.is_dir():
        raise Refused(f"unknown host {name}; run `host create` first")
    return path


def read_text(path):
    return Path(path).read_text().strip()


def write_new(path, data, mode=0o600, replace=False):
    path = Path(path)
    tmp = path.with_name("." + path.name + ".tmp")
    if path.exists() and not replace:
        raise Refused(f"{path.name} already exists")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    try:
        os.write(fd, data)
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, path)


def host_info(name):
    directory = host_dir(name)
    role = read_text(directory / "role")
    features = [f for f in read_text(directory / "features").split(",") if f] if (directory / "features").exists() else []
    return directory, role, features


def recipients(name):
    directory = host_dir(name)
    if (directory / "pending-rekey").exists():
        raise Refused(f"{name} has a new host key that is not yet applied; run `rekey {name}`")
    escrow = read_text(store() / "escrow.recipient")
    host = read_text(directory / "recipient")
    for value in (escrow, host):
        if not AGE_RECIPIENT_RE.match(value):
            raise Refused("a stored recipient is not an age X25519 recipient")
    if escrow == host:
        raise Refused("the host and escrow recipients must differ")
    return [host, escrow]


def encrypt(name, tree, recipient_list):
    plaintext = json.dumps(tree, indent=1, sort_keys=True).encode()
    values = [value for _, value in leaves(tree)]
    out = run(["sops", "encrypt", "--age", ",".join(recipient_list), "--input-type", "json", "--output-type", "json",
               "--filename-override", "secrets.sops.json"], stdin=plaintext, values=values).stdout
    write_new(host_dir(name) / "secrets.sops.json", out, replace=True)


def decrypt(name):
    if not os.environ.get("SOPS_AGE_KEY_FILE"):
        raise Refused("set SOPS_AGE_KEY_FILE to the escrow (or an operator) age identity")
    path = host_dir(name) / "secrets.sops.json"
    out = run(["sops", "decrypt", "--input-type", "json", "--output-type", "json", str(path)]).stdout
    return json.loads(out)


def generate_value(entry, name, host_directory):
    if entry["generator"] == "hex32":
        return token.token_hex(32)
    if entry["generator"] == "ssh-ed25519":
        with Scratch() as scratch:
            key = scratch / "key"
            run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", f"terrace-{name.replace('/', '-')}", "-f", str(key)])
            private = key.read_text()
            public = (scratch / "key.pub").read_text()
        public_dir = host_directory / "public"
        public_dir.mkdir(mode=0o700, exist_ok=True)
        write_new(public_dir / (name.replace("/", "--") + ".pub"), public.encode(), mode=0o644, replace=True)
        return private
    raise Refused(f"{name} is supplied externally; use `set`")


# ---- operator commands -----------------------------------------------------

def cmd_escrow_create(args):
    root = store()
    if (root / "escrow.recipient").exists():
        raise Refused("this store already has an escrow recipient")
    out = Path(args.out)
    if out.exists():
        raise Refused("the escrow output file already exists")
    identity = run(["age-keygen"]).stdout
    public = run(["age-keygen", "-y"], stdin=identity).stdout.decode().strip()
    if not AGE_RECIPIENT_RE.match(public):
        raise Refused("age-keygen returned an unexpected recipient")
    write_new(out, identity, mode=0o600)
    write_new(root / "escrow.recipient", (public + "\n").encode(), mode=0o644)
    print(f"Escrow recipient {public}. Keep the identity file offline; it decrypts every host.")


def cmd_host_create(args):
    entries = inventory()
    if args.role not in {role for entry in entries.values() for role in entry["roles"]}:
        raise Refused("unknown role")
    existing = (store() / "hosts" / args.host / "recipient").exists()
    if existing and not args.replace:
        raise Refused(f"{args.host} already has a host key; use --replace for a replacement host")
    if args.replace and not existing:
        raise Refused(f"{args.host} has no host key to replace")
    directory = host_dir(args.host, create=True)
    if existing and read_text(directory / "role") != args.role:
        raise Refused("a replacement keeps its role")
    stage = Path(args.stage)
    if stage.exists():
        raise Refused("the staging directory must not exist yet")
    stage.mkdir(mode=0o700, parents=True)
    key = stage / "ssh_host_ed25519_key"
    run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", f"root@{args.host}", "-f", str(key)])
    os.chmod(key, 0o600)
    public = (stage / "ssh_host_ed25519_key.pub").read_text().strip()
    if not SSH_ED25519_RE.match(public):
        raise Refused("ssh-keygen returned an unexpected public key")
    recipient = recipient_of_ssh_public(public)
    if not AGE_RECIPIENT_RE.match(recipient):
        raise Refused("ssh-to-age returned an unexpected recipient")
    if existing:
        retired = directory / "retired"
        retired.mkdir(mode=0o700, exist_ok=True)
        serial = len(list(retired.glob("*.recipient"))) + 1
        shutil.copy2(directory / "recipient", retired / f"{serial}.recipient")
        shutil.copy2(directory / "ssh_host_ed25519_key.pub", retired / f"{serial}.pub")
        write_new(directory / "pending-rekey", f"{serial}\n".encode(), replace=True)
    write_new(directory / "role", (args.role + "\n").encode(), mode=0o644, replace=True)
    write_new(directory / "features", (",".join(sorted(set(args.feature or []))) + "\n").encode(), mode=0o644, replace=True)
    write_new(directory / "ssh_host_ed25519_key.pub", (public + "\n").encode(), mode=0o644, replace=True)
    write_new(directory / "recipient", (recipient + "\n").encode(), mode=0o644, replace=True)
    print(f"Host {args.host}: {public.split()[0]} key staged; age recipient {recipient}."
          + (" Run `rekey` before pushing." if existing else ""))


def cmd_generate(args):
    entries = inventory()
    directory, role, features = host_info(args.host)
    if (directory / "secrets.sops.json").exists():
        raise Refused(f"{args.host} already has secrets; use `rotate` or `set`")
    tree = {}
    count = 0
    for name in expected(entries, role, features):
        entry = entries[name]
        if entry["generator"] == "external":
            continue
        nested_set(tree, name, generate_value(entry, name, directory))
        count += 1
    encrypt(args.host, tree, recipients(args.host))
    external = [name for name in expected(entries, role, features) if entries[name]["generator"] == "external"]
    print(f"Generated {count} secrets for {args.host}. Supply with `set`: {', '.join(external) or 'none'}.")


def read_value():
    data = sys.stdin.buffer.read(MAX_VALUE + 1)
    if len(data) > MAX_VALUE or not data:
        raise Refused("a value must be 1 byte to 64 KiB on stdin")
    text = data.decode("utf-8")
    if "\n" not in text.rstrip("\n"):
        text = text.rstrip("\n")
    return text


def allowed_name(entries, role, features, name, rehearsal):
    if name.startswith(REHEARSAL_PREFIX) and rehearsal and NAME_RE.match(name):
        return True
    return name in expected(entries, role, features)


def cmd_set(args):
    entries = inventory()
    _, role, features = host_info(args.host)
    if not allowed_name(entries, role, features, args.name, args.rehearsal):
        raise Refused(f"{args.name} is not a secret of this host")
    value = read_value()
    tree = decrypt(args.host)
    nested_set(tree, args.name, value)
    encrypt(args.host, tree, recipients(args.host))
    print(f"Set {args.name} on {args.host}. Run `push` to deliver it.")


def cmd_rotate(args):
    entries = inventory()
    directory, role, features = host_info(args.host)
    if args.name not in expected(entries, role, features):
        raise Refused(f"{args.name} is not a secret of this host")
    entry = entries[args.name]
    if entry["rotation"] != "rotate":
        raise Refused(f"{args.name} has a consumer that keeps its own copy; follow the manual procedure in docs/secrets.md")
    tree = decrypt(args.host)
    nested_set(tree, args.name, generate_value(entry, args.name, directory))
    encrypt(args.host, tree, recipients(args.host))
    units = ", ".join(entry["restartUnits"]) or "none"
    print(f"Rotated {args.name} on {args.host}. `push` delivers it and restarts: {units}.")


def cmd_rekey(args):
    directory = host_dir(args.host)
    if not (directory / "pending-rekey").exists():
        raise Refused(f"{args.host} has no new host key to apply")
    tree = decrypt(args.host)
    (directory / "pending-rekey").unlink()
    encrypt(args.host, tree, recipients(args.host))
    print(f"Re-encrypted {args.host} to its new host key and the escrow key; the retired key is no longer a recipient.")


def file_report(name):
    """Names and recipients of a stored file, without decrypting it."""
    entries = inventory()
    directory, role, features = host_info(name)
    path = directory / "secrets.sops.json"
    if not path.exists():
        raise Refused(f"{name} has no secrets yet; run `generate`")
    document = json.loads(path.read_text())
    present = {}
    for leaf, value in leaves(document):
        present[leaf] = isinstance(value, str) and bool(ENCRYPTED_RE.match(value))
    stored = sorted(item["recipient"] for item in document.get("sops", {}).get("age", []))
    return entries, role, features, present, stored, path


def cmd_check(args):
    entries, role, features, present, stored, _ = file_report(args.host)
    problems = [f"missing {name}" for name in expected(entries, role, features) if name not in present]
    problems += [f"not encrypted {name}" for name, ok in present.items() if not ok]
    problems += [f"unexpected {name}" for name in present
                 if not allowed_name(entries, role, features, name, args.rehearsal)]
    if stored != sorted(recipients(args.host)):
        problems.append("recipients differ from the host key and the escrow key")
    for problem in problems:
        print(problem)
    if problems:
        raise Refused(f"{args.host}: {len(problems)} problem(s)")
    print(f"{args.host}: {len(present)} secrets encrypted to the host key and the escrow key.")


def cmd_public(args):
    directory = host_dir(args.host)
    path = directory / "public" / (args.name.replace("/", "--") + ".pub")
    if not NAME_RE.match(args.name) or not path.exists():
        raise Refused("no stored public half for that secret")
    print(path.read_text().strip())


def cmd_push(args):
    cmd_check(argparse.Namespace(host=args.host, rehearsal=args.rehearsal))
    directory = host_dir(args.host)
    public = read_text(directory / "ssh_host_ed25519_key.pub").split()
    ciphertext = (directory / "secrets.sops.json").read_bytes()
    with tempfile.TemporaryDirectory(prefix="terrace-secrets-push-") as private:
        known = Path(private) / "known_hosts"
        known.write_text(f"{args.host} {public[0]} {public[1]}\n")
        argv = ["ssh", "-o", f"HostKeyAlias={args.host}", "-o", f"UserKnownHostsFile={known}",
                "-o", "StrictHostKeyChecking=yes", "-o", "GlobalKnownHostsFile=/dev/null", "-o", "BatchMode=yes",
                "-o", "IdentitiesOnly=yes", "-p", str(args.port)]
        if args.identity:
            argv += ["-i", args.identity]
        argv += [f"{args.user}@{args.address}", "/run/wrappers/bin/sudo", "-n", "/run/current-system/sw/bin/terrace-secrets", "install"]
        env = {"SSH_AUTH_SOCK": os.environ["SSH_AUTH_SOCK"]} if os.environ.get("SSH_AUTH_SOCK") else {}
        result = run(argv, stdin=ciphertext, env_extra=env, check=False)
    sys.stdout.write(result.stdout.decode(errors="replace"))
    if result.returncode != 0:
        raise Refused(f"push to {args.host} failed (exit {result.returncode})")


# ---- host commands ---------------------------------------------------------

def require_root():
    if os.geteuid() != 0:
        raise Refused("run as root on the host")


def validate_ciphertext(data, own_recipient):
    try:
        document = json.loads(data)
    except ValueError:
        raise Refused("input is not a sops JSON file")
    if not isinstance(document, dict) or not isinstance(document.get("sops"), dict):
        raise Refused("input is not a sops JSON file")
    names = list(leaves(document))
    if not names or any(not (isinstance(v, str) and ENCRYPTED_RE.match(v)) for _, v in names):
        raise Refused("input contains a value that is not encrypted; refusing to store plaintext")
    stored = [item.get("recipient") for item in document["sops"].get("age", [])]
    if own_recipient not in stored:
        raise Refused("input is not encrypted to this host's key")
    if len(stored) < 2:
        raise Refused("input must also be encrypted to the escrow key")
    return len(names)


def cmd_install(args):
    require_root()
    data = sys.stdin.buffer.read(MAX_FILE + 1)
    if len(data) > MAX_FILE:
        raise Refused("input too large")
    own = recipient_of_ssh_public(Path(str(HOST_KEY) + ".pub").read_text().strip())
    count = validate_ciphertext(data, own)
    HOST_FILE.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    write_new(HOST_FILE, data, mode=0o600, replace=True)
    restart = subprocess.run(["systemctl", "restart", "sops-install-secrets.service"], capture_output=True)
    if restart.returncode != 0:
        raise Refused("sops-install-secrets failed; check `journalctl -u sops-install-secrets` (names only)")
    print(f"Installed {count} encrypted secrets.")
    cmd_verify(argparse.Namespace(manifest=str(MANIFEST)))


def mount_type(path):
    target = os.path.realpath(path)
    for line in Path("/proc/self/mountinfo").read_text().splitlines():
        left, right = line.split(" - ", 1)
        if left.split()[4] == target:
            return right.split()[0]
    return None


def expected_ids(item):
    uid = pwd.getpwnam(item["owner"]).pw_uid if item.get("owner") else int(item.get("uid") or 0)
    gid = grp.getgrnam(item["group"]).gr_gid if item.get("group") else int(item.get("gid") or 0)
    return uid, gid


def check_file(path, item, problems, template=False):
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        problems.append(f"{item['name']}: missing")
        return
    uid, gid = expected_ids(item)
    if not stat.S_ISREG(info.st_mode):
        problems.append(f"{item['name']}: not a regular file")
    elif (info.st_uid, info.st_gid) != (uid, gid):
        problems.append(f"{item['name']}: owner {info.st_uid}:{info.st_gid}, expected {uid}:{gid}")
    elif stat.S_IMODE(info.st_mode) != int(item["mode"], 8):
        problems.append(f"{item['name']}: mode {stat.S_IMODE(info.st_mode):04o}, expected {item['mode']}")
    elif info.st_size == 0:
        problems.append(f"{item['name']}: empty")
    elif template and b"<SOPS:" in Path(path).read_bytes():
        problems.append(f"{item['name']}: placeholder left unrendered")


def cmd_verify(args):
    require_root()
    manifest = json.loads(Path(args.manifest).read_text())
    problems = []
    generation = os.path.realpath(SECRETS_ROOT)
    if not SECRETS_ROOT.is_symlink() or os.path.dirname(generation) != os.path.realpath(MOUNT_ROOT):
        problems.append("/run/secrets: not a link to a secrets generation")
    kind = mount_type(MOUNT_ROOT)
    if kind not in ("ramfs",):
        problems.append(f"/run/secrets.d: mounted as {kind}, expected ramfs")
    for item in manifest.get("secrets") or []:
        check_file(Path(generation) / item["name"], item, problems)
        if item["path"] != f"/run/secrets/{item['name']}" and os.path.realpath(item["path"]) != os.path.join(generation, item["name"]):
            problems.append(f"{item['name']}: {item['path']} does not resolve to the current generation")
    for item in manifest.get("templates") or []:
        check_file(Path(generation) / "rendered" / item["name"], item, problems, template=True)
        if item["path"] != f"/run/secrets/rendered/{item['name']}" and \
                os.path.realpath(item["path"]) != os.path.join(generation, "rendered", item["name"]):
            problems.append(f"{item['name']}: {item['path']} does not resolve to the current generation")
    for problem in problems:
        print("FAIL " + problem)
    if problems:
        raise Refused(f"verify: {len(problems)} problem(s)")
    print(f"terrace-secrets verify: PASS {len(manifest.get('secrets') or [])} secrets, "
          f"{len(manifest.get('templates') or [])} templates, root-only modes, ramfs.")


def parser():
    top = argparse.ArgumentParser(prog="terrace-secrets", description=__doc__.splitlines()[0])
    sub = top.add_subparsers(dest="command", required=True)
    escrow = sub.add_parser("escrow").add_subparsers(dest="action", required=True).add_parser("create")
    escrow.add_argument("out")
    escrow.set_defaults(func=cmd_escrow_create)
    host = sub.add_parser("host").add_subparsers(dest="action", required=True).add_parser("create")
    host.add_argument("host")
    host.add_argument("--role", required=True)
    host.add_argument("--feature", action="append", choices=["secondary-backup"])
    host.add_argument("--stage", required=True)
    host.add_argument("--replace", action="store_true")
    host.set_defaults(func=cmd_host_create)
    for name, func in [("generate", cmd_generate), ("rekey", cmd_rekey)]:
        command = sub.add_parser(name)
        command.add_argument("host")
        command.set_defaults(func=func)
    for name, func in [("set", cmd_set), ("rotate", cmd_rotate), ("public", cmd_public)]:
        command = sub.add_parser(name)
        command.add_argument("host")
        command.add_argument("name")
        command.add_argument("--rehearsal", action="store_true", help=argparse.SUPPRESS)
        command.set_defaults(func=func)
    check = sub.add_parser("check")
    check.add_argument("host")
    check.add_argument("--rehearsal", action="store_true", help="also accept rehearsal/* entries")
    check.set_defaults(func=cmd_check)
    push = sub.add_parser("push")
    push.add_argument("host")
    push.add_argument("--address", required=True)
    push.add_argument("--user", default="operator")
    push.add_argument("--port", type=int, default=22)
    push.add_argument("--identity")
    push.add_argument("--rehearsal", action="store_true", help=argparse.SUPPRESS)
    push.set_defaults(func=cmd_push)
    install = sub.add_parser("install", help="host: read ciphertext on stdin, install it and verify")
    install.set_defaults(func=cmd_install)
    verify = sub.add_parser("verify", help="host: check every expected secret without reading values")
    verify.add_argument("--manifest", default=str(MANIFEST))
    verify.set_defaults(func=cmd_verify)
    return top


def main(argv=None):
    args = parser().parse_args(argv)
    try:
        args.func(args)
    except Refused as error:
        print(f"terrace-secrets: {error}", file=sys.stderr)
        return 1
    except (OSError, ValueError, KeyError) as error:
        # Never echo the exception text: a parser error can quote input bytes.
        print(f"terrace-secrets: {type(error).__name__} during {args.command}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
