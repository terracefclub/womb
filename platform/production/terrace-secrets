from pathlib import Path

HOST_RE = re.compile(r"^[a-z][a-z0-9-]{0,30}$")
NAME_RE = re.compile(r"^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*){1,3}$")
ENCRYPTED_RE = re.compile(r"^ENC\[AES256_GCM,data:[A-Za-z0-9+/=]*,iv:[A-Za-z0-9+/=]+,tag:[A-Za-z0-9+/=]+,type:[a-z]+\]$")
AGE_RECIPIENT_RE = re.compile(r"^age1[02-9ac-hj-np-z]{58}$")
SSH_ED25519_RE = re.compile(r"^ssh-ed25519 [A-Za-z0-9+/]{68}(?: [^\n]*)?$")
USER_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
ADDRESS_RE = re.compile(r"^(?:[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(?:\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*|[0-9.]{7,15}|[0-9a-f:]{2,39})$")
OTHER_KEY_TYPES = ("pgp", "kms", "gcp_kms", "azure_kv", "hc_vault", "hckms", "key_groups")
MAX_VALUE = 64 * 1024
MAX_FILE = 1024 * 1024
HOST_FILE = Path("/var/lib/terrace-secrets/secrets.sops.json")
REPLACEMENT_MARKER = Path("/var/lib/terrace-secrets/replacement")
ADOPTED_MARKER = Path("/var/lib/terrace-production/adopted")
HOST_KEY = Path("/etc/ssh/ssh_host_ed25519_key")
HOST_CONFIG = Path("/etc/terrace")
MANIFEST = HOST_CONFIG / "secrets-manifest.json"
SECRETS_ROOT = Path("/run/secrets")
MOUNT_ROOT = Path("/run/secrets.d")
REHEARSAL_PREFIX = "rehearsal/"
# Where `apply` hands an escrow-only value to the identity administration tool (tmpfs, root-only).
IDENTITY_HANDOFF = Path("/run/terrace-identity-admin")

PEM_BLOCK = re.compile(r"-----BEGIN ([A-Z ]+)-----\n((?:[A-Za-z0-9+/]+=*\n)+)-----END \1-----\n")


def pem_blocks(value):
    """[(label, der)] when VALUE is nothing but well-formed PEM blocks, else None."""
    blocks, position = [], 0
    for match in PEM_BLOCK.finditer(value):
        if match.start() != position:
            return None
        try:
            der = base64.b64decode(match.group(2).replace("\n", ""), validate=True)
        except (binascii.Error, ValueError):
            return None
        blocks.append((match.group(1), der))
        position = match.end()
    return blocks if blocks and position == len(value) else None


def der_sequence(der):
    """A minimal structural parse: one DER SEQUENCE spanning exactly the whole value."""
    if len(der) < 2 or der[0] != 0x30:
        return False
    length, offset = der[1], 2
    if length & 0x80:
        count = length & 0x7F
        if count == 0 or count > 4 or len(der) < 2 + count:
            return False
        length, offset = int.from_bytes(der[2:2 + count], "big"), 2 + count
    return offset + length == len(der)


def private_key(value):
    blocks = pem_blocks(value)
    return bool(blocks) and len(blocks) == 1 and blocks[0][0] in ("PRIVATE KEY", "RSA PRIVATE KEY", "EC PRIVATE KEY") \
        and der_sequence(blocks[0][1])


def certificates(value):
    blocks = pem_blocks(value)
    return bool(blocks) and all(label == "CERTIFICATE" and der_sequence(der) for label, der in blocks)


TLS_PAIR = ("tls/certificate", "tls/key")


def tls_pair_problem(certificate, key):
    """None when the first certificate's public key is the private key's, else a fixed reason (no value in it).

    OpenSSL reads both on stdin: the key never becomes an argument. Format checks alone (above) accept any
    certificate with any key, and nginx would restart on a mismatched pair and serve no HTTPS at all.
    """
    try:
        from_certificate = run(["openssl", "x509", "-noout", "-pubkey"], stdin=certificate.encode()).stdout
        from_key = run(["openssl", "pkey", "-pubout"], stdin=key.encode(), values=[key]).stdout
    except Refused:
        return "OpenSSL cannot read the certificate or the key"
    if not from_certificate.strip() or from_certificate != from_key:
        return "the certificate's public key is not the key's"
    return None


def openssh_key(value):
    blocks = pem_blocks(value)
    return bool(blocks) and len(blocks) == 1 and blocks[0][0] == "OPENSSH PRIVATE KEY" \
        and blocks[0][1].startswith(b"openssh-key-v1\0")


def full(pattern):
    compiled = re.compile(pattern)
    return lambda value: compiled.fullmatch(value) is not None


# Every value has an exact alphabet (full-match: no trailing newline slips through).
# Single-line values never contain whitespace, quotes, backslashes, `$` or control
# characters, so they are safe in env files, JSON and SQL.
FORMATS = {
    "hex64": full(r"[0-9a-f]{64}"),
    "pem-certificate": certificates,
    "pem-private-key": private_key,
    "openssh-private-key": openssh_key,
    "env-s3": full(r"AWS_ACCESS_KEY_ID=[A-Za-z0-9]{8,128}\nAWS_SECRET_ACCESS_KEY=[A-Za-z0-9/+=_-]{16,128}\n"),
}


class Refused(Exception):
    """A fixed, value-free message for the operator."""


def inventory():
    path = os.environ.get("TERRACE_SECRETS_INVENTORY") or str(Path(__file__).resolve().with_name("inventory.json"))
    data = json.loads(Path(path).read_text())
    entries = {entry["name"]: entry for entry in data["secrets"]}
    for name, entry in entries.items():
        if not NAME_RE.match(name) or entry["generator"] not in ("hex32", "ssh-ed25519", "external") \
                or entry["rotation"] not in ("rotate", "manual", "set") or not entry["roles"] \
                or entry["format"] not in FORMATS or not entry.get("consequence"):
            raise Refused("inventory.json is malformed")
    return entries


def expected(entries, role, features, delivered_only=False):
    return sorted(name for name, entry in entries.items()
                  if role in entry["roles"]
                  and (entry["feature"] == "core" or entry["feature"] in features)
                  and entry.get("omittedBy") not in features
                  and (entry["delivered"] or not delivered_only))


def validate_users(value):
    try:
        users = json.loads(value)
    except ValueError:
        return False
    return isinstance(users, list) and 0 < len(users) <= 16 and all(
        isinstance(user, dict) and set(user) == {"username", "roles", "email", "password"}
        and isinstance(user["username"], str) and re.fullmatch(r"[a-z][a-z0-9-]{0,40}", user["username"])
        and isinstance(user["roles"], list) and all(isinstance(r, str) and re.fullmatch(r"[a-z-]{1,40}", r) for r in user["roles"])
        and isinstance(user["email"], str) and re.fullmatch(r"[a-z0-9.-]+@[a-z0-9.-]+", user["email"])
        and isinstance(user["password"], str) and FORMATS["hex64"](user["password"]) for user in users)


def validate(entries, name, value):
    """Refuse a value outside its declared format (the value is never echoed)."""
    if not isinstance(value, str):
        raise Refused(f"{name}: not a string value")
    if name.startswith(REHEARSAL_PREFIX):
        ok = name == "rehearsal/users-json" and validate_users(value)
        kind = "users-json"
    else:
        if name not in entries:
            raise Refused(f"{name}: not in the inventory")
        kind = entries[name]["format"]
        ok = FORMATS[kind](value)
    if not ok:
        raise Refused(f"{name}: value does not match its format ({kind})")


def nested_set(tree, name, value):
    parts = name.split("/")
    for part in parts[:-1]:
        tree = tree.setdefault(part, {})
        if not isinstance(tree, dict):
            raise Refused(f"{name}: path collides with a value")
    tree[parts[-1]] = value


def leaves(tree, prefix=""):
    """Yield (name, value) for every leaf, skipping the sops metadata."""
    for key, value in tree.items():
        if not prefix and key == "sops":
            continue
        name = prefix + key
        if isinstance(value, dict):
            yield from leaves(value, name + "/")
        else:
            yield name, value


def guard_argv(argv, values):
    """Refuse any command line that would carry a secret value."""
    for value in values:
        if value and any(value in part for part in argv):
            raise Refused("refused to pass a secret value as a command argument")


# ---- private scratch and subprocesses -------------------------------------

def memory_filesystem(path):
    """True when PATH is on tmpfs or ramfs (Linux mountinfo)."""
    try:
        mounts = Path("/proc/self/mountinfo").read_text().splitlines()
    except OSError:
        return False
    target = os.path.realpath(path)
    best, kind = "", None
    for line in mounts:
        left, right = line.split(" - ", 1)
        point = left.split()[4].replace("\\040", " ")
        if (target == point or target.startswith(point.rstrip("/") + "/")) and len(point) >= len(best):
            best, kind = point, right.split()[0]
    return kind in ("tmpfs", "ramfs")


def scratch_root():
    root = os.environ.get("TERRACE_SECRETS_SCRATCH") or os.environ.get("XDG_RUNTIME_DIR") or "/dev/shm"
    # Linux proves the filesystem type; elsewhere (a macOS RAM disk) the operator must state it.
    declared = sys.platform != "linux" and os.environ.get("TERRACE_SECRETS_SCRATCH_IS_RAMDISK") == "1" \
        and bool(os.environ.get("TERRACE_SECRETS_SCRATCH"))
    if not os.path.isdir(root) or not (memory_filesystem(root) or declared):
        raise Refused("scratch directory is not on tmpfs or ramfs; set TERRACE_SECRETS_SCRATCH to a memory filesystem")
    return root


class Scratch:
    """A private directory on tmpfs/ramfs, removed on exit."""

    def __enter__(self):
        self.path = Path(tempfile.mkdtemp(prefix="terrace-secrets-", dir=scratch_root()))
        os.chmod(self.path, 0o700)
        return self.path

    def __exit__(self, *_exc):
        shutil.rmtree(self.path, ignore_errors=True)


def run(argv, stdin=b"", values=(), env_extra=None, check=True):
    guard_argv(argv, values)
    with tempfile.TemporaryDirectory(prefix="terrace-secrets-home-") as home:
        env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": home, "XDG_CONFIG_HOME": home,
               "LC_ALL": "C.UTF-8"}
        if os.environ.get("SOPS_AGE_KEY_FILE"):
            env["SOPS_AGE_KEY_FILE"] = os.environ["SOPS_AGE_KEY_FILE"]
        env.update(env_extra or {})
        result = subprocess.run(argv, input=stdin, capture_output=True, env=env, cwd=home)
    if check and result.returncode != 0:
        # sops/age/ssh errors never contain values, but keep the output fixed anyway.
        raise Refused(f"{Path(argv[0]).name} {argv[1] if len(argv) > 1 else ''} failed (exit {result.returncode})")
    return result


def recipient_of_ssh_public(public_line):
    return run(["ssh-to-age"], stdin=public_line.encode()).stdout.decode().strip()


def private_identity_file():
    path = os.environ.get("SOPS_AGE_KEY_FILE")
    if not path:
        raise Refused("set SOPS_AGE_KEY_FILE to the escrow (or an operator) age identity")
    info = os.stat(path)
    if info.st_mode & 0o077 or info.st_uid != os.getuid():
        raise Refused("SOPS_AGE_KEY_FILE must be owned by you and not accessible by group or others")
    return path


# ---- store -----------------------------------------------------------------

def store():
    root = os.environ.get("TERRACE_SECRETS_STORE")
    if not root:
        raise Refused("set TERRACE_SECRETS_STORE to the private secrets store directory")
    path = Path(root)
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    if path.stat().st_mode & 0o077:
        raise Refused("the secrets store directory must not be accessible by group or others")
    return path


@contextlib.contextmanager
def store_lock(replacing=False):
    """One mutating operator at a time per store; nothing else while an escrow replacement is unfinished."""
    if not replacing and (store() / "escrow-replace.pending").exists():
        raise Refused("an escrow replacement is unfinished; run `escrow replace` again with the same new key file first")
    fd = os.open(store() / ".lock", os.O_RDWR | os.O_CREAT, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Refused("another terrace-secrets command holds the store lock")
        yield
    finally:
        os.close(fd)


def host_dir(name, create=False):
    if not HOST_RE.match(name):
        raise Refused("host names are lowercase letters, digits and dashes")
    path = store() / "hosts" / name
    if create:
        path.mkdir(mode=0o700, parents=True, exist_ok=True)
    elif not path.is_dir():
        raise Refused(f"unknown host {name}; run `host create` first")
    return path


def read_text(path):
    return Path(path).read_text().strip()


def write_new(path, data, mode=0o600, replace=False):
    """Atomic write through a unique temporary file in the same directory."""
    path = Path(path)
    if path.exists() and not replace:
        raise Refused(f"{path.name} already exists")
    fd, tmp = tempfile.mkstemp(prefix="." + path.name + ".", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        os.write(fd, data)
        os.fsync(fd)
        os.close(fd)
        fd = None
        os.replace(tmp, path)
    finally:
        if fd is not None:
            os.close(fd)
        if os.path.exists(tmp):
            os.unlink(tmp)


def host_info(name):
    directory = host_dir(name)
    role = read_text(directory / "role")
    features = [f for f in read_text(directory / "features").split(",") if f] if (directory / "features").exists() else []
    return directory, role, features


def escrow_recipient():
    escrow = read_text(store() / "escrow.recipient")
    if not AGE_RECIPIENT_RE.match(escrow):
        raise Refused("the stored escrow recipient is not an age X25519 recipient")
    return escrow


def pinned_escrow():
    """The escrow recipient pinned in the deployment's host parameters, not read from the store."""
    if (store() / "escrow-replace.pending").exists():
        raise Refused("an escrow replacement is unfinished; run `escrow replace` again with the same new key file first")
    pinned = os.environ.get("TERRACE_ESCROW_RECIPIENT", "")
    if not AGE_RECIPIENT_RE.match(pinned):
        raise Refused("set TERRACE_ESCROW_RECIPIENT to the escrow recipient pinned in the host parameters")
    if pinned != escrow_recipient():
        raise Refused("the store's escrow recipient differs from the pinned one; the store may have been altered")
    return pinned


def recipients(name, allow_pending=False):
    directory = host_dir(name)
    if (directory / "pending-rekey").exists() and not allow_pending:
        raise Refused(f"{name} has a new host key that is not yet applied; run `rekey {name}`")
    escrow = escrow_recipient()
    host = read_text(directory / "recipient")
    if not AGE_RECIPIENT_RE.match(host):
        raise Refused("a stored recipient is not an age X25519 recipient")
    if escrow == host:
        raise Refused("the host and escrow recipients must differ")
    return [host, escrow]


def recipient_problems(document, wanted):
    """Exactly the wanted age recipients and no other kind of sops key."""
    metadata = document.get("sops") if isinstance(document, dict) else None
    if not isinstance(metadata, dict):
        return ["not a sops file"]
    problems = [f"sops {kind} keys are not allowed" for kind in OTHER_KEY_TYPES if metadata.get(kind)]
    stored = sorted(item.get("recipient", "") for item in metadata.get("age") or [] if isinstance(item, dict))
    if stored != sorted(wanted):
        problems.append("recipients differ from exactly this host and the pinned escrow")
    return problems


def encrypt(name, tree, recipient_list, entries):
    for leaf, value in leaves(tree):
        validate(entries, leaf, value)
    plaintext = json.dumps(tree, indent=1, sort_keys=True).encode()
    values = [value for _, value in leaves(tree)]
    out = run(["sops", "encrypt", "--age", ",".join(recipient_list), "--input-type", "json", "--output-type", "json",
               "--filename-override", "secrets.sops.json"], stdin=plaintext, values=values).stdout
    write_new(host_dir(name) / "secrets.sops.json", out, replace=True)


def decrypt_file(path, env_extra=None):
    out = run(["sops", "decrypt", "--input-type", "json", "--output-type", "json", str(path)], env_extra=env_extra).stdout
    return json.loads(out)


def decrypt(name):
    private_identity_file()
    return decrypt_file(host_dir(name) / "secrets.sops.json")


def generate_value(entry, name, host_directory):
    if entry["generator"] == "hex32":
        return token.token_hex(32)
    if entry["generator"] == "ssh-ed25519":
        with Scratch() as scratch:
            key = scratch / "key"
            run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", f"terrace-{name.replace('/', '-')}", "-f", str(key)])
            private = key.read_text()
            public = (scratch / "key.pub").read_text()
        public_dir = host_directory / "public"
        public_dir.mkdir(mode=0o700, exist_ok=True)
        write_new(public_dir / (name.replace("/", "--") + ".pub"), public.encode(), mode=0o644, replace=True)
        return private
    raise Refused(f"{name} is supplied externally; use `set`")


# ---- operator commands -----------------------------------------------------

def new_age_identity(out):
    identity = run(["age-keygen"]).stdout
    public = run(["age-keygen", "-y"], stdin=identity).stdout.decode().strip()
    if not AGE_RECIPIENT_RE.match(public):
        raise Refused("age-keygen returned an unexpected recipient")
    write_new(out, identity, mode=0o600)
    return public


def cmd_escrow_create(args):
    root = store()
    with store_lock():
        if (root / "escrow.recipient").exists():
            raise Refused("this store already has an escrow recipient; use `escrow replace`")
        if Path(args.out).exists():
            raise Refused("the escrow output file already exists")
        public = new_age_identity(args.out)
        write_new(root / "escrow.recipient", (public + "\n").encode(), mode=0o644)
    print(f"Escrow recipient {public}. Pin it as terrace.production.escrowRecipient; keep the identity offline.")


def stage_escrow_replacement(hosts, public, entries):
    for host in hosts:
        current = host_dir(host) / "secrets.sops.json"
        if recipient_problems(json.loads(current.read_text()), [recipients(host, allow_pending=True)[0], public]) == []:
            continue  # converted by an earlier run
        tree = decrypt(host)
        for name, value in leaves(tree):
            validate(entries, name, value)
        values = [value for _, value in leaves(tree)]
        out = run(["sops", "encrypt", "--age", f"{recipients(host, allow_pending=True)[0]},{public}", "--input-type", "json",
                   "--output-type", "json", "--filename-override", "secrets.sops.json"],
                  stdin=json.dumps(tree, indent=1, sort_keys=True).encode(), values=values).stdout
        write_new(current.with_name("secrets.sops.json.next"), out, replace=True)


def cmd_escrow_replace(args):
    """Re-encrypt every host to a new escrow key; resumable, and the store switches last."""
    entries = inventory()
    root = store()
    private_identity_file()
    with store_lock(replacing=True):
        pending = root / "escrow-replace.pending"
        if pending.exists():
            public = read_text(pending)
            if not Path(args.out).exists() or run(["age-keygen", "-y"], stdin=Path(args.out).read_bytes()).stdout.decode().strip() != public:
                raise Refused("a replacement is in progress for a different new escrow key; give its identity file")
        else:
            if Path(args.out).exists():
                raise Refused("the new escrow output file already exists")
            public = new_age_identity(args.out)
            write_new(pending, (public + "\n").encode(), mode=0o600)
        old = escrow_recipient()
        if public == old:
            raise Refused("the new escrow recipient equals the old one")
        hosts = sorted(path.name for path in (root / "hosts").iterdir() if (path / "secrets.sops.json").exists()) \
            if (root / "hosts").is_dir() else []
        try:
            stage_escrow_replacement(hosts, public, entries)
        except BaseException:
            # An aborted run leaves no half-written files; the pending marker makes the next run resume.
            for host in hosts:
                staged = host_dir(host) / "secrets.sops.json.next"
                if staged.exists():
                    staged.unlink()
            raise
        # Every new file exists before any old one is replaced, and the recipient switches last.
        for host in hosts:
            following = host_dir(host) / "secrets.sops.json.next"
            if following.exists():
                os.replace(following, following.with_name("secrets.sops.json"))
        retired = root / "retired-escrow"
        retired.mkdir(mode=0o700, exist_ok=True)
        write_new(retired / f"{len(list(retired.iterdir())) + 1}.recipient", (old + "\n").encode(), mode=0o644)
        write_new(root / "escrow.recipient", (public + "\n").encode(), mode=0o644, replace=True)
        pending.unlink()
    print(f"New escrow recipient {public}; {len(hosts)} host file(s) re-encrypted. Update terrace.production.escrowRecipient,"
          " deploy each host and push to it straight away (until the push, a reboot keeps it gated)."
          " If the old escrow leaked, rotate every secret as well.")


def default_stage(host):
    return os.path.join(scratch_root(), f"terrace-stage-{host}")


def cmd_host_create(args):
    entries = inventory()
    if args.role not in {role for entry in entries.values() for role in entry["roles"]}:
        raise Refused("unknown role")
    stage = Path(args.stage or default_stage(args.host)).resolve()
    if str(stage).startswith(str(store().resolve()) + os.sep) or stage == store().resolve():
        raise Refused("never stage a host private key inside the secrets store")
    if stage.exists():
        raise Refused("the staging directory must not exist yet")
    with store_lock():
        existing = (store() / "hosts" / args.host / "recipient").exists()
        if existing and not args.replace:
            raise Refused(f"{args.host} already has a host key; use --replace for a replacement host")
        if args.replace and not existing:
            raise Refused(f"{args.host} has no host key to replace")
        directory = host_dir(args.host, create=True)
        if existing and read_text(directory / "role") != args.role:
            raise Refused("a replacement keeps its role")
        stage.mkdir(mode=0o700, parents=True)
        key = stage / "ssh_host_ed25519_key"
        run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", f"root@{args.host}", "-f", str(key)])
        os.chmod(key, 0o600)
        public = (stage / "ssh_host_ed25519_key.pub").read_text().strip()
        if not SSH_ED25519_RE.match(public):
            raise Refused("ssh-keygen returned an unexpected public key")
        recipient = recipient_of_ssh_public(public)
        if not AGE_RECIPIENT_RE.match(recipient):
            raise Refused("ssh-to-age returned an unexpected recipient")
        if existing:
            retired = directory / "retired"
            retired.mkdir(mode=0o700, exist_ok=True)
            serial = len(list(retired.glob("*.recipient"))) + 1
            shutil.copy2(directory / "recipient", retired / f"{serial}.recipient")
            shutil.copy2(directory / "ssh_host_ed25519_key.pub", retired / f"{serial}.pub")
            write_new(directory / "pending-rekey", f"{serial}\n".encode(), replace=True)
        write_new(directory / "role", (args.role + "\n").encode(), mode=0o644, replace=True)
        write_new(directory / "features", (",".join(sorted(set(args.feature or []))) + "\n").encode(), mode=0o644, replace=True)
        write_new(directory / "ssh_host_ed25519_key.pub", (public + "\n").encode(), mode=0o644, replace=True)
        write_new(directory / "recipient", (recipient + "\n").encode(), mode=0o644, replace=True)
    warning = "" if memory_filesystem(stage) else " WARNING: the staging directory is not memory-backed."
    print(f"Host {args.host}: {public.split()[0]} key staged in {stage}; age recipient {recipient}."
          + (" Run `rekey` before pushing." if existing else "") + " Run `host unstage` once the host verified." + warning)


def cmd_host_reset_replacement(args):
    """Forget that a host was a replacement (for a host wiped and redeployed as a NEW deployment)."""
    if args.confirm != args.host:
        raise Refused("repeat the host name with --confirm to clear its replacement marker")
    with store_lock():
        marker = host_dir(args.host) / "replacement"
        if not marker.exists():
            raise Refused(f"{args.host} has no replacement marker")
        marker.unlink()
    print(f"Cleared {args.host}'s replacement marker. The host also refuses adopt --new while its own marker"
          " (/var/lib/terrace-secrets/replacement) exists or its repository holds snapshots.")


def cmd_host_unstage(args):
    stage = Path(args.stage or default_stage(args.host))
    key = stage / "ssh_host_ed25519_key"
    if not key.exists():
        raise Refused("no staged host key there")
    size = key.stat().st_size
    with open(key, "r+b") as handle:
        handle.write(b"\0" * size)
        handle.flush()
        os.fsync(handle.fileno())
    shutil.rmtree(stage)
    print(f"Removed the staged host key for {args.host}.")


def cmd_generate(args):
    entries = inventory()
    with store_lock():
        directory, role, features = host_info(args.host)
        if (directory / "secrets.sops.json").exists():
            raise Refused(f"{args.host} already has secrets; use `rotate` or `set`")
        tree = {}
        count = 0
        for name in expected(entries, role, features):
            entry = entries[name]
            if entry["generator"] == "external":
                continue
            nested_set(tree, name, generate_value(entry, name, directory))
            count += 1
        encrypt(args.host, tree, recipients(args.host), entries)
    external = [name for name in expected(entries, role, features) if entries[name]["generator"] == "external"]
    print(f"Generated {count} secrets for {args.host}. Supply with `set`: {', '.join(external) or 'none'}.")


def read_value():
    data = sys.stdin.buffer.read(MAX_VALUE + 1)
    if len(data) > MAX_VALUE or not data:
        raise Refused("a value must be 1 byte to 64 KiB on stdin")
    text = data.decode("utf-8")
    if "\n" not in text.rstrip("\n"):
        text = text.rstrip("\n")
    return text


def allowed_name(entries, role, features, name, rehearsal, tolerate_omitted=False):
    if name.startswith(REHEARSAL_PREFIX) and rehearsal and NAME_RE.match(name):
        return True
    if tolerate_omitted and name in entries and role in entries[name]["roles"] and entries[name].get("omittedBy") in features:
        # A host switching TLS mode (docs/tls.md) may still receive tls/*; its sops-nix ignores them.
        return True
    return name in expected(entries, role, features)


def nested_delete(tree, name):
    parts = name.split("/")
    path = [tree]
    for part in parts[:-1]:
        path.append(path[-1][part])
    del path[-1][parts[-1]]
    for depth in range(len(parts) - 1, 0, -1):
        if not path[depth]:
            del path[depth - 1][parts[depth - 1]]


def cmd_host_tls(args):
    """Record how a host gets its certificate; ACME hosts keep no tls/* in the store."""
    entries = inventory()
    with store_lock():
        directory, role, features = host_info(args.host)
        wanted = sorted((set(features) | {"acme-tls"}) if args.mode == "acme" else (set(features) - {"acme-tls"}))
        removed = []
        if args.mode == "acme" and (directory / "secrets.sops.json").exists():
            present = {name for name, _ in leaves(json.loads((directory / "secrets.sops.json").read_text()))}
            removed = sorted(name for name, entry in entries.items() if entry.get("omittedBy") == "acme-tls" and name in present)
            if removed and not args.yes:
                # The store may hold the operator's only copy of the manual key: never drop it silently.
                raise Refused(f"{args.host}: this removes {', '.join(removed)} from the store (the manual certificate and key)."
                              " Run it only after `terrace-tls status` on the host shows an ACME-issued certificate,"
                              " keep your own copy if you may fall back, then repeat with --yes")
            if removed:
                tree = decrypt(args.host)
                for name in removed:
                    nested_delete(tree, name)
                encrypt(args.host, tree, recipients(args.host), entries)
        write_new(directory / "features", (",".join(wanted) + "\n").encode(), mode=0o644, replace=True)
    if args.mode == "acme":
        print(f"{args.host}: certificate by ACME; removed from the store: {', '.join(removed) or 'nothing'}."
              " Deploy the ACME configuration first, then push.")
    else:
        print(f"{args.host}: certificate delivered by the operator. Supply tls/certificate and tls/key with `set`,"
              " push, then deploy the manual configuration.")


def cmd_set(args):
    entries = inventory()
    with store_lock():
        _, role, features = host_info(args.host)
        if not allowed_name(entries, role, features, args.name, args.rehearsal):
            raise Refused(f"{args.name} is not a secret of this host")
        value = read_value()
        validate(entries, args.name, value)
        tree = decrypt(args.host)
        nested_set(tree, args.name, value)
        encrypt(args.host, tree, recipients(args.host), entries)
        values = dict(leaves(tree))
        problem = tls_pair_problem(values["tls/certificate"], values["tls/key"]) \
            if args.name in TLS_PAIR and all(name in values for name in TLS_PAIR) else None
    print(f"Set {args.name} on {args.host}. Run `push` to deliver it.")
    if problem:
        other = TLS_PAIR[1 - TLS_PAIR.index(args.name)]
        print(f"WARNING: tls/certificate and tls/key in the store do not belong together ({problem})."
              f" `push` is refused until they do: set the matching {other} next.")


def cmd_rotate(args):
    entries = inventory()
    with store_lock():
        directory, role, features = host_info(args.host)
        if args.name not in expected(entries, role, features):
            raise Refused(f"{args.name} is not a secret of this host")
        entry = entries[args.name]
        if entry["generator"] == "external" or (entry["rotation"] == "manual" and not args.manual):
            raise Refused(f"{args.name}: {entry['consequence']}")
        tree = decrypt(args.host)
        nested_set(tree, args.name, generate_value(entry, args.name, directory))
        encrypt(args.host, tree, recipients(args.host), entries)
    units = ", ".join(entry["restartUnits"]) or "none"
    print(f"Rotated {args.name} on {args.host}. `push` delivers it and restarts: {units}. {entry['consequence']}")


def cmd_rekey(args):
    entries = inventory()
    with store_lock():
        directory = host_dir(args.host)
        if not (directory / "pending-rekey").exists():
            raise Refused(f"{args.host} has no new host key to apply")
        tree = decrypt(args.host)
        encrypt(args.host, tree, recipients(args.host, allow_pending=True), entries)
        (directory / "pending-rekey").unlink()
        # Pushed with the ciphertext: the replacement may only be adopted as restored.
        write_new(directory / "replacement", b"replacement\n", replace=True)
    print(f"Re-encrypted {args.host} to its new host key and the escrow key; the retired key is no longer a recipient"
          " (it can still read any older ciphertext it saw: rotate if it may be compromised).")


def file_report(name):
    """Names and recipients of a stored file, without decrypting it."""
    entries = inventory()
    directory, role, features = host_info(name)
    path = directory / "secrets.sops.json"
    if not path.exists():
        raise Refused(f"{name} has no secrets yet; run `generate`")
    document = json.loads(path.read_text())
    present = {leaf: isinstance(value, str) and bool(ENCRYPTED_RE.match(value)) for leaf, value in leaves(document)}
    return entries, role, features, present, document, path


def cmd_check(args):
    entries, role, features, present, document, _ = file_report(args.host)
    problems = [f"missing {name}" for name in expected(entries, role, features) if name not in present]
    problems += [f"not encrypted {name}" for name, ok in present.items() if not ok]
    problems += [f"unexpected {name}" for name in present
                 if not allowed_name(entries, role, features, name, args.rehearsal)]
    problems += recipient_problems(document, [recipients(args.host)[0], pinned_escrow()])
    for problem in problems:
        print(problem)
    if problems:
        raise Refused(f"{args.host}: {len(problems)} problem(s)")
    print(f"{args.host}: {len(present)} secrets encrypted to exactly the host key and the pinned escrow key.")


def cmd_public(args):
    directory = host_dir(args.host)
    path = directory / "public" / (args.name.replace("/", "--") + ".pub")
    if not NAME_RE.match(args.name) or not path.exists():
        raise Refused("no stored public half for that secret")
    print(path.read_text().strip())


def pinned_ssh(args, remote, stdin):
    """Run REMOTE on the host over SSH pinned to the stored host key; returns (code, stdout)."""
    if not USER_RE.match(args.user) or not ADDRESS_RE.match(args.address) or not 1 <= args.port <= 65535:
        raise Refused("invalid --user, --address or --port")
    directory = host_dir(args.host)
    public = read_text(directory / "ssh_host_ed25519_key.pub").split()
    with tempfile.TemporaryDirectory(prefix="terrace-secrets-ssh-") as private:
        known = Path(private) / "known_hosts"
        known.write_text(f"{args.host} {public[0]} {public[1]}\n")
        argv = ["ssh", "-F", "/dev/null", "-o", f"HostKeyAlias={args.host}", "-o", f"UserKnownHostsFile={known}",
                "-o", "StrictHostKeyChecking=yes", "-o", "GlobalKnownHostsFile=/dev/null", "-o", "BatchMode=yes",
                "-o", "IdentitiesOnly=yes", "-p", str(args.port), "-l", args.user]
        if args.identity:
            argv += ["-i", os.path.abspath(args.identity)]
        argv += ["--", args.address, "/run/wrappers/bin/sudo", "-n", "/run/current-system/sw/bin/" + remote[0], *remote[1:]]
        env = {"SSH_AUTH_SOCK": os.environ["SSH_AUTH_SOCK"]} if os.environ.get("SSH_AUTH_SOCK") else {}
        result = run(argv, stdin=stdin, env_extra=env, check=False)
    return result.returncode, result.stdout.decode(errors="replace"), result.stderr.decode(errors="replace")


def report_remote(what, host, code, out, err):
    sys.stdout.write(out)
    if code != 0:
        fixed = [line for line in err.splitlines() if line.startswith(("terrace-secrets:", "terrace-production:", "Host key verification failed", "Permission denied"))]
        raise Refused(f"{what} to {host} failed (exit {code})" + (f": {fixed[-1]}" if fixed else ""))


def cmd_push(args):
    cmd_check(argparse.Namespace(host=args.host, rehearsal=args.rehearsal))
    directory = host_dir(args.host)
    ciphertext = (directory / "secrets.sops.json").read_bytes()
    marker = directory / "replacement"
    remote = ["terrace-secrets", "install"] + (["--replacement"] if marker.exists() else [])
    code, out, err = pinned_ssh(args, remote, ciphertext)
    report_remote("push", args.host, code, out, err)
    if marker.exists() and "Host state: adopted" in out.splitlines():
        # The replacement was restored and adopted; from now on it is an ordinary host.
        marker.unlink()
        print(f"{args.host} is adopted: its replacement marker is cleared.")


def cmd_apply(args):
    """Hand a manual secret to the service that keeps its own copy, over the pinned channel."""
    entries = inventory()
    entry = entries.get(args.name)
    if not entry or "apply" not in entry:
        raise Refused(f"{args.name} has no on-host apply action; follow docs/secrets.md")
    stdin = b""
    if entry["apply"] == "identity-handoff" and args.finish:
        raise Refused("the identity handoff has no finish step")
    if entry["apply"] in ("restic-password", "identity-handoff"):
        # identity-handoff: the escrowed value goes once, over the pinned channel, to the host's
        # identity administration tool (never declared on the host, so never in /run/secrets).
        # restic-password: the NEW value goes before `push`, because the host still needs the old one to open the
        # repository; with --finish it goes again, so the host can refuse unless its delivered file already holds it.
        value = dict(leaves(decrypt(args.host)))[args.name]
        validate(entries, args.name, value)
        stdin = value.encode()
    remote = ["terrace-secrets", "host-apply", args.name] + (["--finish"] if args.finish else []) \
        + (["--only-current"] if args.only_current else []) + [item for key in args.keep or [] for item in ("--keep", key)] \
        + [item for key in args.remove or [] for item in ("--remove", key)]
    report_remote("apply", args.host, *pinned_ssh(args, remote, stdin))


# ---- host commands ---------------------------------------------------------

def require_root():
    if os.geteuid() != 0:
        raise Refused("run as root on the host")


def host_setting(name):
    return read_text(HOST_CONFIG / name)


def host_identity_env():
    """The host's age identity, derived from its ed25519 key in memory, as sops environment."""
    identity = run(["ssh-to-age", "-private-key", "-i", str(HOST_KEY)]).stdout.decode().strip()
    return {"SOPS_AGE_KEY": identity}


def validate_ciphertext(data, own_recipient, pinned, entries=None, role=None, features=(), rehearsal=False):
    try:
        document = json.loads(data)
    except ValueError:
        raise Refused("input is not a sops JSON file")
    if not isinstance(document, dict) or not isinstance(document.get("sops"), dict):
        raise Refused("input is not a sops JSON file")
    names = list(leaves(document))
    if not names or any(not (isinstance(v, str) and ENCRYPTED_RE.match(v)) for _, v in names):
        raise Refused("input contains a value that is not encrypted; refusing to store plaintext")
    problems = recipient_problems(document, [own_recipient, pinned])
    if problems:
        raise Refused("input refused: " + "; ".join(problems))
    if entries is not None:
        unexpected = [name for name, _ in names if not allowed_name(entries, role, features, name, rehearsal, tolerate_omitted=True)]
        if unexpected:
            raise Refused("input carries names this host does not take: " + ", ".join(sorted(unexpected)))
    return len(names)


def host_context():
    entries = inventory()
    role = host_setting("role")
    features = [f for f in host_setting("features").split(",") if f]
    rehearsal = host_setting("instance") == "rehearsal"
    pinned = host_setting("escrow-recipient")
    own = recipient_of_ssh_public(Path(str(HOST_KEY) + ".pub").read_text().strip())
    return entries, role, features, rehearsal, pinned, own


def cmd_install(args):
    require_root()
    data = sys.stdin.buffer.read(MAX_FILE + 1)
    if len(data) > MAX_FILE:
        raise Refused("input too large")
    entries, role, features, rehearsal, pinned, own = host_context()
    count = validate_ciphertext(data, own, pinned, entries, role, features, rehearsal)
    # Decrypt in memory and check every value's format before anything consumes it.
    HOST_FILE.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=HOST_FILE.parent, prefix=".incoming.", delete=True) as incoming:
        incoming.write(data)
        incoming.flush()
        values = dict(leaves(decrypt_file(incoming.name, host_identity_env())))
        for name, value in values.items():
            validate(entries, name, value)
    # A host that serves the delivered certificate refuses a pair that does not belong together, before nginx restarts.
    if all(name in values and name in expected(entries, role, features) for name in TLS_PAIR):
        problem = tls_pair_problem(values["tls/certificate"], values["tls/key"])
        if problem:
            raise Refused(f"tls/certificate and tls/key do not belong together ({problem}); nothing installed, nginx not restarted")
    previous = HOST_FILE.with_name(HOST_FILE.name + ".previous")
    if HOST_FILE.exists():
        shutil.copy2(HOST_FILE, previous)
    write_new(HOST_FILE, data, mode=0o600, replace=True)
    adopted = ADOPTED_MARKER.exists()
    if args.replacement and not adopted:
        # Came over the channel pinned to this host's key: `adopt --new` refuses from now on.
        write_new(REPLACEMENT_MARKER, b"replacement\n", mode=0o600, replace=True)
    try:
        if subprocess.run(["systemctl", "restart", "sops-install-secrets.service"], capture_output=True).returncode != 0:
            raise Refused("sops-install-secrets failed; check `journalctl -u sops-install-secrets` (names only)")
        cmd_verify(argparse.Namespace(manifest=str(MANIFEST)))
    except BaseException:
        if previous.exists():
            os.replace(previous, HOST_FILE)
            subprocess.run(["systemctl", "restart", "sops-install-secrets.service"], capture_output=True)
            print("Restored the previous ciphertext.", file=sys.stderr)
        raise
    if previous.exists():
        previous.unlink()
    print(f"Installed {count} encrypted secrets.")
    print("Host state: adopted" if adopted else "Host state: not adopted")


def mount_type(path):
    target = os.path.realpath(path)
    for line in Path("/proc/self/mountinfo").read_text().splitlines():
        left, right = line.split(" - ", 1)
        if left.split()[4] == target:
            return right.split()[0]
    return None


def expected_ids(item):
    uid = pwd.getpwnam(item["owner"]).pw_uid if item.get("owner") else int(item.get("uid") or 0)
    gid = grp.getgrnam(item["group"]).gr_gid if item.get("group") else int(item.get("gid") or 0)
    return uid, gid


def check_file(path, item, problems, template=False, entries=None):
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        problems.append(f"{item['name']}: missing")
        return
    uid, gid = expected_ids(item)
    if not stat.S_ISREG(info.st_mode):
        problems.append(f"{item['name']}: not a regular file")
    elif (info.st_uid, info.st_gid) != (uid, gid):
        problems.append(f"{item['name']}: owner {info.st_uid}:{info.st_gid}, expected {uid}:{gid}")
    elif stat.S_IMODE(info.st_mode) != int(item["mode"], 8):
        problems.append(f"{item['name']}: mode {stat.S_IMODE(info.st_mode):04o}, expected {item['mode']}")
    elif info.st_size == 0:
        problems.append(f"{item['name']}: empty")
    elif template and b"<SOPS:" in Path(path).read_bytes():
        problems.append(f"{item['name']}: placeholder left unrendered")
    elif entries is not None and not template:
        try:
            validate(entries, item["name"], Path(path).read_text())
        except (Refused, UnicodeDecodeError):
            problems.append(f"{item['name']}: value does not match its format")


def ciphertext_problems():
    """The host ciphertext must exist and be for exactly this host and the pinned escrow (fail closed)."""
    if not HOST_CONFIG.joinpath("escrow-recipient").exists():
        return ["the pinned escrow recipient is missing from /etc/terrace"]
    if not HOST_FILE.exists():
        return ["no host ciphertext; push first"]
    _, _, _, _, pinned, own = host_context()
    return recipient_problems(json.loads(HOST_FILE.read_text()), [own, pinned])


def stale_tls_names():
    """tls/* still in the host ciphertext of a host that gets its certificate by ACME (names only, no decryption)."""
    try:
        entries, role, features, _, _, _ = host_context()
        names = [name for name, _ in leaves(json.loads(HOST_FILE.read_text()))]
    except (OSError, ValueError, Refused):
        return []
    return sorted(name for name in names if name in entries and entries[name].get("omittedBy") in features)


def warn_stale_tls():
    stale = stale_tls_names()
    if stale:
        print(f"WARNING: this host gets its certificate by ACME but its ciphertext still holds {', '.join(stale)};"
              " once ACME issued, run `terrace-secrets host tls HOST acme --yes` and push (docs/tls.md).")


def cmd_verify(args):
    require_root()
    manifest = json.loads(Path(args.manifest).read_text())
    entries = inventory()
    problems = []
    problems += ciphertext_problems()
    generation = os.path.realpath(SECRETS_ROOT)
    if not SECRETS_ROOT.is_symlink() or os.path.dirname(generation) != os.path.realpath(MOUNT_ROOT):
        problems.append("/run/secrets: not a link to a secrets generation")
    kind = mount_type(MOUNT_ROOT)
    if kind not in ("ramfs",):
        problems.append(f"/run/secrets.d: mounted as {kind}, expected ramfs")
    for item in manifest.get("secrets") or []:
        check_file(Path(generation) / item["name"], item, problems, entries=entries)
        if item["path"] != f"/run/secrets/{item['name']}" and os.path.realpath(item["path"]) != os.path.join(generation, item["name"]):
            problems.append(f"{item['name']}: {item['path']} does not resolve to the current generation")
    for item in manifest.get("templates") or []:
        check_file(Path(generation) / "rendered" / item["name"], item, problems, template=True)
        if item["path"] != f"/run/secrets/rendered/{item['name']}" and \
                os.path.realpath(item["path"]) != os.path.join(generation, "rendered", item["name"]):
            problems.append(f"{item['name']}: {item['path']} does not resolve to the current generation")
    for problem in problems:
        print("FAIL " + problem)
    if problems:
        raise Refused(f"verify: {len(problems)} problem(s)")
    print(f"terrace-secrets verify: PASS {len(manifest.get('secrets') or [])} secrets, "
          f"{len(manifest.get('templates') or [])} templates, root-only modes, valid formats, ramfs.")
    warn_stale_tls()


def scram_verifier(password, salt=None, iterations=4096):
    """PostgreSQL's SCRAM-SHA-256 verifier (RFC 5802/7677), computed here so no cleartext reaches SQL."""
    salt = salt if salt is not None else token.token_bytes(16)
    salted = hashlib.pbkdf2_hmac("sha256", password.encode(), salt, iterations)
    client = hmac.new(salted, b"Client Key", hashlib.sha256).digest()
    stored = hashlib.sha256(client).digest()
    server = hmac.new(salted, b"Server Key", hashlib.sha256).digest()
    b64 = lambda raw: base64.b64encode(raw).decode()
    return f"SCRAM-SHA-256${iterations}:{b64(salt)}${b64(stored)}:{b64(server)}"


# A failing statement must not be logged with its text (the verifier is still a secret).
QUIET_SQL = "SET log_min_error_statement = panic; SET log_statement = 'none'; SET log_min_duration_statement = -1;\n"


def cmd_host_apply(args):
    """On-host action that moves a manual secret into the service that keeps its own copy."""
    require_root()
    entries = inventory()
    entry = entries.get(args.name)
    if not entry or "apply" not in entry or args.name not in expected(entries, host_setting("role"), [f for f in host_setting("features").split(",") if f]):
        raise Refused(f"{args.name}: no on-host apply action on this host")
    if entry["apply"] == "database-password":
        if args.finish or not re.fullmatch(r"[a-z_][a-z0-9_]{0,62}", args.role):
            raise Refused("the database password has no finish step; --role must be a plain role name")
        value = (SECRETS_ROOT / args.name).read_text()
        validate(entries, args.name, value)
        verifier = scram_verifier(value)
        sql = (QUIET_SQL + f"ALTER ROLE {args.role} WITH PASSWORD '{verifier}';\n").encode()
        if subprocess.run(["runuser", "-u", "postgres", "--", "psql", "-X", "-q", "-v", "ON_ERROR_STOP=1", "-d", "postgres", "-f", "-"],
                          input=sql, capture_output=True, env={**os.environ, "PGOPTIONS": "-c log_min_error_statement=panic"}).returncode != 0:
            raise Refused("ALTER ROLE failed (statement text is not logged)")
        if args.role == "keycloak" and subprocess.run(["systemctl", "restart", "keycloak.service"], capture_output=True).returncode != 0:
            raise Refused("Keycloak did not restart with the new database password")
        print(f"Database role {args.role} updated with a SCRAM verifier" + (" and Keycloak restarted." if args.role == "keycloak" else "."))
        return
    if entry["apply"] == "identity-handoff":
        if args.finish:
            raise Refused("the identity handoff has no finish step")
        value = sys.stdin.buffer.read(MAX_VALUE + 1).decode()
        validate(entries, args.name, value)
        handoff = IDENTITY_HANDOFF
        handoff.mkdir(mode=0o700, exist_ok=True)
        os.chown(handoff, 0, 0)
        os.chmod(handoff, 0o700)
        if not memory_filesystem(handoff):
            raise Refused(f"{handoff} is not on a memory filesystem")
        destination = handoff / args.name.split("/")[-1]
        fd, tmp = tempfile.mkstemp(prefix=".handoff.", dir=handoff)
        try:
            try:
                os.fchmod(fd, 0o400)
                os.write(fd, value.encode())
            finally:
                os.close(fd)
            os.replace(tmp, destination)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)
        print(f"Delivered {args.name} to {destination} (root-only, tmpfs) for `terrace-identity-admin first-admin`.")
        return
    target = args.name.split("/")[1]
    if args.remove and not (args.finish and args.only_current):
        raise Refused("--remove belongs to --finish --only-current")
    if args.finish:
        if not args.only_current and not args.keep:
            raise Refused("--finish needs --keep KEYID for every key to keep (for example a separately escrowed one) or --only-current")
        if args.only_current and args.keep:
            raise Refused("--only-current keeps no other key; give either --keep or --only-current")
        # The current key is the one the delivered file opens. Before `push` that is still the OLD password, and
        # finishing would remove the NEW key: refuse unless the delivered file holds the store's newest value.
        value = sys.stdin.buffer.read(MAX_VALUE + 1).decode()
        if not value:
            raise Refused("--finish needs the store's value on stdin; run `terrace-secrets apply ... --finish` from the operator machine")
        validate(entries, args.name, value)
        delivered = (SECRETS_ROOT / args.name).read_bytes()
        if not hmac.compare_digest(delivered, value.encode()):
            raise Refused("the password delivered to this host is not the store's newest value; `push` first,"
                          " then repeat `apply --finish` (finishing now would remove the new key)")
        listing = subprocess.run(["terrace-backup", "restic", target, "key", "list", "--json"], capture_output=True)
        if listing.returncode != 0:
            raise Refused("restic key list failed; push the new password first")
        keys = json.loads(listing.stdout)
        if sum(1 for key in keys if key.get("current")) != 1:
            raise Refused("restic did not report exactly one current key")
        if args.only_current:
            old = [key["id"] for key in keys if not key.get("current")]
            current = [key["id"] for key in keys if key.get("current")][0]
            named = [[key_id for key_id in old if key_id.startswith(prefix)] for prefix in args.remove or []]
            confirmed = not any(current.startswith(prefix) for prefix in args.remove or []) \
                and all(len(match) == 1 for match in named) and sorted({match[0] for match in named}) == sorted(old)
            if not confirmed:
                # A separately added escrow key is not current either: show every key before anything is removed.
                for key in keys:
                    print(f"key {key['id']} {'current (kept)' if key.get('current') else 'other (removed)'}"
                          f" {key.get('userName', '?')}@{key.get('hostName', '?')} created {key.get('created', '?')}")
                raise Refused(f"--only-current removes {len(old)} key(s), every key but the current one, including any separately"
                              " added escrow key. Read the list above, then repeat with --remove KEYID for exactly each key marked"
                              " `other`, or use --keep KEYID for the keys to keep")
        else:
            old = [key["id"] for key in keys if not key.get("current") and not any(key["id"].startswith(k) for k in args.keep)]
        for key_id in old:
            if not re.fullmatch(r"[0-9a-f]{8,64}", key_id) or subprocess.run(
                    ["terrace-backup", "restic", target, "key", "remove", key_id], capture_output=True).returncode != 0:
                raise Refused("restic key remove failed")
        print(f"Removed {len(old)} old repository key(s) from {target}; kept the current key" + (f" and {len(args.keep)} listed key(s)." if args.keep else "."))
        return
    value = sys.stdin.buffer.read(MAX_VALUE + 1).decode()
    validate(entries, args.name, value)
    if subprocess.run(["terrace-backup", "restic", target, "key", "add", "--new-password-file", "/dev/stdin"],
                      input=value.encode(), capture_output=True).returncode != 0:
        raise Refused("restic key add failed")
    print(f"Added the new repository key to {target}; now push, then `apply --finish`.")


def cmd_reencrypt(args):
    """Host: re-encrypt this host's ciphertext to {this host, NEW escrow} and print it (escrow lost)."""
    require_root()
    if not AGE_RECIPIENT_RE.match(args.escrow_recipient):
        raise Refused("not an age X25519 recipient")
    entries, _, _, _, _, own = host_context()
    tree = decrypt_file(HOST_FILE, host_identity_env())
    for name, value in leaves(tree):
        validate(entries, name, value)
    values = [value for _, value in leaves(tree)]
    out = run(["sops", "encrypt", "--age", f"{own},{args.escrow_recipient}", "--input-type", "json", "--output-type", "json",
               "--filename-override", "secrets.sops.json"], stdin=json.dumps(tree).encode(), values=values,
              env_extra=host_identity_env()).stdout
    sys.stdout.write(out.decode())


def cmd_escrow_adopt(args):
    """Operator: fetch a host's `reencrypt` output over the pinned channel, decrypt it with the
    new escrow identity (SOPS_AGE_KEY_FILE) and check names and formats before storing it."""
    entries = inventory()
    with store_lock():
        directory, role, features = host_info(args.host)
        new_escrow = escrow_recipient()
        code, out, err = pinned_ssh(args, ["terrace-secrets", "reencrypt", new_escrow], b"")
        if code != 0:
            report_remote("reencrypt", args.host, code, "", err)
        data = out.encode()
        validate_ciphertext(data, recipients(args.host)[0], new_escrow, entries, role, features, args.rehearsal)
        private_identity_file()
        with tempfile.NamedTemporaryFile(dir=directory, prefix=".adopt.", delete=True) as incoming:
            incoming.write(data)
            incoming.flush()
            for name, value in leaves(decrypt_file(incoming.name)):
                validate(entries, name, value)
        write_new(directory / "secrets.sops.json", data, replace=True)
    print(f"Stored {args.host}'s ciphertext, re-encrypted on the host to its key and the new escrow, after checking every value.")


def key_id(value):
    if not re.fullmatch(r"[0-9a-f]{4,64}", value):
        raise argparse.ArgumentTypeError("a restic key id is 4 to 64 lowercase hex digits")
    return value


def parser():
    top = argparse.ArgumentParser(prog="terrace-secrets", description=__doc__.splitlines()[0])
    sub = top.add_subparsers(dest="command", required=True)
    escrow = sub.add_parser("escrow").add_subparsers(dest="action", required=True)
    create = escrow.add_parser("create")
    create.add_argument("out")
    create.set_defaults(func=cmd_escrow_create)
    replace = escrow.add_parser("replace", help="new escrow key; re-encrypt every host (needs the old escrow)")
    replace.add_argument("out")
    replace.set_defaults(func=cmd_escrow_replace)
    adopt = escrow.add_parser("adopt", help="fetch and store a host's `reencrypt` output over the pinned channel (old escrow lost)")
    adopt.add_argument("host")
    adopt.add_argument("--address", required=True)
    adopt.add_argument("--user", default="operator")
    adopt.add_argument("--port", type=int, default=22)
    adopt.add_argument("--identity")
    adopt.add_argument("--rehearsal", action="store_true", help=argparse.SUPPRESS)
    adopt.set_defaults(func=cmd_escrow_adopt)
    host = sub.add_parser("host").add_subparsers(dest="action", required=True)
    hcreate = host.add_parser("create")
    hcreate.add_argument("host")
    hcreate.add_argument("--role", required=True)
    hcreate.add_argument("--feature", action="append", choices=["secondary-backup", "acme-tls"])
    hcreate.add_argument("--stage", help="default: a private directory on the memory-backed scratch filesystem")
    hcreate.add_argument("--replace", action="store_true")
    hcreate.set_defaults(func=cmd_host_create)
    reset = host.add_parser("reset-replacement", help="clear a replacement marker (the host is redeployed as new)")
    reset.add_argument("host")
    reset.add_argument("--confirm", required=True, help="the host name again")
    reset.set_defaults(func=cmd_host_reset_replacement)
    tls = host.add_parser("tls", help="switch how the host gets its certificate (docs/tls.md)")
    tls.add_argument("host")
    tls.add_argument("mode", choices=["acme", "manual"])
    tls.add_argument("--yes", action="store_true", help="confirm removing tls/* from the store (acme)")
    tls.set_defaults(func=cmd_host_tls)
    unstage = host.add_parser("unstage")
    unstage.add_argument("host")
    unstage.add_argument("--stage")
    unstage.set_defaults(func=cmd_host_unstage)
    for name, func in [("generate", cmd_generate), ("rekey", cmd_rekey)]:
        command = sub.add_parser(name)
        command.add_argument("host")
        command.set_defaults(func=func)
    for name, func in [("set", cmd_set), ("rotate", cmd_rotate), ("public", cmd_public)]:
        command = sub.add_parser(name)
        command.add_argument("host")
        command.add_argument("name")
        command.add_argument("--rehearsal", action="store_true", help=argparse.SUPPRESS)
        command.add_argument("--manual", action="store_true", help="rotate: also a secret with a manual procedure")
        command.set_defaults(func=func)
    check = sub.add_parser("check")
    check.add_argument("host")
    check.add_argument("--rehearsal", action="store_true", help="also accept rehearsal/* entries")
    check.set_defaults(func=cmd_check)
    for name, func in [("push", cmd_push), ("apply", cmd_apply)]:
        command = sub.add_parser(name)
        command.add_argument("host")
        if name == "apply":
            command.add_argument("name")
            command.add_argument("--finish", action="store_true")
            command.add_argument("--only-current", action="store_true", help="--finish: remove every key but the current one")
            command.add_argument("--keep", action="append", type=key_id, help="--finish: a key id (prefix) to keep; repeatable")
            command.add_argument("--remove", action="append", type=key_id,
                                 help="--finish --only-current: a key id (prefix) to remove, naming exactly each key but the current one")
        command.add_argument("--address", required=True)
        command.add_argument("--user", default="operator")
        command.add_argument("--port", type=int, default=22)
        command.add_argument("--identity")
        command.add_argument("--rehearsal", action="store_true", help=argparse.SUPPRESS)
        command.set_defaults(func=func)
    install = sub.add_parser("install", help="host: read ciphertext on stdin, validate, install it and verify")
    install.add_argument("--replacement", action="store_true", help=argparse.SUPPRESS)
    install.set_defaults(func=cmd_install)
    verify = sub.add_parser("verify", help="host: check every expected secret without printing values")
    verify.add_argument("--manifest", default=str(MANIFEST))
    verify.set_defaults(func=cmd_verify)
    happly = sub.add_parser("host-apply", help="host: hand a manual secret to its service")
    happly.add_argument("name")
    happly.add_argument("--finish", action="store_true")
    happly.add_argument("--only-current", action="store_true")
    happly.add_argument("--keep", action="append", type=key_id)
    happly.add_argument("--remove", action="append", type=key_id)
    happly.add_argument("--role", default="keycloak", help=argparse.SUPPRESS)
    happly.set_defaults(func=cmd_host_apply)
    reencrypt = sub.add_parser("reencrypt", help="host: print this host's ciphertext re-encrypted to a new escrow")
    reencrypt.add_argument("escrow_recipient")
    reencrypt.set_defaults(func=cmd_reencrypt)
    return top


def main(argv=None):
    # This process holds secrets: never let it dump core.
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    args = parser().parse_args(argv)
    try:
        args.func(args)
    except Refused as error:
        print(f"terrace-secrets: {error}", file=sys.stderr)
        return 1
    except (OSError, ValueError, KeyError) as error:
        # Never echo the exception text: a parser error can quote input bytes.
        print(f"terrace-secrets: {type(error).__name__} during {args.command}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
