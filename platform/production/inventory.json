     "consumer": "cms.env and web.env LIFECYCLE_INTAKE_SECRET (one shared value)"},
    {"name": "identity/client/terrace-web", "roles": ["app"], "feature": "core", "generator": "hex32", "delivered": true,
     "restartUnits": [], "rotation": "manual",
     "consumer": "realm client terrace-web; web.env MEMBER_AUTH_CLIENT_SECRET"},
    {"name": "identity/client/terrace-community", "roles": ["app"], "feature": "core", "generator": "hex32", "delivered": true,
     "restartUnits": [], "rotation": "manual",
     "consumer": "realm client terrace-community; cms.env MEMBER_AUTH_INTROSPECTION_SECRET"},
    {"name": "identity/client/terrace-cms", "roles": ["app"], "feature": "core", "generator": "hex32", "delivered": true,
     "restartUnits": [], "rotation": "manual",
