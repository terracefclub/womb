# VM drill of the written restore promotion procedure (docs/restore-promotion.md,
# section 2): the production app and relay roles (`instance = "rehearsal"`,
# synthetic .invalid names, secrets generated by terrace-secrets inside the
# operator guest), an original pair with data and backups, then the procedure in
# the document's order with the document's commands. The commands come from
# promotion-commands.json; evaluation fails unless every one of them appears
# verbatim in the document (tests/platform/test_promotion_drill.py checks the
# same in CI), so the document and the drill cannot drift apart.
#
# What a VM cannot do is done as near as it can and says so where it happens:
# fencing at a provider is a power-off (`shutdown`, `crash`) and moving the disk
# image aside; the Storage Box is an SFTP account on the operator guest; escrow
# retrieval is a key made at build time; DNS is the test network's /etc/hosts.
# The owner's decisions (section 1.3) are stop points in the document; the drill
# proceeds past each and records which option it took. Those are the drill's
# choices for synthetic data, not the owner's.
{
  pkgs,
  release,
  contract,
  sopsModule,
}: let
  lib = pkgs.lib;
  doc = builtins.readFile ../../docs/restore-promotion.md;
  # Inline commands may be wrapped across lines (and list indentation) in the document.
  flat = lib.replaceStrings ["\n  " "\n"] [" " " "] doc;
  commands = builtins.fromJSON (builtins.readFile ./promotion-commands.json);
  fenced = kind: lines: "```${kind}\n${lib.concatStringsSep "\n" lines}\n```";
  missing =
    lib.filter (name: !(lib.hasInfix (fenced "sh" commands.blocks.${name}) doc)) (lib.attrNames commands.blocks)
    ++ lib.filter (name: !(lib.hasInfix (fenced "text" commands.outputs.${name}) doc)) (lib.attrNames commands.outputs)
    ++ lib.filter (name: !(lib.hasInfix commands.inline.${name} flat)) (lib.attrNames commands.inline);
  checked =
    if missing == []
    then commands
    else throw "promotion drill: not verbatim in docs/restore-promotion.md: ${toString missing}";
  names = ["web.terrace.invalid" "cms.terrace.invalid" "identity.terrace.invalid"];
  tool = pkgs.callPackage ./package.nix {};
  # Synthetic CA, as in test.nix: every consumer references this path, never a copy.
  ca = pkgs.runCommand "terrace-promotion-drill-ca" {nativeBuildInputs = [pkgs.openssl];} ''
    mkdir $out
    openssl req -x509 -nodes -newkey rsa:2048 -sha256 -days 3650 \
      -keyout $out/ca-key.pem -out $out/ca.pem -subj /CN=TerracePromotionDrillCA \
      -addext basicConstraints=critical,CA:TRUE -addext keyUsage=critical,keyCertSign,cRLSign >/dev/null 2>&1
  '';
  trust = "${ca}/ca.pem";
  keys = pkgs.runCommand "terrace-promotion-drill-keys" {nativeBuildInputs = [pkgs.openssh];} ''
    mkdir $out
    ssh-keygen -q -t ed25519 -N "" -C drill-operator -f $out/operator
    ssh-keygen -q -t ed25519 -N "" -C drill-repository -f $out/repository-host
  '';
  publicKey = file: lib.removeSuffix "\n" (builtins.readFile "${keys}/${file}.pub");
  # Stands in for the owner's offline escrow key (step 4 "re-key the store from escrow").
  escrow = pkgs.runCommand "terrace-promotion-drill-escrow" {nativeBuildInputs = [pkgs.age];} ''
    mkdir $out
    age-keygen -o $out/escrow.age 2>/dev/null
    age-keygen -y $out/escrow.age >$out/escrow.pub
  '';
  escrowRecipient = lib.removeSuffix "\n" (builtins.readFile "${escrow}/escrow.pub");
  leafExtension = hostnames:
    pkgs.writeText "terrace-drill-leaf.ext" ''
      basicConstraints=critical,CA:FALSE
      keyUsage=critical,digitalSignature,keyEncipherment
      extendedKeyUsage=serverAuth
      subjectAltName=${lib.concatMapStringsSep "," (name: "DNS:${name}") hostnames}
    '';
  appExtension = leafExtension names;
  relayExtension = leafExtension ["relay.terrace.invalid"];
  # Drill-only harness: the installer stand-in, trust in the synthetic CA, the
  # imported-content fixture and client tools. Unlike rehearsal.nix it adds no
  # rehearsal/* secret, so the store holds only production names and the
  # document's `check` and `push` commands run without `--rehearsal`.
  appHarness = {
    imports = [./rehearsal-stage.nix];
    terrace.production.rehearsalHarness = true;
    terrace.production.tls.trustAnchorFile = trust;
    systemd.services = {
      terrace-cms.environment.NODE_EXTRA_CA_CERTS = trust;
      terrace-cms-migrate.environment.NODE_EXTRA_CA_CERTS = trust;
      terrace-cms-sweep.environment.NODE_EXTRA_CA_CERTS = trust;
      terrace-web.environment.NODE_EXTRA_CA_CERTS = trust;
    };
    environment.etc."gateway-content.sql".source = ../website-gateway/content.sql;
    environment.systemPackages = [pkgs.curl pkgs.jq];
  };
  relayHarness = {
    imports = [./rehearsal-relay.nix];
    terrace.production.tls.trustAnchorFile = trust;
  };
in {
  name = "terrace-production-promotion-drill";
  nodes = {
    # Operator workstation and the synthetic SFTP repository (the Storage Box's stand-in).
    operator = {...}: {
      virtualisation = {
        memorySize = 2048;
        cores = 1;
      };
      environment.systemPackages = [tool pkgs.sops pkgs.age pkgs.ssh-to-age pkgs.openssl pkgs.jq pkgs.restic];
      services.openssh = {
        enable = true;
        hostKeys = [
          {
            type = "ed25519";
            path = "/etc/ssh/ssh_host_ed25519_key";
          }
        ];
        extraConfig = ''
          Match User restic
            ForceCommand internal-sftp
            AllowTcpForwarding no
            PermitTTY no
        '';
      };
      users.users.restic.isNormalUser = true;
      system.activationScripts.drillRepositoryHostKey = ''
        install -d -m 0755 /etc/ssh
        install -m 0600 ${keys}/repository-host /etc/ssh/ssh_host_ed25519_key
        install -m 0644 ${keys}/repository-host.pub /etc/ssh/ssh_host_ed25519_key.pub
      '';
    };
    # One node per role: the original and its replacement are the same VM definition with a new disk.
    app = {...}: {
      imports = [sopsModule ./app.nix appHarness];
      virtualisation = {
        memorySize = 9216;
        cores = 2;
        diskSize = 4096;
      };
      terrace.production = {
        instance = "rehearsal";
        memoryMiB = 9216;
        inherit escrowRecipient;
        operatorKeys = [(publicKey "operator")];
        app = {
          webHostname = "web.terrace.invalid";
          cmsHostname = "cms.terrace.invalid";
          identityHostname = "identity.terrace.invalid";
          identityContract = contract;
          backup.primary = {
            repository = "sftp:restic@operator:repository";
            knownHosts = "operator ${publicKey "repository-host"}";
          };
        };
      };
      terrace.website = {
        webPackage = release.web;
        cmsPackage = release.cms;
        inherit (release) revision;
      };
    };
    relay = {...}: {
      imports = [sopsModule ./relay.nix relayHarness];
      virtualisation = {
        memorySize = 2048;
        cores = 1;
      };
      terrace.production = {
        instance = "rehearsal";
        memoryMiB = 2048;
        inherit escrowRecipient;
        operatorKeys = [(publicKey "operator")];
        relay = {
          hostname = "relay.terrace.invalid";
          publicIPv4 = "192.0.2.10";
          backup.primary = {
            repository = "sftp:restic@operator:relay-repository";
            knownHosts = "operator ${publicKey "repository-host"}";
          };
        };
      };
    };
  };
  testScript = ''
    import json, re, shlex, time

    checks = []
    def ok(condition, label):
        assert condition, label
        checks.append(label)

    C = json.loads(${builtins.toJSON (builtins.toJSON checked)})
    BLOCK = C["blocks"]
    INLINE = C["inline"]
    OUTPUT = C["outputs"]
    STORE = "/root/store"
    ESCROW = "/root/escrow/escrow.age"
    # Step 4: the operator environment of docs/secrets.md, exported for every command of a pipeline.
    ENV = f"export TERRACE_SECRETS_STORE={STORE} SOPS_AGE_KEY_FILE={ESCROW} TERRACE_SECRETS_SCRATCH=/dev/shm TERRACE_ESCROW_RECIPIENT=${escrowRecipient}; "
    IDENTITY = "/root/.ssh/operator"
    RESTORE = "/var/lib/terrace-restore"
    MEDIA = "/var/lib/terrace-cms-media"
    OUTBOX = "/var/lib/terrace-cms-outbox"
    BACKUP_HELD = ["terrace-backup.timer", "terrace-backup-check.timer", "terrace-backup-freshness.timer"]
    SWEEP = "terrace-cms-sweep.timer"
    timings = {}
    # Values the drill reads back, kept apart from the free-form records it only prints.
    keep: dict[str, str] = {}
    records: dict[str, object] = {}
    decisions: dict[str, str] = {}
    relay_users: list[str] = []
    identity_before: dict[str, str] = {}

    class timed:
        # Seconds per procedure step (section 5 item 12), recorded, never asserted.
        def __init__(self, label):
            self.label = label

        def __enter__(self):
            self.started = time.monotonic()

        def __exit__(self, *exc):
            timings[self.label] = round(time.monotonic() - self.started, 2)

    def op(command, **kwargs):
        return operator.succeed(ENV + command, **kwargs)

    def sh(machine, script, **kwargs):
        # A document block as one script: stops at the first failing line.
        return machine.succeed("bash -euo pipefail -c " + shlex.quote(script), **kwargs)

    def block(name, subs=None):
        text = "\n".join(BLOCK[name])
        for key, value in (subs or {}).items():
            text = text.replace(key, value)
        return text

    def state(machine, unit, prop):
        return machine.succeed(f"systemctl show {unit} -p {prop} --value").strip()

    def held(machine, label, units):
        for unit in units:
            ok((state(machine, unit, "ActiveState"), state(machine, unit, "ConditionResult")) in [("inactive", "no"), ("inactive", "")], f"{label}: {unit} held")

    def status(machine):
        return machine.succeed(BLOCK["step10-status"][0]).strip().splitlines()

    def adopt_output(out, label):
        # `adopt` runs `terrace-secrets verify` first, whose PASS line comes before the adoption's own lines.
        lines = out.strip().splitlines()
        verify_line(lines[0], label + ": first the verify line")
        return lines[1:]

    def no_failed(machine, label):
        out = machine.succeed(BLOCK["step20-health"][0])
        ok("0 loaded units listed." in out, f"{label}: systemctl --failed lists none")

    def verify_line(text, label):
        ok(re.fullmatch(r"terrace-secrets verify: PASS [0-9]+ secrets, [0-9]+ templates, root-only modes, valid formats, ramfs\.", text.strip()) is not None, label + ": " + text.strip())

    def sql(query, database="terrace_cms"):
        return app.succeed("runuser -u postgres -- psql -XAt -d " + database + " -c " + shlex.quote(query) + " 2>/dev/null").strip()

    def signature():
        return {
            "realm": sql("select id from realm where name='terrace'", "keycloak"),
            "users": sql("select md5(coalesce(string_agg(id||username,chr(10) order by id),''')) from user_entity", "keycloak"),
            "migrations": sql("select name||batch from payload_migrations order by id"),
            "posts": sql("select md5(coalesce(string_agg(slug||title,chr(10) order by slug),''')) from posts"),
            "media rows": sql("select md5(coalesce(string_agg(filename||public::text,chr(10) order by filename),''')) from media"),
            "roles": sql("select md5(coalesce(string_agg(rolname||coalesce(rolpassword,'''),chr(10) order by rolname),''')) from pg_authid", "postgres"),
            "outbox": app.succeed("cd " + OUTBOX + " && stat -c '%U %a' . && find . -type f -printf '%P %U %m\\n' | LC_ALL=C sort && find . -type f -print0 | LC_ALL=C sort -z | xargs -0r sha256sum").strip(),
            "media": app.succeed("cd " + MEDIA + " && find . -type f -printf '%P %U %m\\n' | LC_ALL=C sort && find . -type f -print0 | LC_ALL=C sort -z | xargs -0r sha256sum").strip(),
        }

    def identity():
        # Realm, issuer and public signing keys, from Keycloak itself over HTTPS (section 5 item 10).
        base = "curl --fail --silent --max-time 10 --cacert ${trust} --resolve identity.terrace.invalid:443:127.0.0.1 https://identity.terrace.invalid/realms/terrace"
        return {
            "issuer": app.succeed(base + "/.well-known/openid-configuration | jq -r .issuer").strip(),
            "keys": app.succeed(base + "/protocol/openid-connect/certs | jq -S -c '[.keys[] | {kid, kty, alg, use, n, e, x, y, crv}] | sort_by(.kid)'").strip(),
            "realm": sql("select id from realm where name='terrace'", "keycloak"),
        }

    def snapshots(machine):
        return json.loads(machine.succeed(BLOCK["step07-snapshots"][0] + " 2>/dev/null"))

    def stage(host):
        # The installer stand-in (rehearsal-stage.nix) copies the operator-generated host key at first boot.
        operator.succeed(f"rm -rf /tmp/shared/stage/{host} && install -d -m 0700 /tmp/shared/stage/{host} && cp /dev/shm/terrace-stage-{host}/ssh_host_ed25519_key /dev/shm/terrace-stage-{host}/ssh_host_ed25519_key.pub /tmp/shared/stage/{host}/")

    def push(host):
        return op(block("step06-push", {"<replacement address>": host, "<operator ssh key>": IDENTITY}).splitlines()[0].replace("push app ", "push " + host + " "))

    def unstage(host):
        operator.succeed(f"rm -rf /tmp/shared/stage/{host}")
        op(block("step06-push").splitlines()[1].replace(" app", " " + host))
        operator.fail(f"test -e /dev/shm/terrace-stage-{host}")

    def fingerprint(machine):
        return machine.succeed("ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub | cut -d' ' -f2").strip()

    def staged_fingerprint(host):
        return operator.succeed(f"ssh-keygen -lf /dev/shm/terrace-stage-{host}/ssh_host_ed25519_key.pub | cut -d' ' -f2").strip()

    def disk(machine):
        disks = list(machine.state_dir.glob("*.qcow2"))
        assert len(disks) == 1, disks
        return disks[0]

    def operator_snapshots(repository, host):
        # The operator's own view of a repository (the off-host side), with the store's current password.
        op(f"umask 077; sops decrypt --output-type json {STORE}/hosts/{host}/secrets.sops.json | jq -j '.[\"backup/primary/repository-password\"] // .backup.primary[\"repository-password\"]' >/dev/shm/repo-pass")
        out = operator.succeed(f"RESTIC_PASSWORD_FILE=/dev/shm/repo-pass restic --no-lock --no-cache -r /home/restic/{repository} snapshots --json 2>/dev/null; rc=$?; rm -f /dev/shm/repo-pass; exit $rc")
        return json.loads(out)

    def retained_by_policy(group, snapshot_id):
        # restic's keep rules as backup.nix sets them (keep-last 3, daily 7, weekly 4, monthly 6), for one group.
        ordered = sorted(group, key=lambda s: s["time"], reverse=True)
        keep = {s["id"] for s in ordered[:3]}
        for width, count in [(10, 7), (None, 4), (7, 6)]:
            buckets = []
            for s in ordered:
                bucket = time.strftime("%G-%V", time.strptime(s["time"][:10], "%Y-%m-%d")) if width is None else s["time"][:width]
                if bucket not in buckets:
                    buckets.append(bucket)
                    if len(buckets) <= count:
                        keep.add(s["id"])
        return snapshot_id in keep

    started_at = time.time()
    operator.start()
    operator.wait_for_unit("multi-user.target")
    operator.wait_for_unit("sshd.service")
    operator.succeed("install -d -m 0700 /root/escrow /root/.ssh " + STORE + " && install -m 0600 ${keys}/operator " + IDENTITY)
    operator.succeed("install -m 0600 ${escrow}/escrow.age " + ESCROW + " && install -m 0644 ${escrow}/escrow.pub " + STORE + "/escrow.recipient")

    with subtest("setup: the original pair's host keys and secrets, the two SFTP repositories"):
        for host, role, extension, cn in [("app", "app", "${appExtension}", "web.terrace.invalid"), ("relay", "relay", "${relayExtension}", "relay.terrace.invalid")]:
            op(f"terrace-secrets host create {host} --role {role} && terrace-secrets generate {host}")
            op("sh -ec 'umask 077; d=$(mktemp -d /dev/shm/tls.XXXXXX); "
               f"openssl req -new -nodes -newkey rsa:2048 -sha256 -keyout $d/key.pem -out $d/req.pem -subj /CN={cn} 2>/dev/null; "
               f"openssl x509 -req -in $d/req.pem -CA ${ca}/ca.pem -CAkey ${ca}/ca-key.pem -set_serial 0x$(openssl rand -hex 8) -days 30 -sha256 -extfile {extension} -out $d/cert.pem 2>/dev/null; "
               f"terrace-secrets set {host} tls/key <$d/key.pem; terrace-secrets set {host} tls/certificate <$d/cert.pem; rm -rf $d'")
            out = op(f"terrace-secrets check {host}")
            ok(re.search(host + r": [0-9]+ secrets encrypted to exactly the host key and the pinned escrow key\.", out) is not None, f"{host}: store complete without rehearsal entries")
            public = op(f"terrace-secrets public {host} backup/primary/sftp-key").strip()
            keep[host + " sftp public key"] = public
            repository = "repository" if host == "app" else "relay-repository"
            operator.succeed("install -d -o restic -g users -m 0700 /home/restic/.ssh /home/restic/" + repository + " && echo " + shlex.quote(public) + " >>/home/restic/.ssh/authorized_keys"
                             " && chown restic:users /home/restic/.ssh/authorized_keys && chmod 0600 /home/restic/.ssh/authorized_keys")
            stage(host)
        keep["original app key"] = staged_fingerprint("app")

    with subtest("setup: original app adopted as new, first backup, synthetic content, media and outbox"):
        app.start()
        app.wait_for_unit("multi-user.target")
        ok(fingerprint(app) == keep["original app key"], "original app runs its operator-generated key")
        push("app")
        unstage("app")
        app.succeed("terrace-production adopt --new", timeout=600)
        app.wait_for_unit("keycloak.service", timeout=360)
        app.wait_for_unit("nginx.service")
        # At once, as tls-test.nix does: the hourly freshness timer fails until a first backup exists.
        app.succeed("terrace-backup init primary >/dev/null 2>&1 && systemctl start terrace-backup.service", timeout=600)
        app.succeed("systemctl start terrace-backup-freshness.service")
        app.succeed("systemctl start terrace-cms-migrate.service && systemctl start terrace-cms.service terrace-web.service", timeout=300)
        app.succeed("install -m 0600 /dev/null " + MEDIA + "/private.png && echo 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGPgUbL4DwACCgFmeGgpMwAAAABJRU5ErkJggg==' | base64 -d >" + MEDIA + "/private.png && cp " + MEDIA + "/private.png " + MEDIA + "/public.png && chown terrace_cms:terrace_cms " + MEDIA + "/*.png")
        sql("insert into media(alt,public,filename,mime_type,filesize,width,height) values ('Synthetic private',false,'private.png','image/png',70,1,1),('Synthetic public',true,'public.png','image/png',70,1,1)")
        app.succeed("runuser -u postgres -- psql -XAt -v ON_ERROR_STOP=1 -d terrace_cms -f /etc/gateway-content.sql >/dev/null 2>&1")
        # Synthetic outbox files with the owner and mode the CMS gives invitation files.
        for n in range(3):
            app.succeed(f"umask 077; printf '{{\"synthetic\":\"invitation {n}\"}}\\n' >{OUTBOX}/drill-invitation-{n}.json && chown terrace_cms:terrace_cms {OUTBOX}/drill-invitation-{n}.json")
        ok(sql("select count(*) from posts where slug='synthetic-imported-post'") == "1", "original: synthetic content present")
        # Section 5 item 4: a deliberately damaged snapshot of its own tag (backup-test.nix does the same), never a normal backup.
        dumps = "/var/lib/terrace-backup/dumps"
        app.succeed("terrace-backup _stage >/dev/null 2>&1", timeout=300)
        app.succeed(f"echo invalid-dump >{dumps}/postgresql/broken.dump")
        app.succeed(f"terrace-backup restic primary backup --tag corrupt-restore --quiet {dumps} >/dev/null 2>&1", timeout=300)
        keep["damaged snapshot"] = json.loads(app.succeed("terrace-backup restic primary snapshots --tag corrupt-restore --json 2>/dev/null"))[0]["id"]
        app.succeed(f"rm -rf {dumps}")

    with subtest("setup: original relay adopted as new, two Headscale users, first backup"):
        relay.start()
        relay.wait_for_unit("multi-user.target")
        push("relay")
        unstage("relay")
        relay.succeed("terrace-production adopt --new", timeout=300)
        relay.wait_for_unit("headscale.service")
        relay.succeed("terrace-backup init primary >/dev/null 2>&1 && systemctl start terrace-backup.service", timeout=300)
        relay.succeed("systemctl start terrace-backup-freshness.service")
        relay.succeed("headscale users create drill-alice >/dev/null && headscale users create drill-bob >/dev/null")
        relay_users = sorted(user["name"] for user in json.loads(relay.succeed("headscale users list -o json")))
        ok(relay_users == ["drill-alice", "drill-bob"], "original relay: two users")
        keep["relay keys"] = relay.succeed("cd /var/lib/headscale && sha256sum noise_private.key derp_server_private.key").strip()
        ok(len(keep["relay keys"].splitlines()) == 2, "original relay: both private keys exist")

    # ---------------- App: the planned replacement (Part A with step 2) ----------------

    with subtest("app, step 1 (D1) and step 2: quiesce the original and take the final backup"):
        decisions["D1 app"] = "drill: planned replacement of a reachable original (synthetic; not the owner's decision)"
        identity_before = identity()
        lines = BLOCK["step02-quiesce-and-final-backup"]
        with timed("app step 2"):
            app.succeed(lines[0])
            ok(app.succeed("systemctl is-active " + " ".join(BACKUP_HELD[:2]) + " || true").split() == ["inactive", "inactive"], "step 2: the original's backup and check timers stopped")
            app.succeed(lines[1], timeout=180)
            before = signature()
            app.succeed(lines[2], timeout=600)
            listed = json.loads(app.succeed(lines[3] + " 2>/dev/null"))
            ok(app.succeed(INLINE["step02-result"]).strip() == "success", "step 2 worked: the backup unit's Result is success")
            ok(INLINE["step02-log"] in app.succeed("journalctl -u terrace-backup.service -o cat --no-pager"), "step 2 worked: the backup log line")
            app.succeed(INLINE["step02-age"])
            ok(True, "step 2 worked: terrace-backup age exits 0")
            ours = sorted((s for s in listed if s["hostname"] == "app" and "terrace" in s.get("tags", [])), key=lambda s: s["time"])
            keep["final snapshot"] = ours[-1]["id"]
            ok(len(ours) == 2, f"two scheduled-style snapshots of app before the restore ({len(ours)})")
            app.succeed(lines[4])
        ok(state(app, "postgresql.service", "ActiveState") == "inactive", "step 2: PostgreSQL stopped")
        # The drill's record of the quiesced state, as test.nix compares it after the restore.
        records["signature keys"] = sorted(before)

    with subtest("app, step 3: fence the original (power off; the disk is moved aside, kept for D6)"):
        # A VM cannot act at a provider: shutdown is the power-off, moving the image aside the isolation.
        app.shutdown()
        original_disk = disk(app)
        retired = original_disk.with_name("original-app.retired")
        original_disk.rename(retired)
        ok(retired.exists() and not original_disk.exists(), "step 3: original powered off and its disk out of the way")
        records["original fenced at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())

    with subtest("app, step 4: new host key and re-key of the store from escrow; same values"):
        plain = op(f"sops decrypt --output-type json {STORE}/hosts/app/secrets.sops.json | jq -S -c . | sha256sum").strip()
        lines = BLOCK["step04-rekey"]
        with timed("app step 4"):
            out = op(lines[0])
            ok("Run `rekey` before pushing." in out, "step 4 worked: host create says rekey before push")
            operator.fail(ENV + "terrace-secrets push app --address app --identity " + IDENTITY)
            ok(True, "step 4: a push before rekey is refused")
            op(lines[1])
            out = op(lines[2])
        ok(re.search(r"app: [0-9]+ secrets encrypted to exactly the host key and the pinned escrow key\.", out) is not None, "step 4 worked: check passes")
        ok(op(f"sops decrypt --output-type json {STORE}/hosts/app/secrets.sops.json | jq -S -c . | sha256sum").strip() == plain, "item 8: the same values after the re-key")
        stage("app")
