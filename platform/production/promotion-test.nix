        records["push to the returning original"] = "refused"
        ok(refused != "", "item 6: a push to the returning original is refused (the store pins the replacement's key)")
        app.wait_until_fails("systemctl is-active --quiet terrace-backup.service", timeout=600)
        app.succeed("systemctl start terrace-backup.service", timeout=600)
        ok(state(app, "terrace-backup.service", "Result") == "success", "item 6: the returning original can still write a backup into the repository")
        after_return = operator_snapshots("repository", "app")
        group = [s for s in after_return if s["hostname"] == "app" and "terrace" in s.get("tags", [])]
        newest = max(group, key=lambda s: s["time"])
        ok(newest["id"] not in [s["id"] for s in before_return], "item 6: the original's stale data is now the newest snapshot of the host name (`latest`)")
        records["replacement snapshots pruned by the returning original"] = len([s for s in before_return if s["id"] not in [t["id"] for t in after_return]])
        app.shutdown()
        retired_again = replacement_disk.with_name("original-app.retired")
        replacement_disk.rename(retired_again)
        aside.rename(replacement_disk)

    with subtest("item 6: rotate the repository password and the SFTP key as docs/secrets.md says, from the replacement"):
        app.start()
        app.wait_for_unit("multi-user.target")
        ok(fingerprint(app) == keep["replacement app key"], "item 6: the replacement is back")
        app.wait_until_succeeds("systemctl is-active terrace-production.target", timeout=300)
        address = " --address app --identity " + IDENTITY
        op("terrace-secrets rotate app backup/primary/repository-password --manual")
        ok("Added the new repository key" in op("terrace-secrets apply app backup/primary/repository-password" + address), "rotation: new repository key added")
        push("app")
        keys = json.loads(app.succeed("terrace-backup restic primary key list --json 2>/dev/null"))
        old_key = [k["id"] for k in keys if not k["current"]]
        ok(len(old_key) == 1, "rotation: one old repository key")
        ok("Removed 1 old repository key(s)" in op("terrace-secrets apply app backup/primary/repository-password --finish --only-current --remove " + old_key[0][:12] + address), "rotation: old repository key removed")
        op("terrace-secrets rotate app backup/primary/sftp-key --manual")
        new_public = op("terrace-secrets public app backup/primary/sftp-key").strip()
        ok(new_public != keep["app sftp public key"], "rotation: a new SFTP key")
        operator.succeed("echo " + shlex.quote(new_public) + " >>/home/restic/.ssh/authorized_keys")
        push("app")
        app.succeed("systemctl start terrace-backup.service", timeout=600)
        ok(state(app, "terrace-backup.service", "Result") == "success", "rotation: a backup with the new key and password")
        operator.succeed("grep -vxF " + shlex.quote(keep["app sftp public key"]) + " /home/restic/.ssh/authorized_keys >/root/authorized_keys.new"
                         " && install -o restic -g users -m 0600 /root/authorized_keys.new /home/restic/.ssh/authorized_keys && rm /root/authorized_keys.new")
        operator.fail("grep -qxF " + shlex.quote(keep["app sftp public key"]) + " /home/restic/.ssh/authorized_keys")
        ok(True, "rotation: the old SFTP public key removed at the repository")
        app.shutdown()

    with subtest("item 6: after the rotation the returning original can do nothing to the repository"):
        aside.unlink(missing_ok=True)
        replacement_disk.rename(aside)
        retired_again.rename(replacement_disk)
        before_return = operator_snapshots("repository", "app")
        app.start()
        app.wait_for_unit("multi-user.target")
        ok(fingerprint(app) == keep["original app key"], "item 6: the original again")
        app.wait_until_succeeds("systemctl is-active terrace-production.target", timeout=300)
        app.wait_until_fails("systemctl is-active --quiet terrace-backup.service", timeout=600)
        app.fail("systemctl start terrace-backup.service", timeout=600)
        ok("target primary: backup FAILED" in app.succeed("journalctl -u terrace-backup.service -o cat --no-pager"), "item 6: the original's backup fails after the rotation")
        ok(sorted(s["id"] for s in operator_snapshots("repository", "app")) == sorted(s["id"] for s in before_return), "item 6: the replacement's snapshots are untouched by it")
        app.shutdown()
        decisions["D6 app"] = "drill: the original's disk is deleted after the fencing check (synthetic; not the owner's decision)"
        replacement_disk.unlink()

    with subtest("stop owned guests"):
        operator.shutdown()
    # Labels carry names and counts only, never values.
    print("PROMOTION-CHECKS " + json.dumps(checks))
    print("PROMOTION-PROOF " + json.dumps({"assertions": len(checks), "seconds": round(time.time() - started_at, 2), "timings": timings, "records": records, "decisions": decisions}))
  '';
}
