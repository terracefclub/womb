            check6 = lines("step06-check-on-host", "relay")
            verify_line(relay.succeed(check6[0]), "relay step 6 worked")
            ok_run(relay, check6[1], "relay step 6 worked: the replacement marker is present")
        ok("delivered as a replacement" in relay.fail("terrace-production adopt --new 2>&1"), "relay step 6: adopt --new refused while the marker is present")

    with subtest("relay, steps 7 to 10 and 13: snapshot, read, restore, writers off, Headscale state before its first start"):
        newest = max(snapshots(relay, "relay"), key=lambda s: s["time"])
        ok(newest["id"] == keep["relay snapshot"] and newest["hostname"] == "relay", "relay step 7: the newest entry is the snapshot taken while it ran")
        decisions["D2 relay"] = "drill: accept snapshot " + newest["id"][:8] + ", not quiesced (synthetic; not the owner's decision)"
        ok_run(relay, lines("step08-read-data", "relay")[0], "relay step 8 worked", timeout=600)
        with timed("relay step 9"):
            sh(relay, block("step09-restore", "relay", {"<SNAPSHOT_ID>": newest["id"]}), timeout=600)
        report = relay.succeed(f"cat {RESTORE}/reconciliation.txt").strip().splitlines()
        records["relay reconciliation"] = report
        ok(report[-1] == "RECONCILIATION OK" and any(line.startswith("OK sqlite headscale: ") for line in report), "relay step 9 worked: an OK sqlite headscale line, then RECONCILIATION OK")
        ok(status(relay, "step10-status", "relay")[:2] == ["not adopted: no writer starts at boot", "inactive"], "relay step 10 worked")
        ok(state(relay, "headscale.service", "ActiveState") == "inactive", "relay step 10: Headscale never started")
        with timed("relay step 13"):
            sh(relay, block("step13-headscale", "relay"))
        ok(relay.succeed(text("step13-integrity", "relay")).strip() == "ok", "relay step 13 worked: PRAGMA integrity_check ok")
        ok(relay.succeed("cd /var/lib/headscale && sha256sum noise_private.key derp_server_private.key").strip() == keep["relay keys"], "item 1: Headscale private key hashes equal the original's")
        ok(relay.succeed(text("step13-owners", "relay")).split() == ["headscale:headscale"] * 3, "relay step 13: the ownership check the document adds passes")

    with subtest("relay, step 15: a failed adoption, the same command again, the held timers, also across a reboot"):
        adopt = lines("step15-adopt", "relay")[0]
        # A first adoption that fails after the target started: something else holds port 443, so nginx fails.
        relay.succeed("systemd-run --unit=drill-block-443 ${pkgs.python3}/bin/python3 -m http.server 443 --bind 0.0.0.0")
        relay.wait_until_succeeds("${pkgs.iproute2}/bin/ss -ltn | grep -q ':443 '")
        refused = ok_refused(relay, adopt + " 2>&1", "relay step 15: the first adoption fails while port 443 is taken", timeout=300)
        ok("not adopted yet" in refused and "nginx.service" in refused and ".timer" not in refused, "relay step 15: the failure names nginx, not a held timer")
        held(relay, "relay failed adoption", RELAY_HOLDS)
        ok(status(relay, "step10-status", "relay")[0] == "adoption as restored not finished", "relay: status reports the unfinished adoption")
        relay.succeed("systemctl stop drill-block-443.service")
        with timed("relay step 15"):
            out = relay.succeed(adopt, timeout=300)
        records["relay adopt output"] = out.strip().splitlines()
        ok(adopt_output(out, "relay step 15") == lines("step15-output-app", "relay")[:3], "relay step 15: the same command resumes; the first three lines of the documented output")
        held(relay, "relay resumed adoption", RELAY_HOLDS)
        ok(relay.execute("test -e /var/lib/terrace-secrets/replacement")[0] != 0, "relay: the host's replacement marker removed")
        ok("replacement marker is cleared" in push("relay", "relay"), "relay: the next push clears the store's replacement marker")
        relay.wait_for_unit("headscale.service")
        ok(sorted(user["name"] for user in json.loads(relay.succeed("headscale users list -o json"))) == relay_users, "item 1: Headscale users equal the original's")
        relay.shutdown()
        relay.start()
        relay.wait_for_unit("multi-user.target")
        relay.wait_until_succeeds("systemctl is-active terrace-production.target", timeout=300)
        relay.wait_for_unit("headscale.service")
        held(relay, "relay after a reboot", RELAY_HOLDS)
        ok(any(line.startswith("timers held after a restored adoption: ") for line in status(relay, "step10-status", "relay")), "relay after a reboot: status names the held group")

    with subtest("relay, steps 19 to 21 and D5"):
        ok_run(relay, text("step19-tls", "relay"), "relay step 19 worked: terrace-tls check exits 0", timeout=120)
        step20 = lines("step20-health", "relay")
        ok("0 loaded units listed." in relay.succeed(step20[0]), "relay step 20 worked: systemctl --failed lists none")
        ok_run(relay, step20[1], "relay step 20 worked: terrace-tls check", timeout=120)
        verify_line(relay.succeed(step20[2]), "relay step 20")
        age_rc, _ = relay.execute(step20[3])
        ok(age_rc == 1, f"relay step 20: terrace-backup age exits 1 before the first backup ({age_rc})")
        with timed("relay step 21"):
            out = sh(relay, block("step21-first-backup-and-arm", "relay"), timeout=600)
        armed = [lines("step21-output-app", "relay")[0], EVERY]
        ok(out.strip().splitlines()[-2:] == armed, "relay step 21 worked: the Armed line and every timer active")
        ok(relay.succeed("terrace-production arm-timers").strip().splitlines() == ["Already armed: nothing to arm.", EVERY], "relay step 21: arm-timers repeated")
        said = relay.succeed(text("relay-in-service", "relay")).strip().splitlines()
        ok(said == ["Already armed: nothing to arm.", "This role holds no timer until service (it has no sweep).", EVERY], "relay D5: arm-timers --in-service says the role holds nothing")
        d5 = lines("d5-relay", "relay")
        ok(not any("timers held" in line for line in relay.succeed(d5[0]).splitlines()), "relay D5 worked: status names no held timer")
        ok(relay.succeed(d5[1]).split() == ["active"] * 3, "relay D5 worked: three timers active")
        relay.shutdown()
        relay.start()
        relay.wait_for_unit("multi-user.target")
        relay.wait_until_succeeds("systemctl is-active terrace-production.target", timeout=300)
        ok(relay.succeed(d5[1]).split() == ["active"] * 3, "relay after a reboot: the armed timers stay armed")
        decisions["D5 relay"] = "drill: declared (synthetic; not the owner's decision)"
        relay.shutdown()

    # ---------------- Fencing: the original app comes back (item 6) ----------------

    SFTP_LOGIN = "echo ls | sftp -b - -i /run/secrets/backup/primary/sftp-key -o IdentitiesOnly=yes -o BatchMode=yes -o UserKnownHostsFile=/etc/terrace/backup/primary-known-hosts restic@operator 2>&1"
    FORGET = "terrace-backup restic primary forget --tag terrace --group-by host,tags --keep-last 1 --prune 2>&1"

    with subtest("item 6: before any rotation, the retired original boots and can still use the repository"):
        app.shutdown()
        replacement_disk = disk(app)
        aside = replacement_disk.with_name("replacement-app.aside")
        replacement_disk.rename(aside)
        retired.rename(replacement_disk)
        before_return = operator_snapshots("repository", "app")
        app.start()
        app.wait_for_unit("multi-user.target")
        ok(fingerprint(app) == keep["original app key"], "item 6: the original runs its old host key")
        app.wait_until_succeeds("systemctl is-active terrace-production.target", timeout=300)
        ok(state(app, "terrace-production-boot.service", "Result") == "success", "item 6 / step 2: the original's boot gate starts its writers again")
        ok(app.succeed("systemctl is-active " + " ".join(BACKUP_HELD + [SWEEP])).split() == ["active"] * 4, "item 6 / step 2: the reboot re-armed the backup, check, freshness and sweep timers")
        refused = ok_refused(operator, ENV + f"terrace-secrets push app --address app --identity {IDENTITY} 2>&1", "item 6: a push to the returning original is refused")
        ok("Host key verification failed" in refused, "item 6: refused by the pinned host key")
        settle_backup(app)
        # From here on the drill's own attempts are the only runs: its timer (re-armed by the boot, asserted above) is stopped.
        app.succeed("systemctl stop terrace-backup.timer")
        # What the old host can still do: the hazard section 2 warns about.
        ok_run(app, SFTP_LOGIN, "item 6 before rotation: SFTP login with its old key works")
        could_list = raw_snapshots(app)
        ok(len(terrace_group(could_list, "app")) >= 3, "item 6 before rotation: it lists the replacement's snapshots")
        ok_run(app, "terrace-backup restic primary forget --tag terrace --group-by host,tags --keep-last 1 --dry-run", "item 6 before rotation: a forget would run (dry run)")
        journal = own_backup_attempt(app, "item 6 before rotation: its backup succeeds into the repository", True)
        ok("target primary: backup succeeded in" in journal, "item 6 before rotation: that run's journal says it succeeded")
        after_return = operator_snapshots("repository", "app")
        newest = max(terrace_group(after_return, "app"), key=lambda s: s["time"])
        ok(newest["id"] not in [s["id"] for s in before_return], "item 6: the original's stale data is now the newest snapshot of the host name (`latest`)")
        records["replacement snapshots pruned by the returning original"] = len([s for s in before_return if s["id"] not in [t["id"] for t in after_return]])
        # Kept on the operator's tmpfs to show later that the old password no longer opens the repository.
        repository_password("app", "/dev/shm/old-repo-pass")
        app.shutdown()
        retired_again = replacement_disk.with_name("original-app.retired")
        replacement_disk.rename(retired_again)
        aside.rename(replacement_disk)

    with subtest("item 6: rotate the repository password (R7) and the SFTP key (R8) from the replacement"):
        place = {"<app address>": "app", "<key>": IDENTITY}
        app.start()
        app.wait_for_unit("multi-user.target")
        ok(fingerprint(app) == keep["replacement app key"], "item 6: the replacement is back")
        app.wait_until_succeeds("systemctl is-active terrace-production.target", timeout=300)
        ok(app.succeed("systemctl is-active " + " ".join(BACKUP_HELD + [SWEEP])).split() == ["active"] * 4, "the replacement after its last reboot: every timer armed")
        settle_backup(app)
        op(text("r7-rotate", "rotation"))
        ok("Added the new repository key" in op(text("r7-apply", "rotation", place)), "R7: new repository key added")
        op(text("r7-push", "rotation", place))
        keys = json.loads(app.succeed(text("r7-key-list", "rotation")))
        current = [k["id"] for k in keys if k["current"]]
        ok(len(keys) == 2 and len(current) == 1, "R7 checkpoint: two keys, one current")
        app.succeed(text("r7-backup", "rotation"), timeout=600)
        ok(app.succeed(text("r7-result", "rotation")).strip() == "success", "R7 checkpoint: a backup with the new password")
        ok("Removed 1 old repository key(s)" in op(text("r7-finish", "rotation", {**place, "<id> ...": current[0][:12]})), "R7: the old repository key removed")
        ok(len(json.loads(app.succeed("terrace-backup restic primary key list --json"))) == 1, "R7: one repository key left")
        old_public = op(text("r8-public", "rotation")).strip()
        ok(old_public == keep["app sftp public key"], "R8: the saved old public half")
        op(text("r8-rotate", "rotation"))
        new_public = op(text("r8-public", "rotation")).strip()
        ok(new_public != old_public, "R8: a new SFTP key")
        # Stand-in for the Storage Box console: enrol the new public half alongside the old one.
        operator.succeed("echo " + shlex.quote(new_public) + " >>/home/restic/.ssh/authorized_keys")
        op(text("r8-push", "rotation", place))
        app.succeed(text("r8-backup", "rotation"), timeout=600)
        ok(app.succeed(text("r8-result", "rotation")).strip() == "success", "R8: a backup with the new key")
        # Stand-in for the Storage Box console: remove the old public key.
        operator.succeed("grep -vxF " + shlex.quote(old_public) + " /home/restic/.ssh/authorized_keys >/root/authorized_keys.new"
                         " && install -o restic -g users -m 0600 /root/authorized_keys.new /home/restic/.ssh/authorized_keys && rm /root/authorized_keys.new")
        ok(operator.execute("grep -qxF " + shlex.quote(old_public) + " /home/restic/.ssh/authorized_keys")[0] != 0, "R8: the old public key removed at the repository")
        app.shutdown()

    with subtest("item 6: after the rotations the returning original is refused by the repository"):
        replacement_disk.rename(aside)
        retired_again.rename(replacement_disk)
        before_list = sorted(s["id"] for s in operator_snapshots("repository", "app"))
        before_data = repository_fingerprint("repository")
        app.start()
        app.wait_for_unit("multi-user.target")
        ok(fingerprint(app) == keep["original app key"], "item 6: the original again")
        app.wait_until_succeeds("systemctl is-active terrace-production.target", timeout=300)
        settle_backup(app)
        app.succeed("systemctl stop terrace-backup.timer")
        # Each refusal is shown on both ends. Client side: ssh's own error for the direct SFTP login (sshd here also offers
        # password methods, so the list after "publickey" varies); restic's own error for the restic commands. restic
        # relays ssh's message asynchronously and can exit before it is written (one run at 510b8d3 lost it), so for
        # them that line is recorded, not asserted. Server side: the repository host's sshd closes each session before
        # authentication.
        denied = re.compile(r"Permission denied \(publickey[,)]")
        restic_refused = "unable to start the sftp session"
        closed = "journalctl --no-pager -o cat | grep -c 'Connection closed by authenticating user restic .* \\[preauth\\]' || true"
        def server_closed(before_count, label):
            operator.wait_until_succeeds(f"test $({closed}) -gt {before_count}", timeout=30)
            ok(int(operator.succeed(closed).strip()) > before_count, label + ": the repository host's sshd closed it before authentication")
        server_before = int(operator.succeed(closed).strip())
        out = ok_refused(app, SFTP_LOGIN, "item 6 after rotation: SFTP login with the old key fails")
        ok(denied.search(out) is not None, "item 6 after rotation: ssh reports Permission denied (publickey...)")
        server_closed(server_before, "item 6 after rotation: SFTP login")
        for command, label in [("terrace-backup restic primary snapshots --json 2>&1", "listing snapshots"), (FORGET, "forget --prune")]:
            server_before = int(operator.succeed(closed).strip())
            out = ok_refused(app, command, f"item 6 after rotation: {label} fails")
            ok(restic_refused in out, f"item 6 after rotation: {label}: restic cannot start the SFTP session")
            records[f"returning original after rotation, {label}: ssh's message relayed by restic"] = denied.search(out) is not None
            server_closed(server_before, f"item 6 after rotation: {label}")
        server_before = int(operator.succeed(closed).strip())
        journal = own_backup_attempt(app, "item 6 after rotation: its backup fails", False)
        ok("target primary: backup FAILED" in journal and restic_refused in journal, "item 6 after rotation: that run's journal says FAILED, restic cannot start the SFTP session")
        records["returning original after rotation, backup: ssh's message relayed by restic"] = denied.search(journal) is not None
        server_closed(server_before, "item 6 after rotation: its backup")
        # The operator's own check, not the old host's (which never gets past SSH): the old password opens nothing.
        out = ok_refused(operator, "restic --no-lock --no-cache -r /home/restic/repository --password-file /dev/shm/old-repo-pass cat config 2>&1", "item 6 after rotation: the old repository password no longer opens the repository")
        ok("wrong password" in out.lower(), "item 6 after rotation: refused as a wrong password")
        operator.succeed("rm -f /dev/shm/old-repo-pass")
        ok(sorted(s["id"] for s in operator_snapshots("repository", "app")) == before_list, "item 6: the snapshot list is unchanged")
        ok(repository_fingerprint("repository") == before_data, "item 6: every repository file is unchanged")
        app.shutdown()
        decisions["D6 app"] = "drill: the original's disk is deleted after the fencing check (synthetic; not the owner's decision)"
        replacement_disk.unlink()

    with subtest("the drill used the documents' commands in their order"):
        for role in ["app", "relay", "rotation"]:
            firsts: list[str] = []
            for who, name in used:
                if who == role and name not in firsts:
                    firsts.append(name)
            order = [INDEX[name] for name in firsts]
            ok(order == sorted(order), f"{role}: documented entries first used in the documents' order")
        unused = [e["name"] for e in C["entries"] if e["name"] not in {name for _, name in used}]
        ok(unused == [], f"every documented entry was used ({unused})")
        ok(all(ENTRY[name]["document"] == PROMOTION for who, name in used if who in ["app", "relay"]), "the procedure's roles used only the procedure's entries")
        ok(all(ENTRY[name]["document"] != PROMOTION for who, name in used if who == "rotation"), "the rotation used only the rotation document's entries")

    with subtest("stop owned guests"):
        operator.shutdown()
    # Labels carry names and counts only, never values.
    print("PROMOTION-CHECKS " + json.dumps(checks))
    print("PROMOTION-PROOF " + json.dumps({"assertions": len(checks), "seconds": round(time.time() - started_at, 2), "timings": timings, "records": records, "decisions": decisions}))
  '';
}
