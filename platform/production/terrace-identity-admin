def env_digest(pid, variable):
    try:
        environ = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
    except OSError:
        return None
    for item in environ:
        if item.startswith(variable.encode() + b"="):
            return hashlib.sha256(item).hexdigest()
    return None


def consumers_current(consumers, value):
    stale = []
    for consumer in consumers:
        pid = subprocess.run(["systemctl", "show", consumer["unit"], "-p", "MainPID", "--value"], capture_output=True).stdout.decode().strip()
        if not pid.isdigit() or pid == "0":
            continue  # not running (for example before the first migration): it reads the file when it starts
        if env_digest(pid, consumer["variable"]) != hashlib.sha256(f"{consumer['variable']}={value}".encode()).hexdigest():
            stale.append(consumer["unit"])
    return sorted(set(stale))


def cmd_client_secret(config, args):
    realm = config["realm"]
    entry = config["clientSecrets"].get(args.client)
    if entry is None:
        raise Refused(f"{args.client} is not a confidential client with a delivered secret ({', '.join(sorted(config['clientSecrets']))})")
    delivered = read_private(Path(entry["file"]).resolve(), HEX64_RE)
    if delivered is None:
        raise Refused(f"no delivered secret for {args.client}; run `terrace-secrets push` first")
    api = login(config, args)
    client = api.client(realm, args.client)
    if client is None:
        raise Refused(f"no client {args.client} in {realm}")
    current = api.get(f"{realm}/clients/{client['id']}/client-secret").get("value", "")
    target = f"{realm}/client/{args.client}/secret"
    stale = consumers_current(entry["consumers"], delivered)
    if current == delivered:
        audit("client-secret-sync", target, "already-current", args.admin)
        print(f"{args.client}: Keycloak already has the delivered secret. Nothing changed in Keycloak.")
    elif args.dry_run:
        print(f"would set the {args.client} secret in Keycloak to the delivered value, verify the old one is refused,"
              f" and restart consumers not yet on it: {', '.join(stale) or 'none'}")
        audit("client-secret-sync", target, "dry-run", args.admin)
        return
    else:
        full = api.get(f"{realm}/clients/{client['id']}")
        full["secret"] = delivered
        api.call("PUT", f"{realm}/clients/{client['id']}", full)
        if not client_accepts(config["base"], realm, args.client, delivered):
            raise Refused(f"Keycloak does not accept the delivered {args.client} secret after the change")
        if current and client_accepts(config["base"], realm, args.client, current):
            raise Refused(f"Keycloak still accepts the previous {args.client} secret")
        audit("client-secret-sync", target, "done", args.admin)
        print(f"{args.client}: Keycloak now uses the delivered secret; the previous one is refused.")
    if stale:
        if args.dry_run:
            print(f"would restart (not yet on the delivered value): {', '.join(stale)}")
            return
        for unit in stale:
            systemctl("restart", unit)
        audit("client-secret-consumers-restart", target, "done", args.admin)
        print(f"Restarted {', '.join(stale)} onto the delivered value.")
    still = consumers_current(entry["consumers"], delivered)
    if still:
        raise Refused(f"still not on the delivered value: {', '.join(still)}")
    print(f"Consumers on the delivered value: {', '.join(c['unit'] for c in entry['consumers'])}.")


