def definition_path(config, args):
    path = Path(getattr(args, "definition", None) or config["definition"])
    info = os.stat(path)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise Refused("the realm definition must be a root-owned file nobody else can write")
    return path


def contract_roles(config):
    definition = json.loads(Path(config["definition"]).read_text())
    return [role["name"] for role in definition.get("roles", {}).get("realm", [])]


