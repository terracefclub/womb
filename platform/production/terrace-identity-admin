#!/usr/bin/env python3
"""terrace-identity-admin: administer the production Keycloak over its loopback backend.

Runs as root on the production app host only (installed as a root-only wrapper). It talks to
Keycloak at 127.0.0.1:8088 and never through the public proxy, which keeps denying the
administration and master-realm paths. No password, client secret or token is ever printed,
logged or passed as a command argument: passwords come from the terminal or stdin, generated
ones go to root-only files on tmpfs, tokens stay in this process's memory. Every state change
writes one journal line (identifier terrace-identity-admin) naming the operator, the Keycloak
administrator, the action and the target. See docs/identity-admin.md.
"""
import argparse
import base64
import fcntl
import getpass
import hashlib
import http.client
import json
import os
import pwd
import re
import resource
import secrets as token
import signal
import stat
import subprocess
import sys
import syslog
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

CONFIG = Path("/etc/terrace/identity-admin.json")
RUN = Path("/run/terrace-identity-admin")
DELIVERED = RUN / "bootstrap-admin-password"
HANDOFF = RUN / "handoff"
KC_BOOT = RUN / "kc-bootstrap"
LOCK = RUN / "lock"
BOOTSTRAP_USER = "terrace-bootstrap"
RECOVERY_PREFIX = "terrace-recovery-"
INITIAL_LABEL = "terrace-initial"
USERNAME_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{2,63}$")
EMAIL_RE = re.compile(r"^[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+$")
NAME_RE = re.compile(r"^[^\x00-\x1f\x7f]{1,120}$")
HEX64_RE = re.compile(r"^[0-9a-f]{64}$")
OAUTH_ERROR_RE = re.compile(r"^[a-z_]{1,40}$")
# What Keycloak answers when it refuses credentials (as opposed to failing in some other way).
GRANT_REFUSALS = ("invalid_grant", "unauthorized_client", "invalid_client")
# A failed client authentication at the introspection endpoint (Keycloak 26.8 answers 401 invalid_client).
CLIENT_REFUSALS = ("invalid_client", "unauthorized_client")
SHA_RE = re.compile(r"^[0-9a-f]{64}$")
CLIENT_RE = re.compile(r"^[a-z][a-z0-9-]{1,63}$")
MEMBER_ROLES = ("current-member", "alumni")
EDITORIAL_ADMIN = "editorial-admin"
MAX_BODY = 4 * 1024 * 1024
EXIT_REFUSED = 1
EXIT_PLAN_REFUSED = 3


class Refused(Exception):
    """A fixed, value-free message for the operator."""


# ---- identity of the person at the keyboard and the audit line ------------

def operator():
    """The login account behind this root process (SSH login uid), else sudo's caller, else root."""
    try:
        uid = int(Path("/proc/self/loginuid").read_text().strip())
        if uid != 4294967295:
            return pwd.getpwuid(uid).pw_name
    except (OSError, ValueError, KeyError):
        pass
    caller = os.environ.get("SUDO_USER", "")
    return caller if re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", caller) else "root"


def field(value):
    return re.sub(r"[^A-Za-z0-9._/@:+-]", "_", str(value))[:200] or "-"


def audit(action, target, result, admin="-"):
    """One journal line per state change (and per refusal or dry run): names and targets, never values."""
    line = f"operator={field(operator())} admin={field(admin)} action={field(action)} target={field(target)} result={field(result)}"
    syslog.openlog("terrace-identity-admin", 0, syslog.LOG_AUTH)
    syslog.syslog(syslog.LOG_NOTICE, line)
    syslog.closelog()


# ---- private files on tmpfs -----------------------------------------------

def memory_filesystem(path):
    try:
        mounts = Path("/proc/self/mountinfo").read_text().splitlines()
    except OSError:
        return False
    target = os.path.realpath(path)
    best, kind = "", None
    for line in mounts:
        left, right = line.split(" - ", 1)
        point = left.split()[4].replace("\\040", " ")
        if (target == point or target.startswith(point.rstrip("/") + "/")) and len(point) >= len(best):
            best, kind = point, right.split()[0]
    return kind in ("tmpfs", "ramfs")


def private_dir(path):
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chown(path, 0, 0)
    os.chmod(path, 0o700)
    if not memory_filesystem(path):
        raise Refused(f"{path} is not on a memory filesystem; refusing to write a credential there")
    return path


def write_private(path, value):
    """Root 0400 on tmpfs, replaced atomically; the value never reaches a disk or an argument."""
    private_dir(path.parent)
    tmp = path.with_name("." + path.name + ".new")
    if tmp.exists():
        tmp.unlink()
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o400)
    try:
        os.write(fd, value.encode())
    finally:
        os.close(fd)
    os.replace(tmp, path)


def read_private(path, pattern=None):
    """A credential file root wrote: regular, root-owned, not readable by anyone else."""
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        return None
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o077:
        raise Refused(f"{path} must be a regular root-only file")
    value = Path(path).read_text().strip()
    if pattern is not None and not pattern.fullmatch(value):
        raise Refused(f"{path} does not hold a value of the expected format")
    return value


def remove(path):
    try:
        Path(path).unlink()
    except FileNotFoundError:
        pass


def handoff_path(realm, username):
    return HANDOFF / f"{realm}-{username}.password"


# ---- configuration --------------------------------------------------------

def load_config(path=CONFIG):
    info = os.stat(path)
    if info.st_uid != 0 or info.st_mode & 0o022:
        raise Refused(f"{path} must be root-owned and not writable by others")
    config = json.loads(Path(path).read_text())
    base = urllib.parse.urlsplit(config["base"])
    if base.scheme != "http" or base.hostname != "127.0.0.1" or config["realm"] != "terrace":
        raise Refused("the configuration must point at the loopback Keycloak backend and the terrace realm")
    return config


# ---- HTTP to the loopback backend -----------------------------------------

class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *_args, **_kwargs):
        return None


OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())


def http(url, method="GET", body=None, headers=None, timeout=30):
    """(status, raw body). Never raises with a response body or URL in the message."""
    request = urllib.request.Request(url, data=body, headers=headers or {}, method=method)
    try:
        response = OPENER.open(request, timeout=timeout)
    except urllib.error.HTTPError as error:
        response = error
    except (urllib.error.URLError, OSError):
        raise Refused("Keycloak is not answering on its loopback backend")
    try:
        with response:
            data = response.read(MAX_BODY + 1)
    except (http.client.HTTPException, OSError):
        raise Refused("Keycloak's answer was cut off")
    if len(data) > MAX_BODY:
        raise Refused("Keycloak answered with an oversized body")
    return response.status, data


def oauth_error(data):
    """The OAuth error code of a refusal body, or None; never any other text from the body."""
    try:
        error = json.loads(data).get("error")
    except (ValueError, AttributeError):
        return None
    return error if isinstance(error, str) and OAUTH_ERROR_RE.match(error) else None


def password_grant(base, username, password):
    """True when Keycloak accepts the master admin-cli password grant, False when it refuses the
    credentials (HTTP 400/401 with an OAuth refusal); anything else is an error, not a refusal."""
    form = urllib.parse.urlencode({"client_id": "admin-cli", "grant_type": "password", "username": username, "password": password}).encode()
    status, data = http(base + "/realms/master/protocol/openid-connect/token", "POST", form, {"Content-Type": "application/x-www-form-urlencoded"})
    if status == 200:
        # A verification only: end the session it opened.
        try:
            refresh = json.loads(data).get("refresh_token")
            if refresh:
                http(base + "/realms/master/protocol/openid-connect/logout", "POST",
                     urllib.parse.urlencode({"client_id": "admin-cli", "refresh_token": refresh}).encode(),
                     {"Content-Type": "application/x-www-form-urlencoded"})
        except (Refused, ValueError, AttributeError):
            pass
        return True
    error = oauth_error(data)
    if status in (400, 401) and error in GRANT_REFUSALS:
        return False
    raise Refused(f"unexpected answer to a password grant for {username} (HTTP {status}, {error or 'no OAuth error'})")


SESSIONS = []


class Keycloak:
    """Admin REST API as one named administrator. The token lives only in this object."""

    def __init__(self, base, admin, password):
        self.base = base.rstrip("/")
        self.admin = admin
        self._password = password
        self._token = None
        self._refresh = None
        status, error = self.grant()
        if status != 200:
            if status in (400, 401) and error in GRANT_REFUSALS:
                raise Refused(f"authentication as {admin} failed (wrong password, disabled, locked out or unknown account)")
            raise Refused(f"authentication as {admin}: unexpected answer (HTTP {status}, {error or 'no OAuth error'})")
        SESSIONS.append(self)

    def grant(self, refresh=False):
        form = {"client_id": "admin-cli"}
        if refresh and self._refresh:
            form.update(grant_type="refresh_token", refresh_token=self._refresh)
        else:
            form.update(grant_type="password", username=self.admin, password=self._password)
        status, data = http(self.base + "/realms/master/protocol/openid-connect/token", "POST",
                            urllib.parse.urlencode(form).encode(), {"Content-Type": "application/x-www-form-urlencoded"})
        if status == 200:
            body = json.loads(data)
            self._token, self._refresh = body["access_token"], body.get("refresh_token")
        return status, oauth_error(data)

    def logout(self):
        """End this administrator session (each run opens one with its password grant)."""
        if self._refresh:
            http(self.base + "/realms/master/protocol/openid-connect/logout", "POST",
                 urllib.parse.urlencode({"client_id": "admin-cli", "refresh_token": self._refresh}).encode(),
                 {"Content-Type": "application/x-www-form-urlencoded"})
        self._token = self._refresh = self._password = None

    def call(self, method, path, body=None, text=None, expect=(200, 201, 204)):
        headers = {"Authorization": "Bearer " + self._token}
        payload = None
        if body is not None:
            payload = json.dumps(body).encode()
            headers["Content-Type"] = "application/json"
        elif text is not None:
            payload = text.encode()
            headers["Content-Type"] = "text/plain"
        url = self.base + "/admin/realms/" + path
        status, data = http(url, method, payload, headers)
        if status == 401 and (self.grant(refresh=True)[0] == 200 or self.grant()[0] == 200):
            headers["Authorization"] = "Bearer " + self._token
            status, data = http(url, method, payload, headers)
        if status not in expect:
            # The path names realm objects only (ids, names), never a value.
            raise Refused(f"Keycloak refused {method} {path.split('?')[0]} (HTTP {status})")
        return json.loads(data) if data else None

    def get(self, path):
        return self.call("GET", path)

    def paged(self, path):
        items, first = [], 0
        joiner = "&" if "?" in path else "?"
        while True:
            page = self.get(f"{path}{joiner}first={first}&max=200")
            items += page
            if len(page) < 200:
                return items
            first += 200

    def user(self, realm, username):
        found = self.get(f"{realm}/users?" + urllib.parse.urlencode({"username": username, "exact": "true"}))
        found = [user for user in found if user["username"] == username]
        return found[0] if found else None

    def role(self, realm, name):
        return self.call("GET", f"{realm}/roles/{urllib.parse.quote(name)}", expect=(200,))

    def role_holders(self, realm, name):
        return self.paged(f"{realm}/roles/{urllib.parse.quote(name)}/users")

    def realm_roles(self, realm, user_id):
        return sorted(role["name"] for role in self.get(f"{realm}/users/{user_id}/role-mappings/realm"))

    def client(self, realm, client_id):
        found = [c for c in self.get(f"{realm}/clients?" + urllib.parse.urlencode({"clientId": client_id})) if c["clientId"] == client_id]
        return found[0] if found else None


def client_accepts(base, realm, client_id, secret):
    """True when Keycloak authenticates the client with SECRET (token introspection, Basic auth)."""
    credentials = base64.b64encode(f"{urllib.parse.quote(client_id)}:{urllib.parse.quote(secret)}".encode()).decode()
    status, data = http(f"{base}/realms/{realm}/protocol/openid-connect/token/introspect", "POST",
                     urllib.parse.urlencode({"token": "terrace-identity-admin-probe"}).encode(),
                     # The realm requires TLS; on loopback Keycloak trusts the proxy's scheme header (proxy-trusted-addresses).
                     {"Content-Type": "application/x-www-form-urlencoded", "Authorization": "Basic " + credentials, "X-Forwarded-Proto": "https"})
    if status == 200:
        return True
    error = oauth_error(data)
    if status in (400, 401) and error in CLIENT_REFUSALS:
        return False
    raise Refused(f"client authentication probe for {client_id}: unexpected answer (HTTP {status}, {error or 'no OAuth error'})")


# ---- reading passwords ----------------------------------------------------

_STDIN = []


def stdin_lines():
    """stdin read once (bounded) and consumed line by line across prompts."""
    if not _STDIN:
        _STDIN.append(sys.stdin.read(8192).split("\n"))
    return _STDIN[0]


def read_passwords(args, prompts):
    """Values from the terminal (no echo) or, with --password-stdin, one per stdin line."""
    if getattr(args, "password_stdin", False):
        lines = stdin_lines()
        if len(lines) < len(prompts) or any(not line for line in lines[:len(prompts)]):
            raise Refused(f"--password-stdin expects {len(prompts)} more non-empty line(s)")
        values = lines[:len(prompts)]
        del lines[:len(prompts)]
    else:
        if not sys.stdin.isatty():
            raise Refused("no terminal to ask for a password; use --password-stdin")
        try:
            values = [getpass.getpass(prompt) for prompt in prompts]
        except (EOFError, KeyboardInterrupt):
            raise Refused("no password given")
    for value in values:
        if not 12 <= len(value) <= 256 or any(ord(ch) < 32 or ord(ch) == 127 for ch in value):
            raise Refused("a password must be 12 to 256 printable characters")
    return values


def new_password_value(args, label):
    """(value, handoff file or None): typed twice, or generated into a root-only tmpfs file."""
    if getattr(args, "set_password", False):
        prompts = [f"New {label} password: "] if getattr(args, "password_stdin", False) else [f"New {label} password: ", "Again: "]
        values = read_passwords(args, prompts)
        if len(values) == 2 and values[0] != values[1]:
            raise Refused("the two passwords differ")
        if len(values[0]) < 16:
            raise Refused("a new password must have at least 16 characters")
        return values[0], None
    return token.token_urlsafe(24), True


def login(config, args, allow_initial=False):
    """Authenticate as a named administrator; refuse one who still has an initial password."""
    admin = args.admin
    if not USERNAME_RE.match(admin):
        raise Refused("--admin must be a Keycloak administrator username")
    password = read_passwords(args, [f"Password for Keycloak administrator {admin}: "])[0]
    api = Keycloak(config["base"], admin, password)
    if not allow_initial:
        me = api.user("master", admin)
        if me is not None and initial_password(api, me["id"]):
            raise Refused(f"{admin} still has an initial password; run `terrace-identity-admin password --admin {admin}` first")
    if HARDEN:
        # Converge the master realm's hardening whenever an administrator signs in for a state change
        # (first-admin may have been interrupted before it applied it). A dry run changes nothing: it says so.
        if getattr(args, "dry_run", False):
            missing = secure_master(api, apply=False)
            if missing:
                audit("master-secure", "master/brute-force+events", "dry-run", admin)
                print(f"Master realm hardening is incomplete; without --dry-run this would turn on: {', '.join(missing)}.")
        else:
            changed = secure_master(api)
            if changed:
                audit("master-secure", "master/brute-force+events", "done", admin)
                print(f"Master realm hardening was incomplete; turned on: {', '.join(changed)}.")
    return api


def initial_password(api, user_id):
    return any(cred.get("type") == "password" and cred.get("userLabel") == INITIAL_LABEL
               for cred in api.get(f"master/users/{user_id}/credentials"))


# ---- systemd, database and the bootstrap unit -----------------------------

def systemctl(*argv, check=True, timeout=600):
    result = subprocess.run(["systemctl", *argv], capture_output=True, timeout=timeout)
    if check and result.returncode != 0:
        raise Refused(f"systemctl {argv[0]} {argv[-1]} failed (exit {result.returncode})")
    return result.returncode


def master_users():
    """[(username, enabled)] of the master realm, read from the database (no Keycloak login needed)."""
    sql = ("select u.username, u.enabled from user_entity u join realm r on r.id = u.realm_id "
           "where r.name = 'master' and u.service_account_client_link is null order by u.username")
    result = subprocess.run(["runuser", "-u", "postgres", "--", "psql", "-XAt", "-v", "ON_ERROR_STOP=1", "-d", "keycloak", "-c", sql],
                            capture_output=True, timeout=60)
    if result.returncode != 0:
        raise Refused("could not read the master realm accounts from the keycloak database")
    users = []
    for line in result.stdout.decode().splitlines():
        name, _, enabled = line.partition("|")
        users.append((name, enabled == "t"))
    return users


def reserved(username):
    return username == BOOTSTRAP_USER or username.startswith(RECOVERY_PREFIX)


def keycloak_ready(config, deadline=360):
    """Wait until Keycloak runs and reports database-aware readiness again."""
    until = time.monotonic() + deadline
    while time.monotonic() < until:
        if subprocess.run(["systemctl", "is-active", "--quiet", "keycloak.service"]).returncode == 0:
            try:
                status, data = http(config["management"] + "/health/ready", timeout=5)
                if status == 200 and json.loads(data).get("status") == "UP":
                    return True
            except (Refused, ValueError):
                pass
        time.sleep(2)
    return False


def unit_busy(unit):
    """True while the unit has a queued job or is starting or stopping (or the question cannot be answered)."""
    result = subprocess.run(["systemctl", "show", unit, "-p", "Job", "-p", "ActiveState"], capture_output=True, timeout=60)
    if result.returncode != 0:
        return True
    values = dict(line.split("=", 1) for line in result.stdout.decode().splitlines() if "=" in line)
    return values.get("Job", "") not in ("", "0") or values.get("ActiveState") in ("activating", "deactivating", "reloading")


def run_unit(unit, deadline=600):
    """Start the bootstrap unit and return 0 when THIS run succeeded. The unit's ExecStopPost writes
    "<nonce> <result>" next to the nonce written here; neither the systemctl client (a hangup can kill it
    while the job runs on) nor the unit's properties (an inactive oneshot unit may be unloaded) are trusted."""
    nonce = token.token_hex(8)
    remove(KC_BOOT / "result")
    write_private(KC_BOOT / "nonce", nonce)
    try:
        started = any(subprocess.run(["systemctl", "start", "--no-block", unit], capture_output=True, timeout=60).returncode == 0 for _ in range(2))
        if not started and not unit_busy(unit):
            return 1  # never enqueued (a killed client may still have enqueued it: then it is busy)
        until = time.monotonic() + deadline
        idle = 0
        while time.monotonic() < until:
            try:
                recorded, _, result = (KC_BOOT / "result").read_text().strip().partition(" ")
            except FileNotFoundError:
                recorded = result = ""
            if recorded == nonce:
                return 0 if result == "success" else 1
            # A unit that never started (failed dependency, unmet condition, start limit) runs no
            # ExecStopPost and writes no result: give up once it is idle with no job for 15 seconds.
            busy = unit_busy(unit)
            idle = 0 if busy else idle + 1
            if idle >= 15:
                return 1
            time.sleep(1)
        return 1
    finally:
        remove(KC_BOOT / "nonce")
        remove(KC_BOOT / "result")


def run_bootstrap(config, username, password):
    """Create a temporary master administrator with Keycloak's own recovery command while Keycloak is
    stopped (upstream requires every node stopped). The whole window runs inside systemd: the bootstrap
    unit conflicts with Keycloak, so starting it stops Keycloak, and its ExecStopPost (run by systemd
    whatever happens to this process) removes the credential files and starts Keycloak again. This
    process (and the systemctl it runs) ignores hangups for every state-changing command and holds
    interrupt and termination signals for the window. The password reaches the unit only as a credential file."""
    private_dir(KC_BOOT)
    write_private(KC_BOOT / "username", username)
    write_private(KC_BOOT / "password", password)
    unit = config["bootstrapUnit"]
    window = {signal.SIGINT, signal.SIGTERM}
    signal.pthread_sigmask(signal.SIG_BLOCK, window)
    try:
        code = run_unit(unit)
        # After a failed run, do not wait for a Keycloak that maybe nobody is starting: restart it below.
        ready = keycloak_ready(config) if code == 0 else False
    finally:
        remove(KC_BOOT / "password")
        remove(KC_BOOT / "username")
        signal.pthread_sigmask(signal.SIG_UNBLOCK, window)
    if code != 0 or not ready:
        # If the unit never started, systemd ran no ExecStopPost: start Keycloak here too (idempotent).
        systemctl("reset-failed", unit, check=False)
        systemctl("reset-failed", "keycloak.service", check=False)
        systemctl("start", "--no-block", "keycloak.service", check=False)
        ready = keycloak_ready(config)
        state = "Keycloak is running and ready again" if ready else "Keycloak is NOT ready: check `systemctl status keycloak` now"
        raise Refused(("Keycloak's bootstrap-admin command did not succeed; " if code != 0 else "Keycloak did not become ready after the bootstrap command; ") + state)


def label_initial(api, user_id):
    for cred in api.get(f"master/users/{user_id}/credentials"):
        if cred.get("type") == "password":
            api.call("PUT", f"master/users/{user_id}/credentials/{cred['id']}/userLabel", text=INITIAL_LABEL)
            return
    raise Refused("the new administrator has no password credential")


def set_initial_password(api, args, user_id):
    """Set an initial password (labelled: it must be changed before use). A generated one is written to
    its handoff file BEFORE Keycloak gets it, so a crash never leaves a password nobody has."""
    value, generated = new_password_value(args, f"Keycloak administrator {args.username}")
    if generated:
        write_private(handoff_path("master", args.username), value + "\n")
    api.call("PUT", f"master/users/{user_id}/reset-password", {"type": "password", "value": value, "temporary": False})
    label_initial(api, user_id)
    if generated:
        return value, f"initial password in {handoff_path('master', args.username)} (root-only, tmpfs); hand it over privately, then delete the file"
    return value, "initial password as typed"


def ensure_master_admin(api, config, args):
    """Create, or repair after an interrupted run, a named administrator, and PROVE it: it signs in with
    the password we hold and has the admin role. Raises (keeping whatever bootstrap account exists) otherwise."""
    user = api.user("master", args.username)
    if user is None:
        api.call("POST", "master/users", {
            "username": args.username, "email": args.email, "firstName": args.first_name, "lastName": args.last_name,
            "enabled": True, "emailVerified": True,
        })
        user = api.user("master", args.username)
        if user is None:
            raise Refused("Keycloak did not return the created administrator")
    else:
        # Repair only what this tool leaves half done: no password yet, or still its initial one.
        passwords = [c for c in api.get(f"master/users/{user['id']}/credentials") if c.get("type") == "password"]
        if passwords and not any(c.get("userLabel") == INITIAL_LABEL for c in passwords):
            audit("admin-repair", f"master/user/{args.username}", "refused-own-password")
            raise Refused(f"{args.username} already has a password of its own; it is not changed, enabled or granted anything here. "
                          f"If it is your working administrator, finish with `terrace-identity-admin break-glass end --admin {args.username}` "
                          f"(removes the bootstrap account); otherwise investigate the account. The bootstrap account is kept.")
    if not user.get("enabled"):
        user["enabled"] = True
        api.call("PUT", f"master/users/{user['id']}", user)
    held = read_private(handoff_path("master", args.username))
    if held is not None and not getattr(args, "set_password", False) and password_grant(config["base"], args.username, held):
        value, note = held, f"initial password kept in {handoff_path('master', args.username)}"
        label_initial(api, user["id"])
    else:
        value, note = set_initial_password(api, args, user["id"])
    if "admin" not in api.realm_roles("master", user["id"]):
        api.call("POST", f"master/users/{user['id']}/role-mappings/realm", [api.role("master", "admin")])
    if not password_grant(config["base"], args.username, value) or "admin" not in api.realm_roles("master", user["id"]):
        raise Refused(f"{args.username} cannot sign in or lacks the admin role; the bootstrap account is kept")
    return note


MASTER_BRUTE_FORCE = {"bruteForceProtected": True, "permanentLockout": False, "failureFactor": 5, "waitIncrementSeconds": 60,
                      "maxFailureWaitSeconds": 900, "maxDeltaTimeSeconds": 43200, "quickLoginCheckMilliSeconds": 1000,
                      "minimumQuickLoginWaitSeconds": 60}
MASTER_EVENTS = {"adminEventsEnabled": True, "adminEventsDetailsEnabled": False}


def secure_master(api, apply=True):
    """Master realm: brute-force protection for administrator passwords (any local process can attempt
    a password grant on the loopback backend) and admin events without representations. Idempotent;
    returns what it changed (empty when already in place). With apply=False it only reads, and returns
    what it would change."""
    changed = []
    realm = api.get("master")
    if any(realm.get(key) != value for key, value in MASTER_BRUTE_FORCE.items()):
        if apply:
            realm.update(MASTER_BRUTE_FORCE)
            api.call("PUT", "master", realm)
        changed.append("brute-force protection")
    events = api.get("master/events/config")
    if any(events.get(key) != value for key, value in MASTER_EVENTS.items()):
        if apply:
            events.update(MASTER_EVENTS)
            api.call("PUT", "master/events/config", events)
        changed.append("admin events")
    return changed


def master_hardening():
    """(brute-force protection on, admin events on) for the master realm, read from the database (no login)."""
    sql = ("select coalesce((select a.value from realm_attribute a where a.realm_id = r.id and a.name = 'bruteForceProtected'), 'false'), "
           "r.admin_events_enabled from realm r where r.name = 'master'")
    result = subprocess.run(["runuser", "-u", "postgres", "--", "psql", "-XAt", "-v", "ON_ERROR_STOP=1", "-d", "keycloak", "-c", sql],
                            capture_output=True, timeout=60)
    if result.returncode != 0:
        raise Refused("could not read the master realm settings from the keycloak database")
    brute, _, events = result.stdout.decode().strip().partition("|")
    return brute == "true", events == "t"


