    user = api.user(realm, args.username)
    if args.action == "create":
        validate_person(args)
        wanted = args.role or []
        for role in wanted:
            if role not in roles or role in MEMBER_ROLES:
                raise Refused(f"{role}: create site staff with editorial roles only ({', '.join(r for r in roles if r not in MEMBER_ROLES)}); "
                              "member accounts follow the website's approval and provisioning")
        if user is not None:
            print(f"{args.username} already exists; password and roles unchanged (use grant/revoke). Nothing changed.")
            return
