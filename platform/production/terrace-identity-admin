        if user is None:
            raise Refused("Keycloak did not return the created user")
        if wanted:
            api.call("POST", f"{realm}/users/{user['id']}/role-mappings/realm", [api.role(realm, role) for role in wanted])
        if generated:
            write_private(handoff_path(realm, args.username), value + "\n")
        audit("user-create", target, "done", args.admin)
        print(f"Created {args.username} in {realm} with roles: {', '.join(wanted) or 'none'}; the password must be changed at first sign-in.")
        if generated:
            print(f"Temporary password in {handoff_path(realm, args.username)} (root-only, tmpfs): hand it over privately, then delete the file.")
        return
    if user is None:
        raise Refused(f"no user {args.username} in {realm}")
    have = api.realm_roles(realm, user["id"])
    if args.action in ("grant", "revoke"):
        if args.role not in roles:
            raise Refused(f"{args.role} is not a role of the identity contract ({', '.join(roles)})")
        if args.role in MEMBER_ROLES:
            raise Refused(f"{args.role} is a member role: members are granted and offboarded through the website's approval flow, not here")
        target += f"/role/{args.role}"
        if (args.role in have) == (args.action == "grant"):
            print(f"{args.username} {'already has' if args.action == 'grant' else 'does not have'} {args.role}. Nothing changed.")
            return
    if args.action in ("revoke", "disable") and EDITORIAL_ADMIN in have and (args.action == "disable" or args.role == EDITORIAL_ADMIN):
        refuse_unreliable_count(api, realm, EDITORIAL_ADMIN, "user-" + args.action, target, args.admin)
        holders = [u["username"] for u in api.role_holders(realm, EDITORIAL_ADMIN) if u.get("enabled")]
        if holders == [args.username]:
            audit("user-" + args.action, target, "refused-last-admin", args.admin)
            raise Refused(f"{args.username} is the last enabled {EDITORIAL_ADMIN}; grant it to someone else first")
    if args.action == "disable" and not user.get("enabled"):
        print(f"{args.username} is already disabled. Nothing changed.")
        return
    end_sessions = args.action == "disable" or (args.action == "revoke" and not args.keep_sessions)
    if args.dry_run:
        print(f"would {args.action} {args.role or args.username}" + (" and end the user's sessions" if end_sessions else ""))
        audit("user-" + args.action, target, "dry-run", args.admin)
        return
    if args.action == "grant":
        api.call("POST", f"{realm}/users/{user['id']}/role-mappings/realm", [api.role(realm, args.role)])
    elif args.action == "revoke":
        api.call("DELETE", f"{realm}/users/{user['id']}/role-mappings/realm", [api.role(realm, args.role)])
    else:
        user["enabled"] = False
        api.call("PUT", f"{realm}/users/{user['id']}", user)
    if end_sessions:
        api.call("POST", f"{realm}/users/{user['id']}/logout")
    audit("user-" + args.action, target, "done", args.admin)
    print(f"{args.action.capitalize()} done for {args.username}" + (" (sessions ended)." if end_sessions else "."))


