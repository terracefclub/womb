def cmd_first_admin(config, args):
    validate_person(args)
    users = master_users()
    named = [name for name, _ in users if not reserved(name)]
    bootstrap_present = any(name == BOOTSTRAP_USER for name, _ in users)
    if named and named != [args.username]:
        raise Refused("named administrators already exist; use `admin create` (or `break-glass` if none can sign in)")
    if named and not bootstrap_present:
        remove(DELIVERED)
        print(f"Already done: {args.username} exists and no bootstrap account is left. Nothing changed.")
        if not all(master_hardening()):
            print("WARNING: master realm hardening is incomplete; any state-changing command run as an administrator "
                  "turns it on (for example `terrace-identity-admin admin enable --admin <you> --username <you>`).")
        return
    password = read_private(DELIVERED, HEX64_RE)
    if password is None:
        raise Refused("no delivered bootstrap password; on the operator machine run "
                      "`terrace-secrets apply <host> identity/bootstrap-admin-password --address <host>` first")
    steps = ([] if bootstrap_present else [f"stop Keycloak, create temporary administrator {BOOTSTRAP_USER} with the escrowed password, start Keycloak"]) + [
        f"create or repair named administrator {args.username} (master realm role admin, initial password, change required before use) and prove it signs in with the role",
        "enable master-realm brute-force protection and admin events (without representations)",
        f"delete {BOOTSTRAP_USER} and verify it can no longer sign in",
        f"remove {DELIVERED}"]
    if args.dry_run:
        for step in steps:
            print("would " + step)
        audit("first-admin", f"master/user/{args.username}", "dry-run")
        return
    if not bootstrap_present:
        # Journaled before Keycloak stops, so even a run killed in the window leaves its trace.
        audit("bootstrap-admin-create", f"master/user/{BOOTSTRAP_USER}", "started")
        run_bootstrap(config, BOOTSTRAP_USER, password)
        audit("bootstrap-admin-create", f"master/user/{BOOTSTRAP_USER}", "done")
    api = Keycloak(config["base"], BOOTSTRAP_USER, password)
    note = ensure_master_admin(api, config, args)
