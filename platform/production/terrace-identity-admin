    remove(DELIVERED)
    print(f"First administrator {args.username} ready ({note}); it signs in and holds the admin role.")
    print(f"{BOOTSTRAP_USER} deleted and refused; the delivered bootstrap password file is removed.")
    print("Next: `terrace-identity-admin password --admin " + args.username + "`, then rotate the escrowed value: "
