def norm(value):
    """Compare Keycloak's stored strings with the definition's JSON types; scalar lists as sets."""
    if isinstance(value, dict):
        return {key: norm(item) for key, item in value.items()}
    if isinstance(value, list):
        items = [norm(item) for item in value]
        return sorted(items) if all(isinstance(item, str) for item in items) else items
    if isinstance(value, bool):
        return "true" if value else "false"
    return "" if value is None else str(value)


def subset_differs(declared, running):
    return any(norm(value) != norm((running or {}).get(key)) for key, value in declared.items())


class Plan:
    def __init__(self):
        self.changes, self.kept, self.refused = [], [], []

    def change(self, kind, target, **detail):
        self.changes.append({"kind": kind, "target": target, **detail})

    def digest(self):
        return hashlib.sha256(json.dumps(self.changes, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def user_profile_plan(plan, api, realm, components):
    if set(components) - {PROFILE}:
        plan.refused.append(f"components {sorted(set(components) - {PROFILE})} are not understood by this reconciler")
        return
    entries = components.get(PROFILE) or []
    if len(entries) != 1 or entries[0].get("providerId") != "declarative-user-profile" or \
            set(entries[0].get("config", {})) != {"kc.user.profile.config"} or len(entries[0]["config"]["kc.user.profile.config"]) != 1:
        plan.refused.append("the user profile component is not the single declarative profile this reconciler understands")
        return
    declared = json.loads(entries[0]["config"]["kc.user.profile.config"][0])
    if set(declared) - {"attributes", "groups"}:
        plan.refused.append(f"user profile keys {sorted(set(declared) - {'attributes', 'groups'})} are not understood")
        return
    running = api.get(f"{realm}/users/profile")
    have = {attribute["name"]: attribute for attribute in running.get("attributes", [])}
    want = {attribute["name"]: attribute for attribute in declared.get("attributes", [])}
    dropped = sorted(set(have) - set(want))
    if dropped:
        plan.refused.append(f"user profile would drop attribute(s) {', '.join(dropped)}; the data in them would become unmanaged (destructive)")
    changed = [name for name, attribute in want.items() if name not in have or subset_differs(attribute, have[name])]
    groups_have = {group["name"]: group for group in running.get("groups", [])}
    changed_groups = [group["name"] for group in declared.get("groups", []) if group["name"] not in groups_have or subset_differs(group, groups_have[group["name"]])]
    if changed or changed_groups:
        # The declared content itself is in the change: the plan hash binds it and apply uses exactly it.
        groups_want = {group["name"]: group for group in declared.get("groups", [])}
        plan.change("user-profile", f"{realm}/users/profile", attributes=sorted(changed), groups=sorted(changed_groups),
                    content={"attributes": {name: want[name] for name in sorted(changed)}, "groups": {name: groups_want[name] for name in sorted(changed_groups)}})


def client_plan(plan, api, realm, client, secrets_config, roles_known):
    client_id = client.get("clientId", "")
    unknown = set(client) - CLIENT_KEYS
    if unknown or not CLIENT_RE.match(client_id):
        plan.refused.append(f"client {client_id or '?'}: keys {sorted(unknown)} are not understood")
        return None
    for mapper in client.get("protocolMappers", []):
        if set(mapper) - MAPPER_KEYS:
            plan.refused.append(f"client {client_id}: protocol mapper keys {sorted(set(mapper) - MAPPER_KEYS)} are not understood")
            return None
    running = api.client(realm, client_id)
    if running is None:
        if client_id not in secrets_config:
            plan.refused.append(f"new client {client_id} has no delivered secret; add it to the secrets inventory and the host first")
            return None
        plan.change("client-create", f"{realm}/client/{client_id}", definition={k: v for k, v in client.items() if k != "secret"})
        return None
    full = api.get(f"{realm}/clients/{running['id']}")
    for key in CLIENT_FIXED:
        if key in client and norm(client[key]) != norm(full.get(key)):
            plan.refused.append(f"client {client_id}: changing {key} is not applied by reconciliation (it would change how the client authenticates)")
    if client.get("enabled") is False and full.get("enabled"):
        plan.refused.append(f"client {client_id}: disabling a client is not applied by reconciliation")
    fields = {}
    for key in CLIENT_UPDATABLE:
        if key in client and norm(client[key]) != norm(full.get(key)):
            fields[key] = {"from": full.get(key), "to": client[key]}
    for key in ("redirectUris", "webOrigins"):
        if key in client and sorted(client[key]) != sorted(full.get(key) or []):
            fields[key] = {"add": sorted(set(client[key]) - set(full.get(key) or [])), "remove": sorted(set(full.get(key) or []) - set(client[key])), "to": sorted(client[key])}
    attributes = {key: value for key, value in (client.get("attributes") or {}).items() if norm(value) != norm((full.get("attributes") or {}).get(key))}
    if attributes:
        fields["attributes"] = {key: {"from": (full.get("attributes") or {}).get(key), "to": value} for key, value in attributes.items()}
    if fields:
        plan.change("client-update", f"{realm}/client/{client_id}", fields=fields)
    have = {mapper["name"]: mapper for mapper in full.get("protocolMappers") or []}
    for mapper in client.get("protocolMappers", []):
        if mapper["name"] not in have:
            plan.change("mapper-create", f"{realm}/client/{client_id}/mapper/{mapper['name']}", definition=mapper)
        elif any(norm(mapper.get(key)) != norm(have[mapper["name"]].get(key)) for key in ("protocol", "protocolMapper")) or \
                subset_differs(mapper.get("config") or {}, have[mapper["name"]].get("config")):
            plan.change("mapper-update", f"{realm}/client/{client_id}/mapper/{mapper['name']}", definition=mapper)
    for name in sorted(set(have) - {mapper["name"] for mapper in client.get("protocolMappers", [])}):
        if "protocolMappers" in client:
            plan.kept.append(f"protocol mapper {name} on client {client_id} (not declared)")
    scopes = {scope["name"]: scope["id"] for scope in api.get(f"{realm}/client-scopes")}
    lists = {kind: [s["name"] for s in api.get(f"{realm}/clients/{running['id']}/{kind}-client-scopes")] for kind in ("default", "optional")}
    for kind, key in (("default", "defaultClientScopes"), ("optional", "optionalClientScopes")):
        if key not in client:
            continue
        other = lists["optional" if kind == "default" else "default"]
        for name in client[key]:
            if name not in scopes:
                plan.refused.append(f"client {client_id}: {kind} scope {name} does not exist in the realm")
            elif name in other:
                plan.refused.append(f"client {client_id}: moving scope {name} between default and optional is not applied")
            elif name not in lists[kind]:
                plan.change("client-scope-add", f"{realm}/client/{client_id}/{kind}-scope/{name}", scope=name, list=kind)
        for name in sorted(set(lists[kind]) - set(client[key])):
            plan.kept.append(f"{kind} scope {name} on client {client_id} (not declared)")
    return running


def realm_plan(api, config, definition):
    plan = Plan()
    realm = config["realm"]
    unknown = set(definition) - REALM_KEYS
    if unknown:
        plan.refused.append(f"declared keys {sorted(unknown)} are not understood by this reconciler; update the tool before applying this release")
    if definition.get("realm") != realm:
        plan.refused.append("the definition is for a different realm")
        return plan
    running = api.get(realm)
    if definition.get("enabled") is not True:
        plan.refused.append("disabling the realm is not applied by reconciliation")
    invalid = set()
    for key in REALM_BOOLEANS:
        if key in definition and not isinstance(definition[key], bool):
            plan.refused.append(f"{key} must be true or false, not {json.dumps(definition[key])}")
            invalid.add(key)
    if definition.get("adminEventsDetailsEnabled") is True:
        plan.refused.append("adminEventsDetailsEnabled: true is not applied by hosting: admin event representations can contain personal data")
        invalid.add("adminEventsDetailsEnabled")
    for key in REALM_SCALARS:
        if key in invalid:
            continue
        if key in definition and norm(definition[key]) != norm(running.get(key)):
            plan.change("realm-setting", f"{realm}/{key}", setting=key, **{"from": running.get(key), "to": definition[key]})
    roles = definition.get("roles") or {}
    if set(roles) - {"realm"} or any(set(role) - {"name", "description"} for role in roles.get("realm", [])):
        plan.refused.append("only realm roles with a name and description are understood")
    have_roles = {role["name"] for role in api.get(f"{realm}/roles")}
    want_roles = [role["name"] for role in roles.get("realm", [])]
    for name in want_roles:
        if name not in have_roles:
            plan.change("role-create", f"{realm}/role/{name}", role=name)
    for name in sorted(have_roles - set(want_roles) - set(BUILTIN_ROLES) - {f"default-roles-{realm}"}):
        plan.kept.append(f"realm role {name} (not declared; reconciliation never deletes roles)")
    user_profile_plan(plan, api, realm, definition.get("components") or {})
    running_clients = {}
    for client in definition.get("clients") or []:
        found = client_plan(plan, api, realm, client, config["clientSecrets"], have_roles | set(want_roles))
        if found is not None:
            running_clients[client["clientId"]] = found
    declared_ids = {client.get("clientId") for client in definition.get("clients") or []}
    for client in api.get(f"{realm}/clients"):
        if client["clientId"] not in declared_ids and not client["clientId"].startswith(("account", "admin-cli", "broker", "realm-management", "security-admin-console")):
            plan.kept.append(f"client {client['clientId']} (not declared; reconciliation never deletes clients)")
    for mapping in definition.get("scopeMappings") or []:
        if set(mapping) - {"client", "roles"}:
            plan.refused.append(f"scope mapping keys {sorted(set(mapping) - {'client', 'roles'})} are not understood")
            continue
        client_id = mapping["client"]
        if client_id not in declared_ids:
            plan.refused.append(f"scope mapping for undeclared client {client_id}")
            continue
        found = running_clients.get(client_id)
        have = set() if found is None else {role["name"] for role in api.get(f"{realm}/clients/{found['id']}/scope-mappings/realm")}
        for name in mapping["roles"]:
            if name not in have_roles and name not in want_roles:
                plan.refused.append(f"scope mapping to unknown role {name}")
            elif name not in have:
                plan.change("scope-mapping-add", f"{realm}/client/{client_id}/scope/{name}", role=name, client=client_id)
        for name in sorted(have - set(mapping["roles"])):
            plan.change("scope-mapping-remove", f"{realm}/client/{client_id}/scope/{name}", role=name, client=client_id)
    return plan


def apply_change(api, config, definition, change):
    realm = config["realm"]
    kind = change["kind"]
    if kind == "realm-setting":
        current = api.get(realm)
        current[change["setting"]] = change["to"]
        api.call("PUT", realm, current)
    elif kind == "role-create":
        api.call("POST", f"{realm}/roles", {"name": change["role"]})
    elif kind == "user-profile":
        running = api.get(f"{realm}/users/profile")
        for key in ("attributes", "groups"):
            want = dict(change["content"][key])
            merged = []
            for item in running.get(key, []):
                merged.append({**item, **want.pop(item["name"], {})})
            merged += list(want.values())
            running[key] = merged
        api.call("PUT", f"{realm}/users/profile", running)
    elif kind == "client-create":
        client_id = change["definition"]["clientId"]
        secret = read_private(Path(config["clientSecrets"][client_id]["file"]).resolve(), HEX64_RE)
        if secret is None:
            raise Refused(f"no delivered secret for new client {client_id}")
        api.call("POST", f"{realm}/clients", {**change["definition"], "secret": secret})
    elif kind == "client-update":
        found = api.client(realm, change["target"].rsplit("/", 1)[1])
        full = api.get(f"{realm}/clients/{found['id']}")
        for key, value in change["fields"].items():
            if key == "attributes":
                full.setdefault("attributes", {}).update({name: item["to"] for name, item in value.items()})
            else:
                full[key] = value["to"]
        api.call("PUT", f"{realm}/clients/{found['id']}", full)
    elif kind in ("mapper-create", "mapper-update"):
        client_id = change["target"].split("/")[2]
        found = api.client(realm, client_id)
        mapper = change["definition"]
        if kind == "mapper-create":
            api.call("POST", f"{realm}/clients/{found['id']}/protocol-mappers/models", mapper)
        else:
            existing = [m for m in api.get(f"{realm}/clients/{found['id']}/protocol-mappers/models") if m["name"] == mapper["name"]][0]
            updated = {**existing, **{k: v for k, v in mapper.items() if k != "config"}, "config": {**existing.get("config", {}), **mapper.get("config", {})}}
            api.call("PUT", f"{realm}/clients/{found['id']}/protocol-mappers/models/{existing['id']}", updated)
    elif kind == "client-scope-add":
        client_id = change["target"].split("/")[2]
        found = api.client(realm, client_id)
        scope = [s for s in api.get(f"{realm}/client-scopes") if s["name"] == change["scope"]][0]
        api.call("PUT", f"{realm}/clients/{found['id']}/{change['list']}-client-scopes/{scope['id']}")
    elif kind in ("scope-mapping-add", "scope-mapping-remove"):
        found = api.client(realm, change["client"])
        api.call("POST" if kind == "scope-mapping-add" else "DELETE", f"{realm}/clients/{found['id']}/scope-mappings/realm", [api.role(realm, change["role"])])
    else:
        raise Refused(f"unknown change kind {kind}")


def describe(change):
    kind = change["kind"]
    if kind == "realm-setting":
        return f"~ realm {change['setting']}: {json.dumps(change['from'])} -> {json.dumps(change['to'])}"
    if kind == "client-update":
        parts = []
        for key, value in change["fields"].items():
            if key in ("redirectUris", "webOrigins"):
                parts.append(f"{key} +{value['add']} -{value['remove']}")
            elif key == "attributes":
                parts += [f"attribute {name}: {json.dumps(item['from'])} -> {json.dumps(item['to'])}" for name, item in value.items()]
            else:
                parts.append(f"{key}: {json.dumps(value['from'])} -> {json.dumps(value['to'])}")
        return f"~ client {change['target'].split('/')[-1]}: " + "; ".join(parts)
    if kind == "user-profile":
        lines = [f"~ user profile: attributes {change['attributes']} groups {change['groups']}"]
        lines += [f"      {key[:-1]} {name} := {json.dumps(item, sort_keys=True)}" for key in ("attributes", "groups") for name, item in change["content"][key].items()]
        return "\n".join(lines)
    if kind in ("mapper-create", "mapper-update"):
        mapper = change["definition"]
        return (f"{'+' if kind == 'mapper-create' else '~'} {kind} {change['target']}: type {mapper.get('protocolMapper')} "
                f"protocol {mapper.get('protocol')} config {json.dumps(mapper.get('config') or {}, sort_keys=True)}")
    if kind == "client-create":
        # The secret is never in the plan; the delivered value is used at apply time.
        return f"+ client-create {change['target']}: {json.dumps(change['definition'], sort_keys=True)} (secret: the delivered value)"
    if kind == "client-scope-add":
        return f"+ client-scope-add {change['target']}: scope {change['scope']} as {change['list']}"
    symbol = "-" if kind.endswith("-remove") else "+" if kind.endswith(("-create", "-add")) else "~"
    return f"{symbol} {kind} {change['target']}"


def run_plan(config, args, api):
    path = definition_path(config, args)
    policy = subprocess.run(["jq", "-e", "-f", config["policy"], str(path)], capture_output=True, timeout=60)
    if policy.returncode != 0:
        raise Refused("the realm definition fails the hosting policy (realm-policy.jq); nothing planned")
    definition = json.loads(path.read_text())
    if path != Path(config["definition"]):
        print("NOTE: planning against a definition that is not the pinned release's; review only, `realm apply` uses the pinned one.")
    plan = realm_plan(api, config, definition)
    print(f"Realm plan for {config['realm']}:")
    for change in plan.changes:
        print("  " + describe(change))
    for item in plan.kept:
        print("  kept: " + item)
    for item in plan.refused:
        print("  REFUSED: " + item)
    return plan, definition


def cmd_realm(config, args):
    api = login(config, args)
    plan, definition = run_plan(config, args, api)
    target = f"{config['realm']}/realm"
    if plan.refused:
        audit("realm-" + args.action, target, "refused", args.admin)
        print(f"Plan refused: {len(plan.refused)} item(s) destructive or not understood; nothing can be applied.")
        return EXIT_PLAN_REFUSED
    digest = plan.digest()
    if not plan.changes:
        print(f"Converged: the running realm matches the definition. Nothing to apply. (plan sha256 {digest})")
        audit("realm-" + args.action, target, "converged", args.admin)
        return 0
    print(f"Plan: {len(plan.changes)} change(s). sha256 {digest}")
    if args.action == "plan":
        audit("realm-plan", target, f"{len(plan.changes)}-changes", args.admin)
        print(f"Apply exactly this plan with: terrace-identity-admin realm apply --admin {args.admin} --plan-sha256 {digest}")
        return 0
    if args.plan_sha256 != digest:
        audit("realm-apply", target, "refused-plan-mismatch", args.admin)
        raise Refused("--plan-sha256 does not match the plan computed now; run `realm plan` again and review it")
    for change in plan.changes:
        apply_change(api, config, definition, change)
        audit("realm-apply-" + change["kind"], change["target"], "done", args.admin)
    after = realm_plan(api, config, definition)
    if after.changes or after.refused:
        raise Refused(f"the realm did not converge: {len(after.changes)} change(s) still planned")
    audit("realm-apply", target, "converged", args.admin)
    print(f"Applied {len(plan.changes)} change(s); the realm now matches the definition.")
    return 0


# ---- break-glass (G-40) -----------------------------------------------------

def cmd_break_glass(config, args):
    if args.action == "begin":
        temporary = [name for name, _ in master_users() if reserved(name)]
        usable = []
        for name in temporary:
            held = read_private(handoff_path("master", name))
            try:
                if held is not None and password_grant(config["base"], name, held):
                    usable.append(name)
            except Refused:
                pass  # Keycloak not answering: the bootstrap below starts it again
        if usable:
            raise Refused(f"a working temporary administrator exists ({', '.join(usable)}); use it with its handoff file, "
                          "or remove it with `break-glass end`")
        # A random suffix: a local process cannot guess the name to lock the account out (master brute-force protection).
        username = RECOVERY_PREFIX + time.strftime("%Y%m%d%H%M%S", time.gmtime()) + "-" + token.token_hex(4)
        if args.dry_run:
            print(f"would stop Keycloak (sign-in is down for about a minute), create temporary administrator {username} with a random password, start Keycloak")
            audit("break-glass-begin", f"master/user/{username}", "dry-run")
            return
        password = token.token_hex(32)
        # The handoff comes first: if anything below dies, the account it creates is still usable.
        write_private(handoff_path("master", username), password + "\n")
        audit("break-glass-begin", f"master/user/{username}", "started")
        try:
            run_bootstrap(config, username, password)
        except Refused:
            if username not in [name for name, _ in master_users()]:
                remove(handoff_path("master", username))  # no account was created: its password is useless
            raise
        if not password_grant(config["base"], username, password):
            raise Refused(f"{username} was created but cannot sign in; Keycloak's state needs investigation")
        audit("break-glass-begin", f"master/user/{username}", "done")
        print(f"Recovery administrator {username} created. Its password is in {handoff_path('master', username)} (root-only, tmpfs).")
        if temporary:
            print(f"Unusable temporary administrators also present: {', '.join(temporary)}; `break-glass end` removes them.")
        print(f"Use it with --admin {username} --password-stdin to repair named administrators (`admin enable` or `admin create`),")
        print("then end it as a named administrator: `terrace-identity-admin break-glass end --admin NAME`.")
        return
    if reserved(args.admin):
        raise Refused("end break-glass as a named administrator: that proves named access works again")
    api = login(config, args)
    removed = []
    for user in api.paged("master/users?briefRepresentation=true"):
        if reserved(user["username"]):
            if args.dry_run:
                removed.append(user["username"])
                continue
            api.call("DELETE", f"master/users/{user['id']}")
            removed.append(user["username"])
    if args.dry_run:
        print(f"would delete: {', '.join(removed) or 'nothing'}")
        audit("break-glass-end", "master/temporary-admins", "dry-run", args.admin)
        return
    for username in removed:
        password = read_private(handoff_path("master", username))
        if password is not None and password_grant(config["base"], username, password):
            raise Refused(f"{username} can still sign in after deletion")
        remove(handoff_path("master", username))
        audit("break-glass-end", f"master/user/{username}", "done", args.admin)
    left = [name for name, _ in master_users() if reserved(name)]
    if left:
        raise Refused(f"temporary administrators still in the database: {', '.join(left)}")
    print(f"Break-glass ended: deleted {', '.join(removed) or 'no temporary administrator'}; none remains.")


def cmd_check_temporary(config, args):
    """Fail (and log at crit) while a temporary bootstrap or recovery administrator is older than the
    configured age: a forgotten break-glass account must not stay unnoticed. Read-only."""
    limit = config["temporaryMaxAgeMinutes"] if args.max_age_minutes is None else args.max_age_minutes
    sql = ("select u.username, u.created_timestamp from user_entity u join realm r on r.id = u.realm_id where r.name = 'master' "
           f"and (u.username = '{BOOTSTRAP_USER}' or u.username like '{RECOVERY_PREFIX}%') order by u.username")
    result = subprocess.run(["runuser", "-u", "postgres", "--", "psql", "-XAt", "-v", "ON_ERROR_STOP=1", "-d", "keycloak", "-c", sql],
                            capture_output=True, timeout=60)
    if result.returncode != 0:
        raise Refused("could not read the master realm accounts from the keycloak database")
    now = time.time() * 1000
    old = []
    for line in result.stdout.decode().splitlines():
        name, _, created = line.partition("|")
        if created.isdigit() and now - int(created) >= limit * 60000:
            old.append(name)
    problems = []
    if old:
        problems.append(f"temporary Keycloak administrator(s) older than {limit} minutes: {field(','.join(old))}; finish `first-admin` or run `break-glass end`")
    # Once a named administrator exists, the master realm must be hardened (first-admin, or any administrator command, does it).
    if any(not reserved(name) for name, _ in master_users()) and not all(master_hardening()):
        problems.append("master realm brute-force protection or admin events are off; run a state-changing command as an administrator")
    if problems:
        syslog.openlog("terrace-identity-admin", 0, syslog.LOG_AUTH)
        for problem in problems:
            syslog.syslog(syslog.LOG_CRIT, problem)
        syslog.closelog()
        print("\n".join(problems))
        return EXIT_REFUSED
    print(f"No temporary administrator older than {limit} minutes; master realm hardened (or no administrator yet).")
    return 0


# ---- command line -----------------------------------------------------------

def parser():
    top = argparse.ArgumentParser(prog="terrace-identity-admin", description=__doc__.splitlines()[0],
                                  epilog="Run as root on the production app host. Procedures: docs/identity-admin.md.")
    sub = top.add_subparsers(dest="command", required=True)

    def admin_options(command, dry_run=True):
        command.add_argument("--admin", required=True, help="your named Keycloak administrator (master realm)")
        command.add_argument("--password-stdin", action="store_true", help="read passwords from stdin lines instead of the terminal")
        if dry_run:
            command.add_argument("--dry-run", action="store_true", help="show what would change; change nothing")

    def person_options(command):
        command.add_argument("--username", required=True)
        command.add_argument("--email", required=True)
        command.add_argument("--first-name", required=True)
        command.add_argument("--last-name", required=True)
        command.add_argument("--set-password", action="store_true", help="type the initial password instead of a generated handoff file")

    status = sub.add_parser("status", help="readiness and master-realm accounts (read-only, no login)")
    status.set_defaults(func=cmd_status)
    first = sub.add_parser("first-admin", help="bootstrap with the delivered escrowed password, create the first named administrator, delete the bootstrap account")
    person_options(first)
    first.add_argument("--password-stdin", action="store_true", help="with --set-password: read it from stdin")
    first.add_argument("--dry-run", action="store_true")
    first.set_defaults(func=cmd_first_admin)
    password = sub.add_parser("password", help="change your own administrator password (required after an initial one)")
    admin_options(password, dry_run=False)
    password.set_defaults(func=cmd_password)
    admin = sub.add_parser("admin", help="named Keycloak administrators (master realm)").add_subparsers(dest="action", required=True)
    create = admin.add_parser("create")
    admin_options(create)
    person_options(create)
    create.set_defaults(func=cmd_admin)
    for action in ("enable", "disable"):
        command = admin.add_parser(action)
        admin_options(command)
        command.add_argument("--username", required=True)
        command.set_defaults(func=cmd_admin)
    user = sub.add_parser("user", help="site accounts in the terrace realm").add_subparsers(dest="action", required=True)
    ucreate = user.add_parser("create", help="an editor or administrator of the site, with a temporary password")
    admin_options(ucreate)
    person_options(ucreate)
    ucreate.add_argument("--role", action="append", help="an editorial role of the identity contract; repeatable")
    ucreate.set_defaults(func=cmd_user, role=None)
    disable = user.add_parser("disable", help="disable an account and end its sessions")
    admin_options(disable)
    disable.add_argument("--username", required=True)
    disable.set_defaults(func=cmd_user, role=None)
    for action in ("grant", "revoke"):
        command = sub.add_parser(action, help=f"{action} a role of the identity contract")
        admin_options(command)
        command.add_argument("--username", required=True)
        command.add_argument("--role", required=True)
        if action == "revoke":
            command.add_argument("--keep-sessions", action="store_true", help="do not end the user's sessions (the role then lapses within the token lifetime)")
        command.set_defaults(func=cmd_user, action=action)
    listing = sub.add_parser("list", help="users with roles, realm roles and clients (read-only)")
    admin_options(listing, dry_run=False)
    listing.add_argument("--realm", choices=["terrace", "master", "all"], default="all")
    listing.add_argument("--show-email", action="store_true")
    listing.add_argument("--json", action="store_true")
    listing.set_defaults(func=cmd_list)
    secret = sub.add_parser("client-secret", help="confidential client secrets").add_subparsers(dest="action", required=True)
    sync = secret.add_parser("sync", help="set Keycloak to the delivered secret (after terrace-secrets rotate --manual and push)")
    admin_options(sync)
    sync.add_argument("--client", required=True)
    sync.set_defaults(func=cmd_client_secret)
    realm = sub.add_parser("realm", help="reconcile the running realm with the pinned release's definition").add_subparsers(dest="action", required=True)
    plan = realm.add_parser("plan", help="print the plan and its sha256 (read-only)")
    admin_options(plan, dry_run=False)
    plan.add_argument("--definition", help="another root-owned definition (review only; default: the pinned release's)")
    plan.set_defaults(func=cmd_realm)
    apply = realm.add_parser("apply", help="apply exactly the reviewed plan")
    admin_options(apply, dry_run=False)
    apply.add_argument("--plan-sha256", required=True)
    apply.set_defaults(func=cmd_realm)
    check = sub.add_parser("check-temporary", help="fail while a temporary administrator is older than the configured age (read-only; run by a timer)")
    check.add_argument("--max-age-minutes", type=int, help="override the configured age")
    check.set_defaults(func=cmd_check_temporary)
    glass = sub.add_parser("break-glass", help="recovery without any working administrator, SSO or proxy").add_subparsers(dest="action", required=True)
    begin = glass.add_parser("begin", help="create a temporary recovery administrator (no login needed)")
    begin.add_argument("--dry-run", action="store_true")
    begin.set_defaults(func=cmd_break_glass)
    end = glass.add_parser("end", help="delete every temporary administrator, as a named administrator")
    admin_options(end)
    end.set_defaults(func=cmd_break_glass)
    return top


def mutating(args):
    """Every command that can change Keycloak (dry runs included) runs one at a time."""
    return args.command not in ("status", "list", "check-temporary") and not (args.command == "realm" and args.action == "plan")


def clean_stale_bootstrap_files(config):
    """A tool killed before it started the bootstrap unit leaves its credential files (root-only, tmpfs);
    remove them unless the unit is running right now."""
    if KC_BOOT.exists() and not unit_busy(config["bootstrapUnit"]):
        for name in ("username", "password", "nonce"):
            remove(KC_BOOT / name)


def take_lock():
    private_dir(RUN)
    fd = os.open(LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        raise Refused("another terrace-identity-admin command is running; try again when it has finished")
    return fd  # held until this process exits


def main(argv=None, config_path=CONFIG):
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    args = parser().parse_args(argv)
    try:
        if os.geteuid() != 0:
            raise Refused("run as root on the production app host (sudo terrace-identity-admin ...)")
        if getattr(args, "plan_sha256", None) is not None and not SHA_RE.match(args.plan_sha256):
            raise Refused("--plan-sha256 must be 64 lowercase hex digits")
        if getattr(args, "client", None) is not None and not CLIENT_RE.match(args.client):
            raise Refused("--client must be a client id")
        os.umask(0o077)
        config = load_config(config_path)
        if mutating(args):
            HARDEN.append(True)
            # A dropped SSH session must not stop a command half way: finish it (output may be lost).
            signal.signal(signal.SIGHUP, signal.SIG_IGN)
            take_lock()
            clean_stale_bootstrap_files(config)
        try:
            result = args.func(config, args)
        finally:
            for api in SESSIONS:
                try:
                    api.logout()
                except Refused:
                    pass
        return result or 0
    except Refused as error:
        print(f"terrace-identity-admin: {error}", file=sys.stderr)
        return EXIT_REFUSED
    except (OSError, ValueError, KeyError, IndexError, TypeError, subprocess.SubprocessError) as error:
        # Never echo exception text: a parser or HTTP error can quote input or response bytes.
        print(f"terrace-identity-admin: {type(error).__name__} during {args.command}", file=sys.stderr)
        return EXIT_REFUSED


if __name__ == "__main__":
    sys.exit(main())
