def enabled_admins(api):
    return [user for user in api.role_holders("master", "admin") if user.get("enabled") and not reserved(user["username"])]


def inheritance(api, realm, role):
    """Why direct role holders may not be every holder (groups or composite roles), or None. The
    last-administrator refusals count direct holders, so they refuse to act when this is not None."""
    if api.get(f"{realm}/groups?max=1"):
        return f"the {realm} realm has groups, which can carry {role}"
    for item in api.get(f"{realm}/roles?briefRepresentation=false"):
        if item.get("composite") and role in [c["name"] for c in api.get(f"{realm}/roles/{urllib.parse.quote(item['name'])}/composites/realm")]:
            return f"composite role {item['name']} contains {role}"
    return None


def refuse_unreliable_count(api, realm, role, action, target, admin):
    reason = inheritance(api, realm, role)
    if reason:
        audit(action, target, "refused-inherited-role", admin)
        raise Refused(f"cannot count {role} holders reliably ({reason}); change it in Keycloak by hand after reviewing who inherits it")


def cmd_admin(config, args):
    if not USERNAME_RE.match(args.username) or reserved(args.username):
        raise Refused("--username must be a named administrator")
    api = login(config, args)
    target = f"master/user/{args.username}"
    user = api.user("master", args.username)
    if args.action == "create":
        validate_person(args)
        if user is not None:
            print(f"{args.username} already exists. Nothing changed.")
            return
        if args.dry_run:
            print(f"would create administrator {args.username} with an initial password")
            audit("admin-create", target, "dry-run", args.admin)
            return
        note = ensure_master_admin(api, config, args)
        audit("admin-create", target, "done", args.admin)
        print(f"Created administrator {args.username}; {note}.")
        return
    if user is None:
        raise Refused(f"no administrator {args.username}")
    want = args.action == "enable"
    locked = want and bool(api.get(f"master/attack-detection/brute-force/users/{user['id']}").get("disabled"))
    if bool(user.get("enabled")) == want and not locked:
        print(f"{args.username} is already {'enabled' if want else 'disabled'}. Nothing changed.")
        return
    if not want:
        refuse_unreliable_count(api, "master", "admin", "admin-disable", target, args.admin)
        if [u["username"] for u in enabled_admins(api)] == [args.username]:
            audit("admin-disable", target, "refused-last-admin", args.admin)
            raise Refused(f"{args.username} is the last enabled named administrator; create or enable another first")
    if args.dry_run:
        print(f"would {args.action} {args.username}" + (" and clear its brute-force lockout" if locked else ""))
        audit("admin-" + args.action, target, "dry-run", args.admin)
        return
    if bool(user.get("enabled")) != want:
        user["enabled"] = want
        api.call("PUT", f"master/users/{user['id']}", user)
    if locked:
        api.call("DELETE", f"master/attack-detection/brute-force/users/{user['id']}")
        audit("admin-unlock", target, "done", args.admin)
    if not want:
        api.call("POST", f"master/users/{user['id']}/logout")
    audit("admin-" + args.action, target, "done", args.admin)
    print(f"{args.username} {'enabled' if want else 'disabled (sessions ended)'}" + (" and its brute-force lockout cleared." if locked else "."))


