{
  "entries": [
    {
      "name": "step02-quiesce-and-final-backup",
      "document": "docs/restore-promotion.md",
      "step": "2",
      "kind": "block",
      "lines": [
        "systemctl stop terrace-backup.timer terrace-backup-check.timer",
        "systemctl stop terrace-cms-sweep.timer terrace-cms-sweep.service terrace-web.service terrace-cms.service keycloak.service nginx.service",
        "systemctl start terrace-backup.service",
        "terrace-backup restic primary snapshots --json",
        "systemctl stop postgresql.target postgresql.service"
      ]
    },
    {
      "name": "step02-result",
      "document": "docs/restore-promotion.md",
      "step": "2",
      "kind": "inline",
      "text": "systemctl show terrace-backup.service -p Result --value"
    },
    {
      "name": "step02-log",
      "document": "docs/restore-promotion.md",
      "step": "2",
      "kind": "inline",
      "text": "target primary: backup succeeded in"
    },
    {
      "name": "step02-age",
      "document": "docs/restore-promotion.md",
      "step": "2",
      "kind": "inline",
      "text": "terrace-backup age"
    },
    {
      "name": "step04-rekey",
      "document": "docs/restore-promotion.md",
      "step": "4",
      "kind": "block",
      "lines": [
        "terrace-secrets host create app --role app --replace",
        "terrace-secrets rekey app",
        "terrace-secrets check app"
      ]
    },
    {
      "name": "relay-role",
      "document": "docs/restore-promotion.md",
      "step": "4",
      "kind": "inline",
      "text": "relay --role relay"
    },
    {
      "name": "step05-status",
      "document": "docs/restore-promotion.md",
      "step": "5",
      "kind": "inline",
      "text": "terrace-production status"
    },
    {
      "name": "step06-push",
      "document": "docs/restore-promotion.md",
      "step": "6",
      "kind": "block",
      "lines": [
        "terrace-secrets push app --address <replacement address> --identity <operator ssh key>",
        "terrace-secrets host unstage app"
      ]
    },
    {
      "name": "step06-check-on-host",
      "document": "docs/restore-promotion.md",
      "step": "6",
      "kind": "block",
      "lines": [
        "terrace-secrets verify",
        "test -e /var/lib/terrace-secrets/replacement"
      ]
    },
    {
      "name": "step07-snapshots",
      "document": "docs/restore-promotion.md",
      "step": "7",
      "kind": "block",
      "lines": [
        "terrace-backup restic primary snapshots --json"
      ]
    },
    {
      "name": "step08-read-data",
      "document": "docs/restore-promotion.md",
      "step": "8",
      "kind": "block",
      "lines": [
        "terrace-backup restic primary check --read-data"
      ]
    },
    {
      "name": "step09-restore",
      "document": "docs/restore-promotion.md",
      "step": "9",
      "kind": "block",
      "lines": [
        "umask 077",
        "terrace-backup-restore --target primary --snapshot <SNAPSHOT_ID> --dest /var/lib/terrace-restore >/var/tmp/restore.log 2>&1",
        "grep -qx 'RECONCILIATION OK' /var/lib/terrace-restore/reconciliation.txt"
      ]
    },
    {
      "name": "step09-stop-isolated",
      "document": "docs/restore-promotion.md",
      "step": "9",
      "kind": "inline",
      "text": "terrace-backup-restore --stop /var/lib/terrace-restore"
    },
    {
      "name": "step09-remove",
      "document": "docs/restore-promotion.md",
      "step": "9",
      "kind": "inline",
      "text": "rm -rf /var/lib/terrace-restore"
    },
    {
      "name": "step10-status",
      "document": "docs/restore-promotion.md",
      "step": "10",
      "kind": "block",
      "lines": [
        "terrace-production status"
      ]
    },
    {
      "name": "step11-copy-file-set",
      "document": "docs/restore-promotion.md",
      "step": "11",
      "kind": "block",
      "lines": [
        "test ! -L <path> && { test ! -e <path> || test -z \"$(ls -A <path>)\"; }",
        "mkdir -p <path> && cp -a /var/lib/terrace-restore/files<path>/. <path>/"
      ]
    },
    {
      "name": "step11-outbox-owner",
      "document": "docs/restore-promotion.md",
      "step": "11",
      "kind": "inline",
      "text": "test \"$(stat -c %U:%a /var/lib/terrace-cms-outbox)\" = terrace_cms:700"
    },
    {
      "name": "step12-postgresql",
      "document": "docs/restore-promotion.md",
      "step": "12",
      "kind": "block",
      "lines": [
        "pg_dir=/var/lib/postgresql/18",
        "test ! -L \"$pg_dir\" && { test ! -e \"$pg_dir\" || test -z \"$(ls -A \"$pg_dir\")\"; }",
        "install -d -m 0700 -o postgres -g postgres \"$pg_dir\" && cp -a /var/lib/terrace-restore/pgdata/. \"$pg_dir\"/ && chown -R postgres:postgres \"$pg_dir\""
      ]
    },
    {
      "name": "step13-headscale",
      "document": "docs/restore-promotion.md",
      "step": "13",
      "kind": "block",
      "lines": [
        "test ! -L /var/lib/headscale && { test ! -e /var/lib/headscale || test -z \"$(ls -A /var/lib/headscale)\"; }",
        "mkdir -p /var/lib/headscale && cp -a /var/lib/terrace-restore/files/var/lib/headscale/. /var/lib/headscale/",
        "install -m 0600 -o headscale -g headscale /var/lib/terrace-restore/files/var/lib/terrace-backup/dumps/sqlite/headscale.sqlite /var/lib/headscale/db.sqlite"
      ]
    },
    {
      "name": "step13-integrity",
      "document": "docs/restore-promotion.md",
      "step": "13",
      "kind": "inline",
      "text": "sqlite3 /var/lib/headscale/db.sqlite \"PRAGMA integrity_check\""
    },
    {
      "name": "step13-owners",
      "document": "docs/restore-promotion.md",
      "step": "13",
      "kind": "inline",
      "text": "stat -c %U:%G /var/lib/headscale /var/lib/headscale/noise_private.key /var/lib/headscale/derp_server_private.key"
    },
    {
      "name": "step14-role-checks",
      "document": "docs/restore-promotion.md",
      "step": "14",
      "kind": "block",
      "lines": [
        "systemctl start postgresql.target",
        "runuser -u postgres -- psql -XAt -w -v ON_ERROR_STOP=1 -d postgres -c \"select rolsuper and rolcanlogin from pg_authid where oid=10 and rolname='postgres'\"   # t",
        "runuser -u postgres -- psql -XAt -w -v ON_ERROR_STOP=1 -d postgres -c \"select count(*) from pg_roles where rolname='terrace-restore'\"   # 0",
        "runuser -u postgres -- psql -XAt -w -v ON_ERROR_STOP=1 -d postgres -c \"show fsync\"   # on",
        "runuser -u postgres -- psql -XAt -w -v ON_ERROR_STOP=1 -d postgres -c \"show hba_file\"   # a /nix/store path",
        "runuser -u terrace-restore -- psql -X -w -h /run/postgresql -U postgres -d postgres -c 'select 1'   # must FAIL"
      ]
    },
    {
      "name": "step15-adopt",
      "document": "docs/restore-promotion.md",
      "step": "15",
      "kind": "block",
      "lines": [
        "terrace-production adopt --restored"
      ]
    },
    {
      "name": "step15-output-app",
      "document": "docs/restore-promotion.md",
      "step": "15",
      "kind": "output",
      "lines": [
        "Adopted: the writers start now and at every boot.",
        "Held until you have verified the restored services: terrace-backup.timer terrace-backup-check.timer terrace-backup-freshness.timer (they stay off across reboots).",
        "Arm them with: terrace-production arm-timers",
        "Held until the replacement is declared in service, after any erasure replay: terrace-cms-sweep.timer (they stay off across reboots).",
        "Arm it then with: terrace-production arm-timers --in-service"
      ]
    },
    {
      "name": "step16-migration-gate",
      "document": "docs/restore-promotion.md",
      "step": "16",
      "kind": "block",
      "lines": [
        "runuser -u postgres -- psql -XAt -w -v ON_ERROR_STOP=1 -d terrace_cms -c 'select name||batch from payload_migrations order by id'",
        "systemctl start terrace-cms-migrate.service",
        "systemctl start terrace-cms.service terrace-web.service",
        "runuser -u postgres -- psql -XAt -w -v ON_ERROR_STOP=1 -d terrace_cms -c 'select name||batch from payload_migrations order by id'"
      ]
    },
    {
      "name": "step16-sweep-by-hand",
      "document": "docs/restore-promotion.md",
      "step": "16",
      "kind": "block",
      "lines": [
        "systemctl start terrace-cms-sweep.service"
      ]
    },
    {
      "name": "step17-keycloak",
      "document": "docs/restore-promotion.md",
      "step": "17",
      "kind": "inline",
      "text": "systemctl is-active keycloak.service"
    },
    {
      "name": "step19-tls",
      "document": "docs/restore-promotion.md",
      "step": "19",
      "kind": "inline",
      "text": "terrace-tls check"
    },
    {
      "name": "step20-health",
      "document": "docs/restore-promotion.md",
      "step": "20",
      "kind": "block",
      "lines": [
        "systemctl --failed",
        "terrace-tls check",
        "terrace-secrets verify",
        "terrace-backup age"
      ]
    },
    {
      "name": "step21-first-backup-and-arm",
      "document": "docs/restore-promotion.md",
      "step": "21",
      "kind": "block",
      "lines": [
        "systemctl start terrace-backup.service",
        "terrace-backup age",
        "systemctl start terrace-backup-freshness.service",
        "terrace-backup restic primary snapshots --json",
        "terrace-production arm-timers"
      ]
    },
    {
      "name": "step21-output-app",
      "document": "docs/restore-promotion.md",
      "step": "21",
      "kind": "output",
      "lines": [
        "Armed: terrace-backup.timer terrace-backup-check.timer terrace-backup-freshness.timer.",
        "Still held until the replacement is declared in service: terrace-cms-sweep.timer. Arm with: terrace-production arm-timers --in-service"
      ]
    },
    {
      "name": "relay-in-service",
      "document": "docs/restore-promotion.md",
      "step": "21",
      "kind": "inline",
      "text": "terrace-production arm-timers --in-service"
    },
    {
      "name": "d5-app",
      "document": "docs/restore-promotion.md",
      "step": "21",
      "kind": "block",
      "lines": [
        "terrace-production arm-timers --in-service",
        "terrace-production status",
        "systemctl is-active terrace-backup.timer terrace-backup-check.timer terrace-backup-freshness.timer terrace-cms-sweep.timer",
        "systemctl list-timers"
      ]
    },
    {
      "name": "d5-relay",
      "document": "docs/restore-promotion.md",
      "step": "21",
      "kind": "block",
      "lines": [
        "terrace-production status",
        "systemctl is-active terrace-backup.timer terrace-backup-check.timer terrace-backup-freshness.timer"
      ]
    },
    {
      "name": "r7-rotate",
      "document": "docs/credential-rotation.md",
      "step": "R7",
      "kind": "inline",
      "text": "terrace-secrets rotate app backup/primary/repository-password --manual"
    },
    {
      "name": "r7-apply",
      "document": "docs/credential-rotation.md",
      "step": "R7",
      "kind": "inline",
      "text": "terrace-secrets apply app backup/primary/repository-password --address <app address> --identity <key>"
    },
    {
      "name": "r7-push",
      "document": "docs/credential-rotation.md",
      "step": "R7",
      "kind": "inline",
      "text": "terrace-secrets push app --address <app address> --identity <key>"
    },
    {
      "name": "r7-key-list",
      "document": "docs/credential-rotation.md",
      "step": "R7",
      "kind": "inline",
      "text": "terrace-backup restic primary key list --json"
    },
    {
      "name": "r7-backup",
      "document": "docs/credential-rotation.md",
      "step": "R7",
      "kind": "inline",
      "text": "systemctl start terrace-backup.service"
    },
    {
      "name": "r7-result",
      "document": "docs/credential-rotation.md",
      "step": "R7",
      "kind": "inline",
      "text": "systemctl show terrace-backup.service -p Result --value"
    },
    {
      "name": "r7-finish",
      "document": "docs/credential-rotation.md",
      "step": "R7",
      "kind": "inline",
      "text": "terrace-secrets apply app backup/primary/repository-password --finish --keep <id> ... --address <app address> --identity <key>"
    },
    {
      "name": "r8-public",
      "document": "docs/credential-rotation.md",
      "step": "R8",
      "kind": "inline",
      "text": "terrace-secrets public app backup/primary/sftp-key"
    },
    {
      "name": "r8-rotate",
      "document": "docs/credential-rotation.md",
      "step": "R8",
      "kind": "inline",
      "text": "terrace-secrets rotate app backup/primary/sftp-key --manual"
    },
    {
      "name": "r8-push",
      "document": "docs/credential-rotation.md",
      "step": "R8",
      "kind": "inline",
      "text": "terrace-secrets push app --address <app address> --identity <key>"
    },
    {
      "name": "r8-backup",
      "document": "docs/credential-rotation.md",
      "step": "R8",
      "kind": "inline",
      "text": "systemctl start terrace-backup.service"
    },
    {
      "name": "r8-result",
      "document": "docs/credential-rotation.md",
      "step": "R8",
      "kind": "inline",
      "text": "systemctl show terrace-backup.service -p Result --value"
    }
  ],
  "excluded": [
    {
      "document": "docs/restore-promotion.md",
      "step": "18",
      "firstLine": "# after PostgreSQL, Keycloak, nginx, the CMS migration and the CMS are up (BOOTSTRAP_APP):",
      "reason": "Documenso, Windmill and Vaultwarden are refused by the production profile; step 18 describes rehearsal behaviour only."
    }
  ]
}
