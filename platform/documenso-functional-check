#!/usr/bin/env bash
set -euo pipefail
[[ $(uname -s) == Linux && $(uname -m) == x86_64 ]] || { echo 'Run the Documenso functional check on the x86_64 Linux builder.' >&2; exit 1; }
: "${BUILD_LOCK:?set the shared build lock path}"
[[ $# == 1 && -d $1 ]] || { echo 'usage: platform/documenso-functional-check TFC_SOURCE'; exit 2; }
tfc_source=$(realpath "$1")
cd "$(dirname "$0")"
exec ./run-check --keep-failed --impure --file documenso-functional-check.nix --argstr tfcSource "$tfc_source"
