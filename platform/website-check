#!/usr/bin/env bash
set -euo pipefail
[[ $(uname -s) == Linux && $(uname -m) == x86_64 ]] || { echo 'Run the website VM on the Linux build host.' >&2; exit 1; }
: "${BUILD_LOCK:?set the shared build lock path}"
[[ $# == 2 && -f $1 && -f $2 ]] || { echo 'usage: platform/website-check WEB_ARCHIVE CMS_ARCHIVE' >&2; exit 2; }
web_archive=$(realpath "$1")
cms_archive=$(realpath "$2")
cd "$(dirname "$0")"
exec flock -w "${BUILD_LOCK_TIMEOUT:-28800}" "$BUILD_LOCK" \
  nix build --impure --file website-check.nix \
    --argstr webArchive "$web_archive" --argstr cmsArchive "$cms_archive" \
    --max-jobs 1 --cores 2 --option builders '' --option post-build-hook '' \
    -L --print-out-paths --no-link
